---
// src/layouts/BaseLayout.astro
// Se importa UNA vez aquí; todas las páginas que usen este layout heredan colores, iconos y el selector de temas.
import "../styles/colores-globales.css";
import "bootstrap-icons/font/bootstrap-icons.css";
import ThemePicker from "../components/ThemePicker.astro";

interface Props { title?: string }
const { title = "Psynex" } = Astro.props;
---
<!doctype html>
<html lang="es" data-theme="beige">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
     <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> 
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Aplica el tema guardado antes de pintar (evita el parpadeo)
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <ThemePicker />
  </body>
</html>

<style is:global>
  /* ---------- Base de todo el sitio ---------- */
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; } /* evita que el texto se agrande solo en iPhone */
  html, body { overflow-x: hidden; width: 100%; max-width: 100%; } /* nada empuja la página hacia los lados en móvil */

  /* Las imágenes nunca se salen de su contenedor, en ninguna pantalla */
  img, svg, video, picture { max-width: 100%; height: auto; display: block; }

  /* Contenedor reutilizable: usa esto en vez de padding fijo en cada sección.
     El padding lateral se reduce solo en pantallas angostas. */
  .contenedor {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(16px, 5vw, 24px);
  }
</style>