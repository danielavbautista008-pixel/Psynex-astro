---
import "./citas.css";
import Menu from "./menuPac.astro";
---

<div class="landing-container">
    <!-- 1. Menú arriba -->
    <Menu />

    <!-- 2. Contenedor principal unificado con el mismo tamaño que Inicio -->
    <main class="Bienvenida-Em">
        
        <!-- SECCIÓN SUPERIOR: Agendar / Próxima Cita -->
        <div class="empty-state-container">
            <div class="empty-card">
                <div class="icon-wrapper">
                    <i class="fa-regular fa-calendar-days"></i>
                </div>
                <h2 class="empty-title">No has agendado tu primera sesión</h2>
                <p class="empty-description">
                    Aún no tienes citas agendadas, pero este puede ser el primer
                    paso para priorizar tu bienestar emocional
                </p>
                <button class="btn-primary" id="btn-solicitar-cita"> Agenda tu primera sesión </button>
            </div>

            <!-- Contenedor dinámico de Próxima Cita -->
            <div id="container-proxima-cita" style="width: 100%;">
                <!-- Se inyecta dinámicamente si hay citas -->
            </div>
        </div>

        <!-- SECCIÓN INFERIOR: Historial de citas -->
        <section class="historial-section">
            <h3>
                <i class="bi bi-clock-history"></i>
                Historial de citas
            </h3>

            <div class="table-responsive">
                <table class="tabla-citas">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Psicólogo(a)</th>
                            <th>Modalidad</th>
                            <th>Estado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-historial">
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">
                                Cargando historial de citas...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Aviso / Banner Inferior -->
            <div class="alerta-citas">
                <div>
                    <i class="bi bi-info-circle"></i>
                    <strong>Importante:</strong>
                    Si no puedes asistir a tu cita, por favor cancélala con anticipación
                    para que otro paciente pueda tomar ese espacio.
                </div>

                <button id="btn-ayuda" class="btn-ayuda">
                    <i class="bi bi-question-circle"></i>
                    ¿Necesitas ayuda?
                </button>
            </div>
        </section>

    </main>
</div>

<script>
  const API_URL = "http://localhost:8000/api";

  interface CitaDto {
    id: string;
    fechaHora: string;
    nombrePsicologo: string;
    especialidadPsicologo: string;
    modalidad: string;
    estado: "Confirmada" | "Pendiente" | "Completada" | "Cancelada";
    linkVideollamada?: string;
  }

  const containerProxima = document.getElementById("container-proxima-cita");
  const tbodyHistorial = document.getElementById("tbody-historial");
  const btnSolicitar = document.getElementById("btn-solicitar-cita");
  const btnAyuda = document.getElementById("btn-ayuda");

  let timerInterval: number | null = null;

  document.addEventListener("DOMContentLoaded", () => {
    cargarCitas();
    timerInterval = window.setInterval(cargarCitas, 30000);

    btnSolicitar?.addEventListener("click", () => {
      window.location.href = "/paciente/solicitar-cita";
    });

    btnAyuda?.addEventListener("click", () => {
      window.location.href = "/paciente/soporte";
    });
  });

  window.addEventListener("beforeunload", () => {
    if (timerInterval) clearInterval(timerInterval);
  });

  async function cargarCitas() {
    const usuarioId = sessionStorage.getItem("usuarioId");

    if (!usuarioId) {
      if (containerProxima) {
        containerProxima.innerHTML = `
          <div class="card-proxima-cita text-center py-4">
            <p class="text-muted">No se detectó una sesión activa de paciente.</p>
          </div>`;
      }
      if (tbodyHistorial) {
        tbodyHistorial.innerHTML = `
          <tr>
            <td colspan="6" class="text-center text-muted py-3">
              Por favor inicia sesión para ver tu historial.
            </td>
          </tr>`;
      }
      return;
    }

    try {
      const res = await fetch(`${API_URL}/citas/paciente/${usuarioId}`);
      if (!res.ok) throw new Error("Error al obtener citas");

      const citas: CitaDto[] = await res.json();

      const proxima = citas
        .filter((c) => c.estado === "Confirmada" || c.estado === "Pendiente")
        .sort((a, b) => {
          if (a.estado === "Confirmada" && b.estado !== "Confirmada") return -1;
          if (a.estado !== "Confirmada" && b.estado === "Confirmada") return 1;
          return new Date(a.fechaHora).getTime() - new Date(b.fechaHora).getTime();
        })[0];

      const historial = citas
        .filter((c) => c.estado === "Cancelada" || c.estado === "Completada")
        .sort((a, b) => new Date(b.fechaHora).getTime() - new Date(a.fechaHora).getTime());

      renderProximaCita(proxima);
      renderHistorial(historial);
    } catch (err) {
      console.error("Error cargando citas:", err);
      if (containerProxima) {
        containerProxima.innerHTML = `
          <div class="card-proxima-cita text-center py-4">
            <p class="text-muted">Ocurrió un error al cargar tus citas.</p>
          </div>`;
      }
    }
  }

  function renderProximaCita(cita?: CitaDto) {
    if (!containerProxima) return;

    if (!cita) {
      containerProxima.innerHTML = "";
      return;
    }

    const fechaObj = new Date(cita.fechaHora);
    const fechaTexto = formatearFechaLarga(fechaObj);
    const diaSemana = formatearDiaSemana(fechaObj);
    const horaTexto = formatearHora(fechaObj);
    const badgeClass = getBadgeClass(cita.estado);

    let botonAccion = "";
    if (cita.linkVideollamada) {
      if (cita.modalidad === "Virtual") {
        botonAccion = `
          <a href="${cita.linkVideollamada}" target="_blank" rel="noopener noreferrer" class="btn-ingresar">
            <i class="bi bi-camera-video-fill"></i>
            Ingresar a la cita
          </a>`;
      } else {
        const queryMaps = encodeURIComponent(cita.linkVideollamada);
        botonAccion = `
          <a href="https://www.google.com/maps/search/?api=1&query=${queryMaps}" target="_blank" rel="noopener noreferrer" class="btn-ingresar">
            <i class="bi bi-geo-alt-fill"></i>
            Ver ubicación
          </a>`;
      }
    } else {
      const isVirtual = cita.modalidad === "Virtual";
      botonAccion = `
        <button class="btn-ingresar" disabled style="opacity:0.5; cursor:not-allowed;">
          <i class="bi ${isVirtual ? "bi-camera-video-fill" : "bi-geo-alt-fill"}"></i>
          ${isVirtual ? "Link pendiente" : "Dirección pendiente"}
        </button>`;
    }

    containerProxima.innerHTML = `
      <div class="card-proxima-cita">
        <div class="proxima-cita-header">
          <div class="calendar-circle">
            <i class="bi bi-calendar2-check"></i>
          </div>
          <div class="proxima-cita-info">
            <h5>Próxima cita</h5>
            <div class="cita-grid">
              <div class="cita-item">
                <i class="bi bi-calendar3"></i>
                <div>
                  <small>Fecha</small>
                  <h6>${fechaTexto}</h6>
                  <span>(${diaSemana})</span>
                </div>
              </div>
              <div class="cita-item">
                <i class="bi bi-clock"></i>
                <div>
                  <small>Hora</small>
                  <h6>${horaTexto}</h6>
                </div>
              </div>
              <div class="cita-item">
                <i class="bi bi-person"></i>
                <div>
                  <small>Psicólogo(a)</small>
                  <h6>${cita.nombrePsicologo}</h6>
                  <span>${cita.especialidadPsicologo}</span>
                </div>
              </div>
              <div class="cita-item">
                <i class="bi bi-camera-video"></i>
                <div>
                  <small>Modalidad</small>
                  <h6>${cita.modalidad}</h6>
                  ${cita.modalidad === "Virtual" ? "<span>(Videollamada)</span>" : ""}
                </div>
              </div>
              <div class="cita-item">
                <div>
                  <small>Estado</small>
                  <span class="${badgeClass}">${cita.estado}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        ${botonAccion}
      </div>`;
  }

  function renderHistorial(citas: CitaDto[]) {
    if (!tbodyHistorial) return;

    if (citas.length === 0) {
      tbodyHistorial.innerHTML = `
        <tr>
          <td colspan="6" class="text-center text-muted py-3">
            No hay citas en tu historial aún.
          </td>
        </tr>`;
      return;
    }

    tbodyHistorial.innerHTML = citas
      .map((cita) => {
        const fechaObj = new Date(cita.fechaHora);
        const fechaTexto = formatearFechaLarga(fechaObj);
        const horaTexto = formatearHora(fechaObj);
        const badgeClass = getBadgeClass(cita.estado);
        const isVirtual = cita.modalidad === "Virtual";

        return `
          <tr>
            <td><i class="bi bi-calendar3"></i> ${fechaTexto}</td>
            <td><i class="bi bi-clock"></i> ${horaTexto}</td>
            <td>
              <div class="doctor-info">
                <img src="/imagenes/avatar.png" alt="${cita.nombrePsicologo}" />
                <div>
                  <strong>${cita.nombrePsicologo}</strong>
                  <small>${cita.especialidadPsicologo}</small>
                </div>
              </div>
            </td>
            <td><i class="bi ${isVirtual ? "bi-camera-video" : "bi-geo-alt"}"></i> ${cita.modalidad}</td>
            <td><span class="${badgeClass}">${cita.estado}</span></td>
            <td><button class="btn-detalles" data-id="${cita.id}">Ver detalles</button></td>
          </tr>`;
      })
      .join("");

    document.querySelectorAll(".btn-detalles").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = (e.currentTarget as HTMLButtonElement).getAttribute("data-id");
        if (id) {
          window.location.href = `/paciente/citas/${id}`;
        }
      });
    });
  }

  function formatearFechaLarga(date: Date): string {
    return date.toLocaleDateString("es-CO", { day: "2-digit", month: "long", year: "numeric" });
  }

  function formatearDiaSemana(date: Date): string {
    return date.toLocaleDateString("es-CO", { weekday: "long" });
  }

  function formatearHora(date: Date): string {
    return date.toLocaleTimeString("es-CO", { hour: "2-digit", minute: "2-digit", hour12: true });
  }

  function getBadgeClass(estado: string): string {
    switch (estado) {
      case "Confirmada":
      case "Completada": return "badge-success";
      case "Pendiente": return "badge-warning";
      case "Cancelada": return "badge-danger";
      default: return "badge-secondary";
    }
  }
</script>