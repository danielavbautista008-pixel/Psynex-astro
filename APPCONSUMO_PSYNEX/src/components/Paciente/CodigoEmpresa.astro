---
// =====================================================================
// Tarjeta "Beneficio de tu empresa": el paciente escribe el código que
// le dio su empresa (por ejemplo ESAS-7K3P) y ve cuántas sesiones le
// quedan cubiertas. Se usa en Paquetes y en Mi perfil.
//
// cambio: ahora es REAL. El código lo genera Psynex cuando el admin aprueba
// el plan de la empresa (GET/POST/DELETE /api/paciente/beneficio).
// Con el beneficio activo, en "Mis citas" se paga la cita con una sesión.
// =====================================================================
---

<section class="pac-card codigo-empresa" id="codigoEmpresa">
  <div class="pac-card-top">
    <div>
      <h2>Beneficio de tu empresa</h2>
      <small>Si tu empresa tiene un plan con Psynex, te dio un código para tus sesiones.</small>
    </div>
    <span class="pac-chip neutro" id="codigoEstado">Sin código</span>
  </div>

  <!-- Sin código: formulario -->
  <form class="codigo-form" id="codigoForm" novalidate>
    <label class="pac-campo">
      Código de la empresa
      <input
        id="codigoInput"
        name="codigo"
        maxlength="9"
        placeholder="Ej: PSYX-KQ3S"
        autocomplete="off"
        spellcheck="false"
      />
    </label>
    <button type="submit" class="pac-btn">Activar</button>
  </form>
  <p class="codigo-error" id="codigoError" role="alert"></p>

  <!-- Con código: resumen -->
  <div class="codigo-activo" id="codigoActivo" hidden>
    <div class="codigo-fila">
      <div>
        <span class="pac-muted">Empresa</span>
        <strong id="codigoEmpresaNombre">—</strong>
      </div>
      <div>
        <span class="pac-muted">Código</span>
        <strong class="codigo-texto" id="codigoTexto">—</strong>
      </div>
      <div>
        <span class="pac-muted">Vence</span>
        <strong id="codigoVence">—</strong>
      </div>
    </div>

    <div class="codigo-barra-info">
      <span><strong id="codigoDisponibles">0</strong> de <span id="codigoTotales">0</span> sesiones disponibles</span>
    </div>
    <div class="codigo-barra"><i id="codigoBarra"></i></div>

    <div class="codigo-acciones">
      <a href="/Paciente/Especialistas" class="pac-btn pequeno">Agendar con mi beneficio</a>
      <a href="/Paciente/Citas" class="pac-btn pequeno borde">Usarlo en mis citas</a>
      <button type="button" class="pac-btn pequeno borde" id="codigoQuitar">Quitar código</button>
    </div>
  </div>
</section>

<style>
  .codigo-form {
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }

  .codigo-form .pac-campo {
    flex: 1;
  }

  .codigo-form input {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: ui-monospace, Menlo, Consolas, monospace;
  }

  .codigo-form .pac-btn {
    height: 38px;
  }

  .codigo-error {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--danger-fg);
  }

  .codigo-error:empty {
    display: none;
  }

  .codigo-fila {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 14px;
  }

  .codigo-fila span {
    display: block;
    font-size: 11px;
  }

  .codigo-fila strong {
    font-size: 13.5px;
    color: var(--text);
  }

  .codigo-texto {
    font-family: ui-monospace, Menlo, Consolas, monospace;
    letter-spacing: 0.06em;
  }

  .codigo-barra-info {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .codigo-barra-info strong {
    color: var(--primary);
  }

  .codigo-barra {
    height: 8px;
    border-radius: 999px;
    background: var(--bg);
    overflow: hidden;
  }

  .codigo-barra i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--primary);
    transition: width 0.4s ease;
  }

  .codigo-acciones {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  @media (max-width: 560px) {
    .codigo-form {
      flex-direction: column;
      align-items: stretch;
    }

    .codigo-fila {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  // cambio: el código se valida y se guarda en el backend
  import { avisar, fechaBonita } from "./utilidades";
  import { API_URL, apiEnviar, textoError } from "../../lib/api";

  interface Beneficio {
    codigo: string;
    empresa: string;
    vence: string;
    sesionesTotales: number;
    sesionesUsadas: number;
    sesionesDisponibles: number;
  }

  const caja = document.getElementById("codigoEmpresa");
  if (caja) {
    const $ = (id: string) => document.getElementById(id);
    const form = $("codigoForm") as HTMLFormElement | null;
    const input = $("codigoInput") as HTMLInputElement | null;
    const error = $("codigoError");
    const activo = $("codigoActivo");
    const estado = $("codigoEstado");
    const quitar = $("codigoQuitar") as HTMLButtonElement | null;

    const texto = (id: string, valor: string) => {
      const el = $(id);
      if (el) el.textContent = valor;
    };

    function pintar(b: Beneficio | null) {
      if (form) form.hidden = Boolean(b);
      if (activo) activo.hidden = !b;
      if (estado) {
        estado.textContent = b ? (b.sesionesDisponibles > 0 ? "Activo" : "Sin sesiones") : "Sin código";
        estado.className = b ? (b.sesionesDisponibles > 0 ? "pac-chip ok" : "pac-chip neutro") : "pac-chip neutro";
      }
      if (!b) return;
      texto("codigoEmpresaNombre", b.empresa);
      texto("codigoTexto", b.codigo);
      texto("codigoVence", b.vence ? fechaBonita(b.vence) : "Sin vencimiento");
      texto("codigoDisponibles", String(b.sesionesDisponibles));
      texto("codigoTotales", String(b.sesionesTotales));
      const barra = $("codigoBarra");
      if (barra) barra.style.width = `${b.sesionesTotales ? (b.sesionesDisponibles / b.sesionesTotales) * 100 : 0}%`;
      // Si ya usó sesiones, el código no se puede quitar
      if (quitar) quitar.hidden = b.sesionesUsadas > 0;
    }

    // Escribe el guion solo: "psyxkq3s" -> "PSYX-KQ3S"
    input?.addEventListener("input", () => {
      const limpio = input.value.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 8);
      input.value = limpio.length > 4 ? `${limpio.slice(0, 4)}-${limpio.slice(4)}` : limpio;
      if (error) error.textContent = "";
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const boton = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (boton) boton.disabled = true;
      const r = await apiEnviar("POST", "/api/paciente/beneficio", { codigo: input?.value || "" });
      if (boton) boton.disabled = false;
      if (!r.ok) {
        if (error) error.textContent = textoError(r.data, "No se pudo activar el código");
        return;
      }
      pintar(r.data.beneficio);
      avisar("¡Listo! Tu beneficio quedó activo.");
      document.dispatchEvent(new CustomEvent("psynex:beneficio", { detail: r.data.beneficio }));
    });

    quitar?.addEventListener("click", async () => {
      quitar.disabled = true;
      const r = await apiEnviar("DELETE", "/api/paciente/beneficio");
      quitar.disabled = false;
      if (!r.ok) return avisar(textoError(r.data, "No se pudo quitar el código"));
      if (input) input.value = "";
      pintar(null);
      avisar("Quitaste el código de tu empresa.");
      document.dispatchEvent(new CustomEvent("psynex:beneficio", { detail: null }));
    });

    // Estado real al cargar
    fetch(`${API_URL}/api/paciente/beneficio`, { credentials: "include" })
      .then((res) => (res.ok ? res.json() : null))
      .then((d) => pintar(d?.beneficio ?? null))
      .catch(() => pintar(null));
  }
</script>
