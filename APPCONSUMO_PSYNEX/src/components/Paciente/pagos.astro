---
// =====================================================================
// Pagos del paciente: resumen e historial con recibo.
// cambio: ahora son los pagos REALES (GET /api/paciente/pagos):
// citas pagadas con Wompi o con paquete, y paquetes comprados.
// =====================================================================
import Menu from "./menuPac.astro";
import { apiGet, pesos } from "../../lib/api";
import "./pagos.css";

interface PagoApi {
  id: string;
  tipo: "cita" | "paquete";
  concepto: string;
  detalle: string;
  metodo: string;
  valor: number;
  estado: "Aprobado" | "Rechazado" | "Por devolver" | "Devuelto"; // cambio: citas canceladas ya pagadas
  fecha: string; // "AAAA-MM-DD HH:MM"
  referencia: string;
}

const datos = await apiGet<{ pagos: PagoApi[] }>(Astro.request.headers.get("cookie"), "/api/paciente/pagos");
const MESES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const textoFecha = (t: string) => (t ? `${+t.slice(8, 10)} ${MESES[+t.slice(5, 7) - 1]} ${t.slice(0, 4)}` : "—");

const pagos = (datos?.pagos ?? []).map((p) => ({
  ...p,
  fecha: textoFecha(p.fecha),
  psicologo: p.detalle,
  // En el recibo se muestra la referencia de Wompi si existe
  ref: p.referencia || p.id.slice(0, 8).toUpperCase(),
  // Las citas pagadas con paquete ya se cobraron al comprar el paquete
  // cambio: tampoco cuentan las que cubrió la empresa
  incluida: p.metodo === "Sesión de mi paquete" || p.metodo === "Beneficio de mi empresa",
  cuenta: p.estado === "Aprobado" && !(p.tipo === "cita" && (p.metodo === "Sesión de mi paquete" || p.metodo === "Beneficio de mi empresa")),
}));

const totalPagado = pagos.filter((p) => p.cuenta).reduce((s, p) => s + p.valor, 0);
const sesionesPagadas = pagos.filter((p) => p.tipo === "cita" && p.estado === "Aprobado").length;
const paquetesComprados = pagos.filter((p) => p.tipo === "paquete" && p.estado === "Aprobado").length;
const cubiertasEmpresa = pagos.filter((p) => p.metodo === "Beneficio de mi empresa" && p.estado === "Aprobado").length;

const clase: Record<string, string> = { Aprobado: "ok", Rechazado: "mal", Pendiente: "espera", "Por devolver": "espera", Devuelto: "neutro" };
---

<Menu />

<main class="pac-page">
  <div class="pac-contenido">

    <header class="pac-header">
      <div>
        <span class="pac-etiqueta">Mi cuenta</span>
        <h1>Pagos</h1>
        <p>Consulta lo que has pagado por tus sesiones y descarga tus recibos.</p>
      </div>
    </header>

    <section class="pag-resumen">
      <article class="pac-card">
        <span class="pac-muted">Total pagado</span>
        <strong>{pesos(totalPagado)}</strong>
      </article>
      <article class="pac-card">
        <span class="pac-muted">Sesiones pagadas</span>
        <strong>{sesionesPagadas}</strong>
      </article>
      <article class="pac-card">
        <span class="pac-muted">{cubiertasEmpresa ? "Cubiertas por tu empresa" : "Paquetes comprados"}</span>
        <strong>{cubiertasEmpresa || paquetesComprados}</strong>
      </article>
    </section>

    <section class="pac-card">
      <div class="pac-card-top">
        <h2>Historial de pagos</h2>
        <small>{pagos.length} movimientos</small>
      </div>

      <div class="pag-tabla-wrap">
        <table class="pag-tabla">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Concepto</th>
              <th>Método</th>
              <th>Estado</th>
              <th class="der">Valor</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {pagos.length === 0 && (
              <tr><td colspan="6" class="pac-muted">Todavía no tienes pagos. Cuando pagues una cita o un paquete, aparecerá aquí.</td></tr>
            )}
            {pagos.map((p) => (
              <tr>
                <td>{p.fecha}</td>
                <td>
                  <strong>{p.concepto}</strong>
                  <small>{p.psicologo}</small>
                </td>
                <td>{p.metodo}</td>
                <td><span class={`pac-chip ${clase[p.estado] ?? ""}`}>{p.estado}</span></td>
                <td class="der">{p.metodo === "Beneficio de mi empresa" ? "Cubierta" : p.metodo === "Sesión de mi paquete" ? "Incluida" : pesos(p.valor)}</td>
                <td class="der">
                  {p.estado !== "Rechazado" && (
                    <button
                      type="button"
                      class="pac-btn pequeno borde"
                      data-recibo={p.ref}
                      data-fecha={p.fecha}
                      data-concepto={p.concepto}
                      data-psicologo={p.psicologo}
                      data-metodo={p.metodo}
                      data-valor={p.metodo === "Beneficio de mi empresa" ? "Cubierta por tu empresa" : p.metodo === "Sesión de mi paquete" ? "Incluida en tu paquete" : pesos(p.valor)}
                    >
                      Recibo
                    </button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {datos === null && (
      <span class="pac-prueba"><i class="bi bi-wifi-off"></i> No pudimos cargar tus pagos. Revisa que el servidor esté encendido.</span>
    )}
  </div>
</main>

<div class="pac-modal" id="modalRecibo" hidden>
  <button type="button" class="pac-modal-fondo" data-cerrar-modal aria-label="Cerrar"></button>
  <div class="pac-modal-caja" role="dialog" aria-modal="true" aria-labelledby="reciboTitulo">
    <h3 id="reciboTitulo">Recibo</h3>
    <dl class="pag-recibo">
      <div><dt>Referencia</dt><dd id="rId">—</dd></div>
      <div><dt>Fecha</dt><dd id="rFecha">—</dd></div>
      <div><dt>Concepto</dt><dd id="rConcepto">—</dd></div>
      <div><dt>Detalle</dt><dd id="rPsicologo">—</dd></div>
      <div><dt>Método</dt><dd id="rMetodo">—</dd></div>
      <div class="total"><dt>Total</dt><dd id="rValor">—</dd></div>
    </dl>
    <div class="pac-modal-acciones">
      <button type="button" class="pac-btn borde pequeno" id="imprimirRecibo">Imprimir</button>
      <button type="button" class="pac-btn pequeno" data-cerrar-modal>Cerrar</button>
    </div>
  </div>
</div>

<script>
  import { abrirModal, prepararModales } from "./utilidades";

  prepararModales();

  document.querySelectorAll<HTMLButtonElement>("[data-recibo]").forEach((b) =>
    b.addEventListener("click", () => {
      const d = b.dataset;
      const poner = (id: string, v?: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = v || "—";
      };
      poner("rId", d.recibo);
      poner("rFecha", d.fecha);
      poner("rConcepto", d.concepto);
      poner("rPsicologo", d.psicologo);
      poner("rMetodo", d.metodo);
      poner("rValor", d.valor);
      abrirModal("modalRecibo");
    })
  );

  document.getElementById("imprimirRecibo")?.addEventListener("click", () => window.print());
</script>
