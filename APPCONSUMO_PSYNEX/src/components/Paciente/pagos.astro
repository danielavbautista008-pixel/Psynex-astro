---
// =====================================================================
// Pagos del paciente: resumen e historial con recibo.
// DATOS DE PRUEBA: los pagos son de ejemplo (todavía sin backend).
// =====================================================================
import Menu from "./menuPac.astro";
import { pesos } from "../../lib/api";
import "./pagos.css";

const pagos = [
  { id: "PG-1042", fecha: "21 oct 2026", concepto: "Sesión individual", psicologo: "Andrea Gómez Ruiz", metodo: "Tarjeta •••• 4242", valor: 150000, estado: "Aprobado" },
  { id: "PG-1031", fecha: "12 oct 2026", concepto: "Sesión individual", psicologo: "Camila Barrera", metodo: "Nequi", valor: 150000, estado: "Aprobado" },
  { id: "PG-1027", fecha: "3 oct 2026", concepto: "Terapia de pareja", psicologo: "Víctor Santiago", metodo: "Beneficio empresa", valor: 0, estado: "Cubierto" },
  { id: "PG-1012", fecha: "25 sep 2026", concepto: "Sesión individual", psicologo: "Andrea Gómez Ruiz", metodo: "PSE", valor: 150000, estado: "Aprobado" },
  { id: "PG-1009", fecha: "10 sep 2026", concepto: "Sesión individual", psicologo: "Víctor Santiago", metodo: "Tarjeta •••• 1111", valor: 150000, estado: "Rechazado" },
];

const totalPagado = pagos.filter((p) => p.estado === "Aprobado").reduce((s, p) => s + p.valor, 0);
const sesionesPagadas = pagos.filter((p) => p.estado === "Aprobado").length;
const cubiertas = pagos.filter((p) => p.estado === "Cubierto").length;

const clase: Record<string, string> = { Aprobado: "ok", Cubierto: "", Rechazado: "mal", Pendiente: "espera" };
---

<Menu />

<main class="pac-page">
  <div class="pac-contenido">

    <header class="pac-header">
      <div>
        <span class="pac-etiqueta">Mi cuenta</span>
        <h1>Pagos</h1>
        <p>Consulta lo que has pagado por tus sesiones y descarga tus recibos.</p>
      </div>
    </header>

    <section class="pag-resumen">
      <article class="pac-card">
        <span class="pac-muted">Total pagado</span>
        <strong>{pesos(totalPagado)}</strong>
      </article>
      <article class="pac-card">
        <span class="pac-muted">Sesiones pagadas</span>
        <strong>{sesionesPagadas}</strong>
      </article>
      <article class="pac-card">
        <span class="pac-muted">Cubiertas por tu empresa</span>
        <strong>{cubiertas}</strong>
      </article>
    </section>

    <section class="pac-card">
      <div class="pac-card-top">
        <h2>Historial de pagos</h2>
        <small>{pagos.length} movimientos</small>
      </div>

      <div class="pag-tabla-wrap">
        <table class="pag-tabla">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Concepto</th>
              <th>Método</th>
              <th>Estado</th>
              <th class="der">Valor</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {pagos.map((p) => (
              <tr>
                <td>{p.fecha}</td>
                <td>
                  <strong>{p.concepto}</strong>
                  <small>{p.psicologo}</small>
                </td>
                <td>{p.metodo}</td>
                <td><span class={`pac-chip ${clase[p.estado] ?? ""}`}>{p.estado}</span></td>
                <td class="der">{p.valor ? pesos(p.valor) : "—"}</td>
                <td class="der">
                  {p.estado !== "Rechazado" && (
                    <button
                      type="button"
                      class="pac-btn pequeno borde"
                      data-recibo={p.id}
                      data-fecha={p.fecha}
                      data-concepto={p.concepto}
                      data-psicologo={p.psicologo}
                      data-metodo={p.metodo}
                      data-valor={p.valor ? pesos(p.valor) : "Cubierto por tu empresa"}
                    >
                      Recibo
                    </button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <span class="pac-prueba"><i class="bi bi-info-circle"></i> Pagos de prueba · los reales llegarán con la pasarela de pago</span>
  </div>
</main>

<div class="pac-modal" id="modalRecibo" hidden>
  <button type="button" class="pac-modal-fondo" data-cerrar-modal aria-label="Cerrar"></button>
  <div class="pac-modal-caja" role="dialog" aria-modal="true" aria-labelledby="reciboTitulo">
    <h3 id="reciboTitulo">Recibo</h3>
    <dl class="pag-recibo">
      <div><dt>Referencia</dt><dd id="rId">—</dd></div>
      <div><dt>Fecha</dt><dd id="rFecha">—</dd></div>
      <div><dt>Concepto</dt><dd id="rConcepto">—</dd></div>
      <div><dt>Psicólogo</dt><dd id="rPsicologo">—</dd></div>
      <div><dt>Método</dt><dd id="rMetodo">—</dd></div>
      <div class="total"><dt>Total</dt><dd id="rValor">—</dd></div>
    </dl>
    <div class="pac-modal-acciones">
      <button type="button" class="pac-btn borde pequeno" id="imprimirRecibo">Imprimir</button>
      <button type="button" class="pac-btn pequeno" data-cerrar-modal>Cerrar</button>
    </div>
  </div>
</div>

<script>
  import { abrirModal, prepararModales } from "./utilidades";

  prepararModales();

  document.querySelectorAll<HTMLButtonElement>("[data-recibo]").forEach((b) =>
    b.addEventListener("click", () => {
      const d = b.dataset;
      const poner = (id: string, v?: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = v || "—";
      };
      poner("rId", d.recibo);
      poner("rFecha", d.fecha);
      poner("rConcepto", d.concepto);
      poner("rPsicologo", d.psicologo);
      poner("rMetodo", d.metodo);
      poner("rValor", d.valor);
      abrirModal("modalRecibo");
    })
  );

  document.getElementById("imprimirRecibo")?.addEventListener("click", () => window.print());
</script>
