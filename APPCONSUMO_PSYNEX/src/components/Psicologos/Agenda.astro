---
import "./Agenda.css";
import BotonChat from "../Menu/BotonChat.astro";
import { API_URL, apiGet, fotoIniciales } from "../../lib/api";

// Datos reales:
//  - GET /api/psicologo/agenda/configuracion -> días, horario, duración, modalidades, reglas
//  - GET /api/psicologo/agenda?mes=AAAA-MM   -> citas del mes para el calendario
const cookie = Astro.request.headers.get("cookie");
const nombre = Astro.locals.usuario?.NombreCompleto ?? "Psicólogo";

// Mes y día de hoy en Colombia
const hoy = new Date().toLocaleDateString("en-CA", { timeZone: "America/Bogota" }); // AAAA-MM-DD
const mesActual = hoy.slice(0, 7);

const [datosConfig, datosCitas] = await Promise.all([
  apiGet(cookie, "/api/psicologo/agenda/configuracion"),
  apiGet(cookie, `/api/psicologo/agenda?mes=${mesActual}`),
]);

const config = datosConfig?.configuracion ?? {};

const tiposConsulta = [
  "Terapia individual",
  "Terapia de pareja",
  "Terapia familiar",
  "Orientación psicológica",
  "Seguimiento psicológico",
];

// Si nunca ha guardado, se dejan marcados los mismos que traía el diseño
const tiposMarcados: string[] = config.configurada
  ? (config.tiposConsulta ?? [])
  : ["Terapia individual", "Terapia de pareja", "Seguimiento psicológico"];

const diasSemana = [
  { letra: "L", dia: "Lunes" },
  { letra: "M", dia: "Martes" },
  { letra: "X", dia: "Miercoles" },
  { letra: "J", dia: "Jueves" },
  { letra: "V", dia: "Viernes" },
  { letra: "S", dia: "Sabado" },
  { letra: "D", dia: "Domingo" },
];
const diasMarcados: string[] = config.configurada || (config.dias ?? []).length
  ? (config.dias ?? [])
  : ["Lunes", "Martes", "Miercoles", "Jueves", "Viernes"];

const modalidades: string[] = config.modalidades ?? ["Virtual", "Presencial"];
const duracion = Number(config.duracionMinutos ?? 45);
const anticipacion = Number(config.anticipacionHoras ?? 12);
const cancelacion = Number(config.cancelacionHoras ?? 12);

// Citas -> misma forma que usaba el calendario
const aCita = (c: any) => {
  const d = new Date(c.FechaHora);
  return {
    fecha: d.toLocaleDateString("en-CA", { timeZone: "America/Bogota" }),
    hora: d.toLocaleTimeString("es-CO", { hour: "numeric", minute: "2-digit", timeZone: "America/Bogota" }),
    paciente: String(c.PacienteNombre ?? "Paciente"),
    tipo: c.TipoCita ? `Cita ${String(c.TipoCita).toLowerCase()}` : "Cita",
    modalidad: String(c.Modalidad ?? "Virtual"),
    estado: String(c.Estado ?? ""),
    foto: fotoIniciales(String(c.PacienteNombre ?? "Paciente")),
  };
};

const citasJSON = JSON.stringify(((datosCitas?.citas ?? []) as any[]).map(aCita));
---

<BotonChat />

<main class="agenda-page">

  <div class="agenda-header">

    <div class="header-copy">
      <span class="page-kicker">
        ORGANIZACIÓN PROFESIONAL
      </span>

      <h1>
        Tu agenda, tu espacio
      </h1>

      <p>
        Organiza tus horarios y define cómo quieres atender a tus pacientes.
      </p>
    </div>

    <a
      href="/Psicologos/Citas"
      class="back-button"
    >
      <span>←</span>
      Volver a citas
    </a>

  </div>


  <div class="agenda-layout">

    <!-- =========================================
         COLUMNA IZQUIERDA
    ========================================== -->

    <div class="agenda-left">

      <section class="agenda-card calendar-card">

        <div class="card-top">

          <div>
            <span class="section-kicker">
              TU DISPONIBILIDAD
            </span>

            <h2 id="calendarTitle">
              Octubre 2026
            </h2>
          </div>

          <div class="calendar-buttons">

            <button
              type="button"
              id="previousMonth"
              aria-label="Mes anterior"
            >
              ‹
            </button>

            <button
              type="button"
              id="nextMonth"
              aria-label="Mes siguiente"
            >
              ›
            </button>

          </div>

        </div>


        <div class="calendar-weekdays">

          <span>Lun</span>
          <span>Mar</span>
          <span>Mié</span>
          <span>Jue</span>
          <span>Vie</span>
          <span>Sáb</span>
          <span>Dom</span>

        </div>


        <div
          class="calendar-grid"
          id="calendarGrid"
        ></div>


        <div class="calendar-legend">

          <span class="legend-leaf">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M20.5 3.5C13.2 3.8 7.4 6.1 5 10.2c-1.8 3.1-.5 6.4 2.2 7.6 2.8 1.3 6.1-.1 7.9-2.8 2.1-3.1 2.6-7.1 5.4-11.5Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <path
                d="M4 20c2.8-4.4 6.2-7.1 11.5-9.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>

          </span>

          <span>
            Este símbolo indica días con citas programadas.
          </span>

        </div>

      </section>


      <!-- CITAS DEL DÍA -->

      <section class="agenda-card appointments-card">

        <div class="appointments-heading">

          <div>
            <span class="section-kicker">
              CITAS
            </span>

            <h2 id="selectedDayTitle">
              Jueves 8 de octubre
            </h2>
          </div>

          <span
            class="appointment-count"
            id="appointmentCount"
          >
            2 citas
          </span>

        </div>


        <div
          class="appointments-list"
          id="appointmentsList"
        ></div>

      </section>

    </div>


    <!-- =========================================
         COLUMNA DERECHA
    ========================================== -->

    <div class="agenda-right">


      <!-- HORARIO -->

      <section class="agenda-card">

        <div class="card-heading">

          <span class="section-kicker">
            HORARIO
          </span>

          <h2>
            Disponibilidad
          </h2>

        </div>


        <div class="week-selector">

          {diasSemana.map((d) => (
            <label class="day-option" title={d.dia}>
              <input
                type="checkbox"
                data-dia={d.dia}
                checked={diasMarcados.includes(d.dia)}
              />
              <span>{d.letra}</span>
            </label>
          ))}

        </div>


        <div class="time-grid">

          <div class="field">

            <label for="horaInicio">
              Desde
            </label>

            <div class="input-wrap">

              <input
                id="horaInicio"
                type="time"
                value={config.horaInicio ?? "08:00"}
              />

            </div>

          </div>


          <div class="field">

            <label for="horaFin">
              Hasta
            </label>

            <div class="input-wrap">

              <input
                id="horaFin"
                type="time"
                value={config.horaFin ?? "17:00"}
              />

            </div>

          </div>

        </div>


        <div class="field session-duration">

          <label for="duracion">
            Duración de cada sesión
          </label>

          <div class="select-wrap">

            <select id="duracion">
              {[30, 45, 60, 90].map((m) => (
                <option value={m} selected={m === duracion}>
                  {m} minutos
                </option>
              ))}
            </select>

          </div>

        </div>

      </section>


      <!-- MODALIDAD -->

      <section class="agenda-card">

        <div class="card-heading">

          <span class="section-kicker">
            ATENCIÓN
          </span>

          <h2>
            Modalidad
          </h2>

        </div>


        <div class="modality-grid">

          <label class="modality-option">

            <input
              type="checkbox"
              data-modalidad="Virtual"
              checked={modalidades.includes("Virtual")}
            />

            <span class="custom-check"></span>

            <span class="modality-text">

              <strong>
                Virtual
              </strong>

              <small>
                Sesiones en línea
              </small>

            </span>

          </label>


          <label class="modality-option">

            <input
              type="checkbox"
              data-modalidad="Presencial"
              checked={modalidades.includes("Presencial")}
            />

            <span class="custom-check"></span>

            <span class="modality-text">

              <strong>
                Presencial
              </strong>

              <small>
                En tu consultorio
              </small>

            </span>

          </label>

        </div>

      </section>


      <!-- TIPOS DE CONSULTA -->

      <section class="agenda-card">

        <div class="card-heading">

          <span class="section-kicker">
            CONSULTA
          </span>

          <h2>
            Tipos de consulta
          </h2>

          <p>
            Selecciona los tipos de consulta que prestas.
          </p>

        </div>


        <div class="consultation-grid">

          {
            tiposConsulta.map((tipo) => (
              <label class="consultation-option">

                <input
                  type="checkbox"
                  data-tipo={tipo}
                  checked={tiposMarcados.includes(tipo)}
                />

                <span class="custom-check"></span>

                <span class="consultation-text">
                  {tipo}
                </span>

              </label>
            ))
          }

        </div>

      </section>


      <!-- REGLAS -->

      <section class="agenda-card">

        <div class="card-heading">

          <span class="section-kicker">
            RESERVAS
          </span>

          <h2>
            Reglas de agenda
          </h2>

        </div>


        <div class="rules-grid">

          <div class="field">

            <label for="anticipacion">
              Anticipación mínima
            </label>

            <div class="select-wrap">

              <select id="anticipacion">
                {[6, 12, 24, 48].map((h) => (
                  <option value={h} selected={h === anticipacion}>
                    {h} horas
                  </option>
                ))}
              </select>

            </div>

          </div>


          <div class="field">

            <label for="cancelacion">
              Cancelación
            </label>

            <div class="select-wrap">

              <select id="cancelacion">
                {[6, 12, 24, 48].map((h) => (
                  <option value={h} selected={h === cancelacion}>
                    {h} horas antes
                  </option>
                ))}
              </select>

            </div>

          </div>

        </div>

      </section>

    </div>

  </div>


  <!-- =========================================
       GUARDAR
  ========================================== -->

  <section class="save-bar">

    <div>

      <strong>
        {nombre}
      </strong>

      <p id="saveMessage">
        Tu configuración se aplicará a las nuevas reservas.
      </p>

    </div>

    <button
      type="button"
      class="save-button"
      id="saveAgenda"
    >
      Guardar cambios
    </button>

  </section>

</main>


<script define:vars={{ citasJSON, API_URL, hoy, mesActual }}>

  // Citas por mes: el mes actual llega del servidor, los demás se piden
  // al cambiar de mes (GET /api/psicologo/agenda?mes=AAAA-MM).
  let citas = JSON.parse(citasJSON);
  const citasPorMes = { [mesActual]: citas };

  function inicialesFoto(nombre) {
    const ini = nombre.split(" ").filter(Boolean).slice(0, 2).map(function(p) { return p[0].toUpperCase(); }).join("");
    const svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80'><rect width='80' height='80' rx='40' fill='#e6ece8'/><text x='50%' y='54%' dominant-baseline='middle' text-anchor='middle' font-family='sans-serif' font-size='30' fill='#4a5d52'>" + ini + "</text></svg>";
    return "data:image/svg+xml;utf8," + encodeURIComponent(svg);
  }

  function aCita(c) {
    const d = new Date(c.FechaHora);
    return {
      fecha: d.toLocaleDateString("en-CA", { timeZone: "America/Bogota" }),
      hora: d.toLocaleTimeString("es-CO", { hour: "numeric", minute: "2-digit", timeZone: "America/Bogota" }),
      paciente: String(c.PacienteNombre || "Paciente"),
      tipo: c.TipoCita ? "Cita " + String(c.TipoCita).toLowerCase() : "Cita",
      modalidad: String(c.Modalidad || "Virtual"),
      estado: String(c.Estado || ""),
      foto: inicialesFoto(String(c.PacienteNombre || "Paciente")),
    };
  }

  async function cargarMes(mes) {
    if (!citasPorMes[mes]) {
      try {
        const res = await fetch(API_URL + "/api/psicologo/agenda?mes=" + mes, { credentials: "include" });
        const data = res.ok ? await res.json() : null;
        citasPorMes[mes] = ((data && data.citas) || []).map(aCita);
      } catch (e) {
        citasPorMes[mes] = [];
      }
    }
    citas = citasPorMes[mes];
  }

  // El texto de las citas viene de la base: se escapa antes de ponerlo en HTML
  function escapar(texto) {
    return String(texto).replace(/[&<>"']/g, function(c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  const calendarGrid =
    document.querySelector("#calendarGrid");

  const calendarTitle =
    document.querySelector("#calendarTitle");

  const previousMonth =
    document.querySelector("#previousMonth");

  const nextMonth =
    document.querySelector("#nextMonth");

  const selectedDayTitle =
    document.querySelector("#selectedDayTitle");

  const appointmentCount =
    document.querySelector("#appointmentCount");

  const appointmentsList =
    document.querySelector("#appointmentsList");


  let currentDate =
    new Date(Number(hoy.slice(0, 4)), Number(hoy.slice(5, 7)) - 1, 1);

  let selectedDate =
    hoy;


  const meses = [
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre"
  ];


  function obtenerFechaISO(
    year,
    month,
    day
  ) {

    const mes =
      String(month + 1).padStart(2, "0");

    const dia =
      String(day).padStart(2, "0");

    return `${year}-${mes}-${dia}`;
  }


  function tieneCitas(fecha) {

    return citas.some(
      function(cita) {
        return cita.fecha === fecha;
      }
    );
  }


  function obtenerCitas(fecha) {

    return citas.filter(
      function(cita) {
        return cita.fecha === fecha;
      }
    );
  }


  function crearHojita() {

    return `
      <span class="day-leaf">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M20.5 3.5C13.2 3.8 7.4 6.1 5 10.2c-1.8 3.1-.5 6.4 2.2 7.6 2.8 1.3 6.1-.1 7.9-2.8 2.1-3.1 2.6-7.1 5.4-11.5Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <path
            d="M4 20c2.8-4.4 6.2-7.1 11.5-9.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>

      </span>
    `;
  }


  function renderCalendar() {

    if (!calendarGrid || !calendarTitle) {
      return;
    }


    const year =
      currentDate.getFullYear();

    const month =
      currentDate.getMonth();


    calendarTitle.textContent =
      `${meses[month]} ${year}`;


    calendarGrid.innerHTML = "";


    const firstDay =
      new Date(year, month, 1);


    const daysInMonth =
      new Date(
        year,
        month + 1,
        0
      ).getDate();


    let startDay =
      firstDay.getDay();


    if (startDay === 0) {
      startDay = 6;
    } else {
      startDay -= 1;
    }


    /*
     * Días del mes anterior
     */

    for (
      let i = startDay - 1;
      i >= 0;
      i--
    ) {

      const day =
        new Date(
          year,
          month,
          -i
        ).getDate();


      const button =
        document.createElement("button");


      button.type = "button";

      button.className =
        "calendar-day outside-month";

      button.disabled = true;


      button.innerHTML = `
        <span class="day-number">
          ${day}
        </span>
      `;


      calendarGrid.appendChild(button);
    }


    /*
     * Días del mes actual
     */

    for (
      let day = 1;
      day <= daysInMonth;
      day++
    ) {

      const fecha =
        obtenerFechaISO(
          year,
          month,
          day
        );


      const button =
        document.createElement("button");


      button.type = "button";

      button.className =
        "calendar-day";


      if (fecha === selectedDate) {

        button.classList.add(
          "is-selected"
        );

      }


      button.innerHTML = `
        <span class="day-number">
          ${day}
        </span>

        ${
          tieneCitas(fecha)
            ? crearHojita()
            : ""
        }
      `;


      button.addEventListener(
        "click",
        function() {

          selectedDate = fecha;

          renderCalendar();

          renderAppointments(
            selectedDate
          );

        }
      );


      calendarGrid.appendChild(button);
    }


    /*
     * Días del siguiente mes
     */

    const totalDays =
      calendarGrid.children.length;


    const totalCells =
      totalDays <= 35
        ? 35
        : 42;


    const remaining =
      totalCells - totalDays;


    for (
      let day = 1;
      day <= remaining;
      day++
    ) {

      const button =
        document.createElement("button");


      button.type = "button";

      button.className =
        "calendar-day outside-month";

      button.disabled = true;


      button.innerHTML = `
        <span class="day-number">
          ${day}
        </span>
      `;


      calendarGrid.appendChild(button);
    }

  }


  function formatearFecha(fecha) {

    const date =
      new Date(`${fecha}T12:00:00`);


    return date.toLocaleDateString(
      "es-CO",
      {
        weekday: "long",
        day: "numeric",
        month: "long"
      }
    );

  }


  function renderAppointments(fecha) {

    if (
      !appointmentsList ||
      !selectedDayTitle ||
      !appointmentCount
    ) {
      return;
    }


    const citasDelDia =
      obtenerCitas(fecha);


    selectedDayTitle.textContent =
      formatearFecha(fecha);


    appointmentCount.textContent =
      `${citasDelDia.length} ${
        citasDelDia.length === 1
          ? "cita"
          : "citas"
      }`;


    appointmentsList.innerHTML = "";


    if (citasDelDia.length === 0) {

      appointmentsList.innerHTML = `

        <div class="empty-appointments">

          <span class="empty-leaf">

            <svg
              viewBox="0 0 24 24"
              fill="none"
            >
              <path
                d="M20.5 3.5C13.2 3.8 7.4 6.1 5 10.2c-1.8 3.1-.5 6.4 2.2 7.6 2.8 1.3 6.1-.1 7.9-2.8 2.1-3.1 2.6-7.1 5.4-11.5Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <path
                d="M4 20c2.8-4.4 6.2-7.1 11.5-9.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>

          </span>

          <div>
            <strong>
              No tienes citas programadas
            </strong>

            <p>
              Este día está disponible para nuevas consultas.
            </p>
          </div>

        </div>

      `;

      return;
    }


    citasDelDia.forEach(
      function(cita) {

        const article =
          document.createElement("article");


        article.className =
          "appointment-row";


        const modalidadClase =
          cita.modalidad
            .toLowerCase()
            .includes("presencial")
            ? "presencial"
            : "virtual";


        article.innerHTML = `

          <div class="appointment-hour">
            ${escapar(cita.hora)}
          </div>


          <div class="appointment-person">

            <img
              src="${escapar(cita.foto)}"
              alt=""
            />

            <div>

              <strong>
                ${escapar(cita.paciente)}
              </strong>

              <span>
                ${escapar(cita.tipo)}
              </span>

            </div>

          </div>


          <div class="appointment-mode">

            <span
              class="mode-dot ${modalidadClase}"
            ></span>

            <div>

              <strong>
                ${escapar(cita.modalidad)}
              </strong>

              <span>
                ${escapar(cita.estado)}
              </span>

            </div>

          </div>

        `;


        appointmentsList.appendChild(
          article
        );

      }
    );

  }


  if (previousMonth) {

    previousMonth.addEventListener(
      "click",
      async function() {

        currentDate.setMonth(
          currentDate.getMonth() - 1
        );

        await cargarMes(obtenerFechaISO(currentDate.getFullYear(), currentDate.getMonth(), 1).slice(0, 7));

        renderCalendar();

      }
    );

  }


  if (nextMonth) {

    nextMonth.addEventListener(
      "click",
      async function() {

        currentDate.setMonth(
          currentDate.getMonth() + 1
        );

        await cargarMes(obtenerFechaISO(currentDate.getFullYear(), currentDate.getMonth(), 1).slice(0, 7));

        renderCalendar();

      }
    );

  }


  renderCalendar();

  renderAppointments(
    selectedDate
  );



  /*
   * GUARDAR: PUT /api/psicologo/agenda/configuracion
   */

  const saveButton = document.querySelector("#saveAgenda");
  const saveMessage = document.querySelector("#saveMessage");

  function mensaje(texto, error) {
    if (!saveMessage) return;
    saveMessage.textContent = texto;
    saveMessage.style.color = error ? "#c0392b" : "";
  }

  if (saveButton) {
    saveButton.addEventListener("click", async function() {
      const marcados = function(selector, atributo) {
        return Array.from(document.querySelectorAll(selector))
          .filter(function(input) { return input.checked; })
          .map(function(input) { return input.dataset[atributo]; });
      };

      const datos = {
        dias: marcados("input[data-dia]", "dia"),
        horaInicio: document.querySelector("#horaInicio").value,
        horaFin: document.querySelector("#horaFin").value,
        duracionMinutos: Number(document.querySelector("#duracion").value),
        modalidades: marcados("input[data-modalidad]", "modalidad"),
        tiposConsulta: marcados("input[data-tipo]", "tipo"),
        anticipacionHoras: Number(document.querySelector("#anticipacion").value),
        cancelacionHoras: Number(document.querySelector("#cancelacion").value),
      };

      saveButton.disabled = true;
      mensaje("Guardando...");

      try {
        const res = await fetch(API_URL + "/api/psicologo/agenda/configuracion", {
          method: "PUT",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(datos),
        });
        if (res.status === 401) {
          window.location.href = "/Inicio/login";
          return;
        }
        const data = await res.json().catch(function() { return {}; });
        if (!res.ok) {
          mensaje(Array.isArray(data.error) ? data.error.join(". ") : (data.error || "No se pudo guardar."), true);
        } else {
          mensaje("Cambios guardados. Se aplican a las nuevas reservas.");
        }
      } catch (e) {
        mensaje("No se pudo conectar con el servidor.", true);
      } finally {
        saveButton.disabled = false;
      }
    });
  }
</script>
