
---
import NavbarPsicologo from "../Menu/NavbarPsicologo.astro";
import { apiGet, pesos, hora } from "../../lib/api";
import "./Finanzas.css";

// ---------------------------------------------------------------
// Datos reales desde el backend (Deno): /api/psicologo/finanzas/*
// Cada pago completado de una cita del psicólogo es un movimiento.
// MontoNeto = lo que recibe el psicólogo (pago - comisión de Psynex).
// ---------------------------------------------------------------
const cookie = Astro.request.headers.get("cookie");
const [rResumen, rMovs, rCuentas, rReclamos, rCitas] = await Promise.all([
  apiGet(cookie, "/api/psicologo/finanzas/resumen"),
  apiGet(cookie, "/api/psicologo/finanzas/movimientos?porPagina=100"),
  apiGet(cookie, "/api/psicologo/finanzas/cuentas"),
  apiGet(cookie, "/api/psicologo/finanzas/reclamos"),
  apiGet(cookie, "/api/psicologo/citas?estado=Pendiente&porPagina=50"),
]);

const resumen = rResumen?.resumen ?? {
  netoMes: 0, comisionMes: 0, citasPagadasMes: 0, porTransferir: 0,
  transferido: 0, citasGratuitas: 0, comisionPorcentaje: 20,
};
const movimientos: any[] = rMovs?.movimientos ?? [];
const cuentas: any[] = rCuentas?.cuentas ?? [];
const reclamos: any[] = rReclamos?.reclamos ?? [];
const sinConexion = !rResumen;

const principal = cuentas.find((c) => Number(c.EsPrincipal) === 1) ?? cuentas[0] ?? null;

// Citas que esperan respuesta (las próximas primero)
const ahora = Date.now();
const pendientes = (rCitas?.citas ?? [])
  .filter((c: any) => new Date(c.FechaHora).getTime() > ahora)
  .sort((a: any, b: any) => new Date(a.FechaHora).getTime() - new Date(b.FechaHora).getTime());
const proximaCita = pendientes[0] ?? null;

// ---------------------------- Formatos ----------------------------
const ZONA = "America/Bogota";
const fechaNum = (f: string) =>
  new Date(f).toLocaleDateString("es-CO", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: ZONA });
const fechaTexto = (f: string) =>
  new Date(f).toLocaleDateString("es-CO", { day: "numeric", month: "short", year: "numeric", timeZone: ZONA }).replace(".", "");
// "2026-10" para filtrar por mes (en hora de Colombia)
const mesDe = (f: string) => {
  const d = new Date(f).toLocaleDateString("en-CA", { year: "numeric", month: "2-digit", timeZone: ZONA });
  return d.slice(0, 7);
};
const mesActual = mesDe(new Date().toISOString());

const ORIGEN: Record<string, string> = {
  Recompensa: "Gratuita",
  Empresarial: "Empresa",
};
const tipoDe = (m: any) => ORIGEN[m.Origen] ?? "Paciente";
const modalidad = (m: string | null) => (m ? m.toLowerCase() : "virtual");

// Última transferencia hecha por Psynex
const ultimaTransferencia = movimientos
  .map((m) => m.FechaTransferencia)
  .filter(Boolean)
  .sort()
  .at(-1);

// Meses con movimientos (para el selector del resumen)
const NOMBRE_MES = new Intl.DateTimeFormat("es-CO", { month: "long", year: "numeric", timeZone: "UTC" });
const meses = [...new Set([mesActual, ...movimientos.filter((m) => m.FechaPago).map((m) => mesDe(m.FechaPago))])]
  .sort()
  .reverse()
  .map((clave) => {
    const t = NOMBRE_MES.format(new Date(`${clave}-15T12:00:00Z`)).replace(" de ", " ");
    return { clave, texto: t.charAt(0).toUpperCase() + t.slice(1) };
  });

// Lo que necesita el script del navegador (sin datos bancarios completos)
const datos = {
  mesActual,
  comision: resumen.comisionPorcentaje,
  movimientos: movimientos.map((m) => ({
    id: m.PagoId,
    mes: m.FechaPago ? mesDe(m.FechaPago) : "",
    origen: m.Origen,
    total: Number(m.MontoTotal),
    comision: Number(m.ComisionPsynex),
    neto: Number(m.MontoNeto),
  })),
};
---

<div class="finanzas-shell">
  <NavbarPsicologo />

  <main class="finanzas" id="finanzas">
    <header class="fin-header">
      <div>
        <span class="fin-kicker">Mi cuenta</span>
        <h1>Finanzas</h1>
        <p>Consulta tus ingresos, movimientos y próximos pagos.</p>
      </div>
      <button class="fin-btn fin-btn-primary" data-open="modal-cuentas">
        <span>＋</span> Gestionar cuenta
      </button>
    </header>

    {sinConexion && (
      <p class="fin-aviso">No pudimos cargar tus finanzas. Revisa que el servidor esté encendido y vuelve a intentar.</p>
    )}

    <section class="fin-stats">
      <article class="fin-card fin-stat">
        <span>Por transferir</span>
        <strong id="saldo-disponible">{pesos(resumen.porTransferir)}</strong>
        <small>Psynex te lo transfiere</small>
      </article>
      <article class="fin-card fin-stat">
        <span>Ingresos del mes</span>
        <strong>{pesos(resumen.netoMes)}</strong>
        <small>Después de la comisión ({resumen.comisionPorcentaje}%)</small>
      </article>
      <article class="fin-card fin-stat">
        <span>Citas gratuitas</span>
        <strong>{resumen.citasGratuitas}</strong>
        <small>En total</small>
      </article>
      <article class="fin-card fin-stat">
        <span>Citas pagadas</span>
        <strong>{resumen.citasPagadasMes}</strong>
        <small>Este mes</small>
      </article>
      <article class="fin-card fin-stat fin-stat-bank">
        <span>Cuenta bancaria</span>
        <strong class="fin-bank-name" id="banco-resumen">{principal ? principal.Banco : "Sin cuenta"}</strong>
        <div class="fin-bank-row">
          <small id="cuenta-resumen">{principal ? principal.NumeroCuenta : "Agrega una cuenta"}</small>
          <button class="fin-btn fin-btn-outline fin-btn-sm" data-open="modal-cuentas">{principal ? "Ver detalles" : "Agregar"}</button>
        </div>
      </article>
    </section>

    <section class="fin-main-grid">
      <article class="fin-card fin-movements">
        <div class="fin-panel-heading">
          <div>
            <span class="fin-kicker">ACTIVIDAD</span>
            <h2>Movimientos recientes</h2>
          </div>
          <label class="fin-period">
            <span>Periodo</span>
            <select id="filtro-periodo">
              <option value="actual">Mes actual</option>
              <option value="pendientes">Por transferir</option>
              <option value="todos">Todos</option>
            </select>
          </label>
        </div>

        <div class="fin-table-wrap">
          <table class="fin-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Descripción</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th class="fin-right">Recibes</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="lista-movimientos">
              {movimientos.map((m) => (
                <tr
                  data-movement
                  data-mes={m.FechaPago ? mesDe(m.FechaPago) : ""}
                  data-transferencia={m.EstadoTransferencia}
                  data-description={`Consulta ${modalidad(m.Modalidad)}`}
                  data-date={m.CitaFecha ? `${fechaTexto(m.CitaFecha)} · ${hora(m.CitaFecha)}` : "—"}
                  data-paciente={m.PacienteNombre}
                  data-modalidad={m.Modalidad ?? "Virtual"}
                  data-tipo={tipoDe(m)}
                  data-total={m.MontoTotal}
                  data-porcentaje={m.PorcentajeComision}
                  data-comision={m.ComisionPsynex}
                  data-neto={m.MontoNeto}
                  data-pagado={m.FechaPago ? fechaTexto(m.FechaPago) : "—"}
                  data-transferido={m.FechaTransferencia ? fechaTexto(m.FechaTransferencia) : ""}
                >
                  <td>{m.FechaPago ? fechaNum(m.FechaPago) : "—"}</td>
                  <td class="fin-description">Consulta {modalidad(m.Modalidad)} · {m.PacienteNombre}</td>
                  <td>{tipoDe(m)}</td>
                  <td>
                    <span class={`fin-status ${m.EstadoTransferencia === "Transferido" ? "" : "is-pendiente"}`}>
                      {m.EstadoTransferencia === "Transferido" ? "Transferido" : "Por transferir"}
                    </span>
                  </td>
                  <td class="fin-right fin-income">+ {pesos(Number(m.MontoNeto))}</td>
                  <td><button class="fin-mini-action" data-payment>Ver</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fin-empty" id="sin-movimientos" hidden>No hay movimientos para este periodo.</p>
        <footer class="fin-table-footer">
          <span id="total-movimientos">{movimientos.length} movimientos</span>
          <button class="fin-link" id="ver-todos">Ver todos →</button>
        </footer>
      </article>

      <article class="fin-card fin-summary">
        <div class="fin-panel-heading">
          <div>
            <span class="fin-kicker">ESTADÍSTICAS</span>
            <h2>Resumen del mes</h2>
          </div>
          <label class="fin-month">
            <span class="fin-sr-only">Mes</span>
            <select id="mes-resumen">
              {meses.map((m) => <option value={m.clave}>{m.texto}</option>)}
            </select>
          </label>
        </div>

        <div class="fin-chart-layout">
          <div class="fin-donut" id="dona" role="img" aria-label="Distribución de citas pagadas, citas gratuitas y comisiones">
            <div class="fin-donut-center">
              <strong id="dona-total">$0</strong>
              <span>Recibido en el mes</span>
            </div>
          </div>
          <div class="fin-legend">
            <div class="fin-legend-item">
              <i class="fin-dot fin-dot-paid"></i>
              <div><span>Citas pagadas</span><strong id="leyenda-pagadas">$0</strong></div>
              <small id="pct-pagadas">0%</small>
            </div>
            <div class="fin-legend-item">
              <i class="fin-dot fin-dot-free"></i>
              <div><span>Citas gratuitas</span><strong id="leyenda-gratuitas">$0</strong></div>
              <small id="pct-gratuitas">0%</small>
            </div>
            <div class="fin-legend-item">
              <i class="fin-dot fin-dot-fees"></i>
              <div><span>Comisión Psynex</span><strong id="leyenda-comision">$0</strong></div>
              <small id="pct-comision">0%</small>
            </div>
          </div>
        </div>

        <div class="fin-note">
          <span aria-hidden="true">ⓘ</span>
          <p>Las citas gratuitas son una forma de apoyo a quienes más lo necesitan. Psynex te reconoce su valor y no se descuenta de tu saldo.</p>
        </div>
      </article>
    </section>

    <section class="fin-bottom-grid">
      <article class="fin-card fin-transfer">
        <div class="fin-icon-heading">
          <span class="fin-round-icon"><i class="bi bi-bank" aria-hidden="true"></i></span>
          <div><span class="fin-kicker">TRANSFERENCIAS</span><h2>Tus pagos</h2></div>
        </div>
        <div class="fin-transfer-info">
          <div>
            <small>Última transferencia</small>
            <strong><i class="bi bi-calendar3" aria-hidden="true"></i> &nbsp;{ultimaTransferencia ? fechaTexto(ultimaTransferencia) : "Aún no hay"}</strong>
          </div>
          <div>
            <small>Cuenta de destino</small>
            <strong id="transfer-banco">{principal ? `${principal.Banco} · ${principal.TipoCuenta}` : "Sin cuenta registrada"}</strong>
            <small id="transfer-cuenta">{principal?.NumeroCuenta ?? ""}</small>
          </div>
          <div><small>Por transferir</small><strong>{pesos(resumen.porTransferir)}</strong></div>
        </div>
        <div class="fin-action-row">
          <button class="fin-btn fin-btn-outline" id="ver-pendientes">Ver pagos por transferir →</button>
        </div>
      </article>

      <article class="fin-card fin-claims">
        <div class="fin-icon-heading">
          <span class="fin-round-icon"><i class="bi bi-chat-left-text" aria-hidden="true"></i></span>
          <div><span class="fin-kicker">SOPORTE FINANCIERO</span><h2>Reclamos</h2></div>
        </div>
        <p>Registra una duda sobre un movimiento o pago.</p>
        {reclamos.length > 0 && (
          <ul class="fin-reclamos">
            {reclamos.slice(0, 3).map((r) => (
              <li>
                <span>{r.Motivo}</span>
                <span class={`fin-status ${r.Estado === "Resuelto" || r.Estado === "Cerrado" ? "" : "is-pendiente"}`}>{r.Estado}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="fin-action-row">
          <button class="fin-btn fin-btn-outline" data-open="modal-reclamo">Crear reclamo</button>
        </div>
      </article>

      <article class="fin-card fin-appointments">
        <div class="fin-icon-heading">
          <span class="fin-round-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
          <div><span class="fin-kicker">AGENDA</span><h2>Citas asignadas</h2></div>
          <span class="fin-pending" id="citas-pendientes">{pendientes.length} {pendientes.length === 1 ? "pendiente" : "pendientes"}</span>
        </div>

        {proximaCita ? (
          <div class="fin-appointment" id="cita-pendiente" data-cita={proximaCita.CitaId}>
            <span class="fin-round-icon fin-appointment-icon"><i class="bi bi-calendar-event" aria-hidden="true"></i></span>
            <div class="fin-appointment-details">
              <strong>Consulta {modalidad(proximaCita.Modalidad)}</strong>
              <span>Paciente: {proximaCita.PacienteNombre}</span>
              <span>{fechaTexto(proximaCita.FechaHora)} · {hora(proximaCita.FechaHora)}</span>
              <span>Duración: {proximaCita.DuracionMinutos ?? 50} min</span>
              <span>Pago: {proximaCita.EstadoPago === "Completado" ? "Pagado" : "Pendiente"}</span>
            </div>
            <div class="fin-appointment-buttons">
              <button class="fin-btn fin-btn-primary" data-appointment="Confirmada">Aceptar cita</button>
              <button class="fin-btn fin-btn-outline" data-appointment="Cancelada">Rechazar</button>
            </div>
          </div>
        ) : (
          <p class="fin-empty">No tienes citas esperando respuesta.</p>
        )}
        <a class="fin-link fin-all-appointments" href="/Psicologos/Citas">Ver todas las citas →</a>
      </article>
    </section>
  </main>
</div>

<!-- 1. DETALLE DEL PAGO -->
<div class="fin-modal" id="modal-pago" hidden>
  <button class="fin-backdrop" data-close aria-label="Cerrar"></button>
  <section class="fin-modal-card fin-modal-payment" role="dialog" aria-modal="true" aria-labelledby="titulo-pago">
    <header class="fin-modal-heading">
      <h2 id="titulo-pago">Detalle del pago</h2>
      <button class="fin-close" data-close aria-label="Cerrar">×</button>
    </header>
    <div class="fin-payment-title">
      <strong id="pago-descripcion">Consulta</strong>
      <span class="fin-status" id="pago-estado">Transferido</span>
    </div>
    <div class="fin-payment-grid">
      <div><small>Fecha de la cita</small><strong id="pago-fecha">—</strong></div>
      <div><small>Paciente</small><strong id="pago-destino">—</strong></div>
      <div><small>Modalidad</small><strong id="pago-modalidad">—</strong></div>
      <div><small>Pagado el</small><strong id="pago-pagado">—</strong></div>
    </div>
    <hr />
    <h3>Detalle de ingresos y descuentos</h3>
    <div class="fin-breakdown"><span>Pago de la cita</span><span id="pago-bruto">$0</span></div>
    <div class="fin-breakdown"><span id="pago-comision-texto">Comisión de Psynex</span><span id="pago-comision">− $0</span></div>
    <div class="fin-breakdown fin-breakdown-total"><strong>Total que recibes</strong><strong id="pago-neto">$0</strong></div>
    <p class="fin-modal-nota" id="pago-transferencia"></p>
    <footer class="fin-modal-actions">
      <button class="fin-btn fin-btn-outline" data-close>Cerrar</button>
    </footer>
  </section>
</div>

<!-- 2. CREAR RECLAMO -->
<div class="fin-modal" id="modal-reclamo" hidden>
  <button class="fin-backdrop" data-close aria-label="Cerrar"></button>
  <section class="fin-modal-card" role="dialog" aria-modal="true" aria-labelledby="titulo-reclamo">
    <header class="fin-modal-heading">
      <div><h2 id="titulo-reclamo">Crear reclamo</h2><p>Cuéntanos qué ocurrió con tu movimiento o pago.</p></div>
      <button class="fin-close" data-close aria-label="Cerrar">×</button>
    </header>
    <form id="form-reclamo" class="fin-form">
      <label>Motivo
        <select name="motivo" required>
          <option value="">Selecciona un motivo</option>
          <option>Pago no recibido</option>
          <option>Valor incorrecto</option>
          <option>Comisión o descuento</option>
          <option>Movimiento desconocido</option>
          <option>Otro motivo</option>
        </select>
      </label>
      <label>Movimiento relacionado
        <select name="pagoId">
          <option value="">Ninguno en particular</option>
          {movimientos.map((m) => (
            <option value={m.PagoId}>
              {m.FechaPago ? fechaNum(m.FechaPago) : "—"} · {m.PacienteNombre} · {pesos(Number(m.MontoNeto))}
            </option>
          ))}
        </select>
      </label>
      <label>Descripción
        <textarea name="descripcion" rows="4" required minlength="10" maxlength="1000" placeholder="Describe aquí tu reclamo (mínimo 10 caracteres)..."></textarea>
      </label>
      <p class="fin-form-message" id="reclamo-mensaje" role="status"></p>
      <footer class="fin-modal-actions">
        <button type="button" class="fin-btn fin-btn-outline" data-close>Cancelar</button>
        <button type="submit" class="fin-btn fin-btn-primary">Enviar reclamo</button>
      </footer>
    </form>
  </section>
</div>

<!-- 3. NUEVA CUENTA (oficial o secundaria, el mismo formulario) -->
<div class="fin-modal" id="modal-cuenta-form" hidden>
  <button class="fin-backdrop" data-close aria-label="Cerrar"></button>
  <section class="fin-modal-card" role="dialog" aria-modal="true" aria-labelledby="titulo-cuenta-form">
    <header class="fin-modal-heading">
      <div><h2 id="titulo-cuenta-form">Cuenta oficial</h2><p id="sub-cuenta-form">Tu cuenta bancaria principal.</p></div>
      <button class="fin-close" data-close aria-label="Cerrar">×</button>
    </header>
    <form class="fin-form" id="form-cuenta">
      <label>Banco
        <select name="banco" required>
          <option value="">Selecciona un banco</option>
          <option>Banco de Bogotá</option><option>Bancolombia</option>
          <option>Davivienda</option><option>BBVA Colombia</option>
          <option>Banco Caja Social</option><option>Banco de Occidente</option>
          <option>Banco Popular</option><option>Nequi</option><option>Daviplata</option>
        </select>
      </label>
      <label>Tipo de cuenta
        <select name="tipo" required>
          <option value="">Selecciona el tipo</option>
          <option>Ahorros</option><option>Corriente</option><option>Nequi</option><option>Daviplata</option>
        </select>
      </label>
      <label>Número de cuenta
        <input name="numero" inputmode="numeric" pattern="[0-9]{6,20}" required minlength="6" maxlength="20" placeholder="Solo números" />
      </label>
      <label>Titular de la cuenta
        <input name="titular" required minlength="3" maxlength="150" placeholder="Nombre como aparece en el banco" />
      </label>
      <p class="fin-form-message" role="status"></p>
      <footer class="fin-modal-actions">
        <button type="button" class="fin-btn fin-btn-outline" data-close>Cancelar</button>
        <button type="submit" class="fin-btn fin-btn-primary">Guardar</button>
      </footer>
    </form>
  </section>
</div>

<!-- 4. GESTIONAR CUENTAS -->
<div class="fin-modal" id="modal-cuentas" hidden>
  <button class="fin-backdrop" data-close aria-label="Cerrar"></button>
  <section class="fin-modal-card" role="dialog" aria-modal="true" aria-labelledby="titulo-cuentas">
    <header class="fin-modal-heading">
      <div><h2 id="titulo-cuentas">Gestionar cuenta bancaria</h2><p>Aquí te transferimos lo que ganas en Psynex.</p></div>
      <button class="fin-close" data-close aria-label="Cerrar">×</button>
    </header>

    {cuentas.length > 0 && (
      <ul class="fin-cuentas">
        {cuentas.map((c) => (
          <li data-cuenta={c.CuentaId}>
            <div>
              <strong>{c.Banco === c.TipoCuenta ? c.Banco : `${c.Banco} · ${c.TipoCuenta}`}</strong>
              <small>{c.NumeroCuenta} · {c.TitularCuenta}</small>
            </div>
            <div class="fin-cuenta-acciones">
              {Number(c.EsPrincipal) === 1
                ? <span class="fin-status">Oficial</span>
                : <button class="fin-mini-action" data-principal>Hacer oficial</button>}
              {Number(c.EstaVerificada) !== 1 && <span class="fin-status is-pendiente">Sin verificar</span>}
              <button class="fin-mini-action fin-mini-danger" data-eliminar-cuenta aria-label="Eliminar cuenta">Eliminar</button>
            </div>
          </li>
        ))}
      </ul>
    )}

    <p class="fin-cuentas-sub">Agregar una cuenta</p>
    <div class="fin-account-options">
      <button class="fin-account-option is-selected" data-account-open="official">
        <span class="fin-radio"></span>
        <span><strong>Cuenta oficial</strong><small>Para recibir tus pagos.</small></span>
      </button>
      <button class="fin-account-option" data-account-open="secondary">
        <span class="fin-radio"></span>
        <span><strong>Cuenta secundaria</strong><small>De respaldo, por si la oficial falla.</small></span>
      </button>
    </div>
    <footer class="fin-modal-actions">
      <button class="fin-btn fin-btn-outline" data-close>Cancelar</button>
      <button class="fin-btn fin-btn-primary" id="continuar-cuenta">Continuar</button>
    </footer>
  </section>
</div>

<div class="fin-toast" id="fin-toast" role="status" aria-live="polite"></div>

<script type="application/json" id="fin-datos" set:html={JSON.stringify(datos).replace(/</g, "\\u003c")}></script>

<script>
  import { apiEnviar, textoError, pesos } from "../../lib/api";

  const toast = document.querySelector<HTMLDivElement>("#fin-toast");
  const datos = JSON.parse(document.querySelector("#fin-datos")?.textContent || "{}");

  let selectedAccount: string = "official";
  let toastTimer: ReturnType<typeof window.setTimeout> | undefined;

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const texto = (sel: string, valor: string) => {
    const el = $(sel);
    if (el) el.textContent = valor;
  };

  function notify(message: string): void {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add("is-visible");
    if (toastTimer !== undefined) window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove("is-visible");
      toastTimer = undefined;
    }, 3000);
  }

  function openModal(id: string | null): void {
    if (!id) return;
    const modal = document.getElementById(id);
    if (!(modal instanceof HTMLElement)) return;

    document.querySelectorAll<HTMLElement>(".fin-modal:not([hidden])").forEach((item) => {
      item.hidden = true;
    });
    modal.querySelectorAll<HTMLElement>(".fin-form-message").forEach((p) => (p.textContent = ""));
    modal.hidden = false;
    document.body.classList.add("fin-modal-open");
    modal.querySelector<HTMLElement>("input, select, textarea, button:not(.fin-backdrop)")?.focus();
  }

  function closeModal(modal: HTMLElement | null): void {
    if (!modal) return;
    modal.hidden = true;
    if (document.querySelectorAll(".fin-modal:not([hidden])").length === 0) {
      document.body.classList.remove("fin-modal-open");
    }
  }

  document.addEventListener("click", (event: MouseEvent) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const openButton = target.closest<HTMLElement>("[data-open]");
    if (openButton) {
      openModal(openButton.getAttribute("data-open"));
      return;
    }
    const closeButton = target.closest<HTMLElement>("[data-close]");
    if (closeButton) closeModal(closeButton.closest<HTMLElement>(".fin-modal"));
  });

  document.addEventListener("keydown", (event: KeyboardEvent) => {
    if (event.key !== "Escape") return;
    document.querySelectorAll<HTMLElement>(".fin-modal:not([hidden])").forEach((modal) => closeModal(modal));
  });

  // Mientras se envía, el botón queda bloqueado
  async function conBoton<T>(boton: HTMLButtonElement | null, tarea: () => Promise<T>): Promise<T> {
    if (boton) boton.disabled = true;
    try {
      return await tarea();
    } finally {
      if (boton) boton.disabled = false;
    }
  }

  // ----------------------------- Cuentas -----------------------------
  document.querySelectorAll<HTMLElement>("[data-account-open]").forEach((button) => {
    button.addEventListener("click", () => {
      selectedAccount = button.getAttribute("data-account-open") || "official";
      document.querySelectorAll<HTMLElement>("[data-account-open]").forEach((option) => {
        option.classList.toggle("is-selected", option === button);
      });
    });
  });

  $("#continuar-cuenta")?.addEventListener("click", () => {
    closeModal($("#modal-cuentas"));
    const oficial = selectedAccount === "official";
    texto("#titulo-cuenta-form", oficial ? "Cuenta oficial" : "Cuenta secundaria");
    texto("#sub-cuenta-form", oficial ? "Aquí recibirás tus pagos." : "Una cuenta de respaldo.");
    $<HTMLFormElement>("#form-cuenta")?.reset();
    openModal("modal-cuenta-form");
  });

  const formCuenta = $<HTMLFormElement>("#form-cuenta");
  formCuenta?.addEventListener("submit", async (event: SubmitEvent) => {
    event.preventDefault();
    if (!formCuenta.reportValidity()) return;
    const data = new FormData(formCuenta);
    const mensaje = formCuenta.querySelector<HTMLElement>(".fin-form-message");
    const r = await conBoton(formCuenta.querySelector("button[type=submit]"), () =>
      apiEnviar("POST", "/api/psicologo/finanzas/cuentas", {
        banco: String(data.get("banco") || ""),
        tipoCuenta: String(data.get("tipo") || ""),
        numeroCuenta: String(data.get("numero") || "").replace(/\D/g, ""),
        titularCuenta: String(data.get("titular") || "").trim(),
        esPrincipal: selectedAccount === "official",
      }));
    if (!r.ok) {
      if (mensaje) mensaje.textContent = textoError(r.data, "No se pudo guardar la cuenta");
      return;
    }
    notify("Cuenta guardada.");
    window.setTimeout(() => location.reload(), 700);
  });

  // Hacer oficial / eliminar una cuenta de la lista
  document.querySelectorAll<HTMLElement>("[data-cuenta]").forEach((fila) => {
    const id = fila.dataset.cuenta;
    fila.querySelector<HTMLButtonElement>("[data-principal]")?.addEventListener("click", async (e) => {
      const r = await conBoton(e.currentTarget as HTMLButtonElement, () =>
        apiEnviar("PATCH", `/api/psicologo/finanzas/cuentas/${id}`, { esPrincipal: true }));
      if (!r.ok) return notify(textoError(r.data, "No se pudo cambiar la cuenta oficial"));
      notify("Cuenta oficial actualizada.");
      window.setTimeout(() => location.reload(), 700);
    });

    const borrar = fila.querySelector<HTMLButtonElement>("[data-eliminar-cuenta]");
    borrar?.addEventListener("click", async () => {
      // Primer clic pide confirmación, el segundo elimina
      if (borrar.dataset.confirmar !== "1") {
        borrar.dataset.confirmar = "1";
        borrar.textContent = "¿Seguro?";
        window.setTimeout(() => {
          borrar.dataset.confirmar = "";
          borrar.textContent = "Eliminar";
        }, 3000);
        return;
      }
      const r = await conBoton(borrar, () => apiEnviar("DELETE", `/api/psicologo/finanzas/cuentas/${id}`));
      if (!r.ok) return notify(textoError(r.data, "No se pudo eliminar la cuenta"));
      notify("Cuenta eliminada.");
      window.setTimeout(() => location.reload(), 700);
    });
  });

  // ------------------------- Detalle del pago -------------------------
  document.querySelectorAll<HTMLElement>("[data-movement]").forEach((row) => {
    row.querySelector<HTMLButtonElement>("[data-payment]")?.addEventListener("click", () => {
      const d = row.dataset;
      const transferido = d.transferencia === "Transferido";
      texto("#pago-descripcion", d.description || "Consulta");
      texto("#pago-fecha", d.date || "—");
      texto("#pago-destino", d.paciente || "—");
      texto("#pago-modalidad", d.modalidad || "—");
      texto("#pago-pagado", d.pagado || "—");
      texto("#pago-bruto", pesos(Number(d.total || 0)));
      texto("#pago-comision-texto", `Comisión de Psynex (${Number(d.porcentaje || 0)}%)`);
      texto("#pago-comision", `− ${pesos(Number(d.comision || 0))}`);
      texto("#pago-neto", pesos(Number(d.neto || 0)));
      texto("#pago-transferencia", transferido
        ? `Psynex te lo transfirió el ${d.transferido}.`
        : "Psynex aún no te lo ha transferido.");
      const estado = $("#pago-estado");
      if (estado) {
        estado.textContent = transferido ? "Transferido" : "Por transferir";
        estado.classList.toggle("is-pendiente", !transferido);
      }
      if (d.tipo === "Gratuita") texto("#pago-descripcion", `${d.description} (gratuita)`);
      openModal("modal-pago");
    });
  });

  // ------------------------------ Reclamo ------------------------------
  const formReclamo = $<HTMLFormElement>("#form-reclamo");
  formReclamo?.addEventListener("submit", async (event: SubmitEvent) => {
    event.preventDefault();
    if (!formReclamo.reportValidity()) return;
    const data = new FormData(formReclamo);
    const mensaje = $("#reclamo-mensaje");
    const pagoId = String(data.get("pagoId") || "");
    const r = await conBoton(formReclamo.querySelector("button[type=submit]"), () =>
      apiEnviar("POST", "/api/psicologo/finanzas/reclamos", {
        motivo: String(data.get("motivo") || ""),
        descripcion: String(data.get("descripcion") || "").trim(),
        pagoId: pagoId || null,
      }));
    if (!r.ok) {
      if (mensaje) mensaje.textContent = textoError(r.data, "No se pudo enviar el reclamo");
      return;
    }
    notify("Reclamo enviado. Te responderemos pronto.");
    window.setTimeout(() => location.reload(), 900);
  });

  // ---------------------------- Movimientos ----------------------------
  const periodFilter = $<HTMLSelectElement>("#filtro-periodo");
  const movementRows = Array.from(document.querySelectorAll<HTMLElement>("[data-movement]"));
  const count = $("#total-movimientos");
  const empty = $("#sin-movimientos");
  const showAllButton = $<HTMLButtonElement>("#ver-todos");
  const LIMITE = 6;
  let verTodos = false;

  function filterMovements(): void {
    const periodo = periodFilter?.value ?? "actual";
    const coinciden = movementRows.filter((row) =>
      periodo === "todos" ? true
        : periodo === "pendientes" ? row.dataset.transferencia !== "Transferido"
        : row.dataset.mes === datos.mesActual);

    movementRows.forEach((row) => (row.hidden = true));
    coinciden.forEach((row, i) => (row.hidden = !verTodos && i >= LIMITE));

    if (count) count.textContent = `${coinciden.length} movimiento${coinciden.length === 1 ? "" : "s"}`;
    if (empty) empty.hidden = coinciden.length !== 0;
    if (showAllButton) {
      showAllButton.hidden = coinciden.length <= LIMITE;
      showAllButton.textContent = verTodos ? "Mostrar menos ↑" : "Ver todos →";
    }
  }

  periodFilter?.addEventListener("change", () => {
    verTodos = false;
    filterMovements();
  });
  showAllButton?.addEventListener("click", () => {
    verTodos = !verTodos;
    filterMovements();
  });
  $("#ver-pendientes")?.addEventListener("click", () => {
    if (periodFilter) periodFilter.value = "pendientes";
    verTodos = false;
    filterMovements();
    $("#lista-movimientos")?.closest(".fin-card")?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
  filterMovements();

  // ------------------------- Resumen del mes -------------------------
  const mesResumen = $<HTMLSelectElement>("#mes-resumen");

  function pintarResumen(): void {
    const mes = mesResumen?.value ?? datos.mesActual;
    const delMes = (datos.movimientos ?? []).filter((m: any) => m.mes === mes);
    const pagadas = delMes.filter((m: any) => m.origen !== "Recompensa").reduce((s: number, m: any) => s + m.neto, 0);
    const gratuitas = delMes.filter((m: any) => m.origen === "Recompensa").reduce((s: number, m: any) => s + m.neto, 0);
    const comision = delMes.reduce((s: number, m: any) => s + m.comision, 0);
    const base = pagadas + gratuitas + comision;
    const pct = (v: number) => (base ? Math.round((v / base) * 100) : 0);

    texto("#dona-total", pesos(pagadas + gratuitas));
    texto("#leyenda-pagadas", pesos(pagadas));
    texto("#leyenda-gratuitas", pesos(gratuitas));
    texto("#leyenda-comision", `− ${pesos(comision)}`);
    texto("#pct-pagadas", `${pct(pagadas)}%`);
    texto("#pct-gratuitas", `${pct(gratuitas)}%`);
    texto("#pct-comision", `${pct(comision)}%`);

    const dona = $("#dona");
    if (dona) {
      const a = base ? (pagadas / base) * 100 : 0;
      const b = base ? ((pagadas + gratuitas) / base) * 100 : 0;
      dona.style.setProperty("--a", `${a}%`);
      dona.style.setProperty("--b", `${b}%`);
      dona.classList.toggle("is-vacia", !base);
    }
  }
  mesResumen?.addEventListener("change", pintarResumen);
  pintarResumen();

  // ------------------------ Citas por responder ------------------------
  document.querySelectorAll<HTMLButtonElement>("[data-appointment]").forEach((button) => {
    button.addEventListener("click", async () => {
      const estado = button.getAttribute("data-appointment");
      const tarjeta = $("#cita-pendiente");
      const citaId = tarjeta?.dataset.cita;
      if (!tarjeta || !citaId) return;

      const botones = tarjeta.querySelectorAll<HTMLButtonElement>("button");
      botones.forEach((b) => (b.disabled = true));
      const r = await apiEnviar("PATCH", `/api/psicologo/citas/${citaId}/estado`, { estado });
      if (!r.ok) {
        botones.forEach((b) => (b.disabled = false));
        return notify(textoError(r.data, "No se pudo actualizar la cita"));
      }

      tarjeta.querySelector(".fin-appointment-result")?.remove();
      const resultado = document.createElement("span");
      resultado.className = "fin-appointment-result";
      resultado.textContent = estado === "Confirmada" ? "Cita aceptada" : "Cita rechazada";
      tarjeta.append(resultado);
      notify(estado === "Confirmada" ? "Cita aceptada. Le avisamos al paciente." : "Cita rechazada.");
      window.setTimeout(() => location.reload(), 1500);
    });
  });
</script>
