                if (inputNit) inputNit.value = empresaData.nit || "";
                if (selectSector)
                    selectSector.value = empresaData.sector || "Salud";
                if (inputDescripcion)
                    inputDescripcion.value = empresaData.descripcion || "";
                if (inputSitioWeb)
                    inputSitioWeb.value = empresaData.sitioWeb || "";
                if (inputTelefono)
