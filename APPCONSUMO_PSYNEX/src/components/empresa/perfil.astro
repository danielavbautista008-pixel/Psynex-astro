---
import MenuE from "./menuE.astro";
import "./perfil.css";
---

<div class="landing-container">
    <MenuE />
    <main class="Bienvenida-Em">
        <div class="perfil-empresa-container">
            <!-- Header -->
            <div class="header-perfil">
                <h1 id="header-titulo">Cargando Empresa...</h1>
                <p>Gestiona la información de tu empresa.</p>
            </div>

            <!-- Tarjeta Izquierda: Avatar / Logo -->
            <div class="perfil-avatar-card">
                <div class="avatar-uploader-zone">
                    <img
                        id="avatar-preview"
                        src="/imagenes/PerfilEmpresa.jpg"
                        alt="Logo de la Empresa"
                        class="avatar-preview"
                    />

                    <button
                        type="button"
                        id="btn-trigger-file"
                        class="btn-cambiar-foto"
                        title="Cambiar foto de perfil"
                    >
                        <i class="bi bi-camera-fill"></i>
                    </button>

                    <!-- Input oculto para subir la imagen -->
                    <input
                        type="file"
                        id="file-input-logo"
                        accept="image/*"
                        style="display: none;"
                    />
                </div>

                <h2 id="empresa-nombre-title" class="empresa-nombre-title">
                    Cargando Empresa...
                </h2>

                <div class="badge-verificado">
                    <span>Empresa Verificada</span>
                    <i class="bi bi-check-lg"></i>
                </div>
            </div>

            <!-- Tarjeta Derecha: Formulario -->
            <div class="perfil-form-card">
                <!-- Mensajes de Alerta -->
                <div
                    id="alerta-exito"
                    class="alerta-exito"
                    style="display: none;"
                >
                    <i class="bi bi-check-circle-fill"></i>
                    <span id="texto-exito"></span>
                </div>
                <div
                    id="alerta-error"
                    class="alerta-error"
                    style="display: none;"
                >
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span id="texto-error"></span>
                </div>

                <form id="perfil-form">
                    <div class="form-group-custom full-width">
                        <label for="nombre-empresa">Nombre de la empresa</label>
                        <input
                            type="text"
                            id="nombre-empresa"
                            placeholder="Empresa XYZ SAS"
                            required
                        />
                    </div>

                    <div class="form-row-custom">
                        <div class="form-group-custom">
                            <label for="nit">NIT</label>
                            <input type="text" id="nit" required />
                        </div>

                        <div class="form-group-custom">
                            <label for="sector">Sector</label>
                            <select id="sector" class="select-custom">
                                <option value="Salud">Salud y Bienestar</option>
                                <option value="Educacion">Educación</option>
                                <option value="Tecnologia">Tecnología</option>
                                <option value="Otros">Otros</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group-custom full-width">
                        <label for="descripcion-empresa"
                            >Descripción de la empresa</label
                        >
                        <textarea
                            id="descripcion-empresa"
                            rows="4"
                            placeholder="Somos una empresa dedicada al bienestar emocional y mental..."
                        ></textarea>
                    </div>

                    <div class="form-row-custom">
                        <div class="form-group-custom">
                            <label for="sitio-web">Sitio web</label>
                            <input
                                type="url"
                                id="sitio-web"
                                placeholder="https://ejemplo.com"
                            />
                        </div>

                        <div class="form-group-custom">
                            <label for="telefono">Teléfono</label>
                            <input
                                type="tel"
                                id="telefono"
                                placeholder="+57 300 123 4567"
                            />
                        </div>
                    </div>

                    <div class="form-actions-row">
                        <button
                            type="submit"
                            id="btn-guardar"
                            class="btn-guardar-cambios"
                        >
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</div>

