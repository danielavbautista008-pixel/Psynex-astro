---
import MenuE from "./menuE.astro";
import VentanasEmpresa from "./VentanasEmpresa.astro"; // cambio: ventanas emergentes
import "./ofertas.css";
---

<div class="landing-container">
  <MenuE />
  <VentanasEmpresa /> <!-- cambio: ventanas emergentes -->
  <main class="Bienvenida-Em">
    
    <!-- Encabezado igual a Inicio -->
    <header class="dashboard-header">
      <h1>Gestión de Ofertas</h1>
      <p>Publica vacantes para psicólogos especializados.</p>
    </header>

    <div class="ofertas-grid-layout">
      <!-- Formulario para crear oferta -->
      <div class="oferta-form-card">
        <h2>Crear nueva oferta</h2>

        <div id="alert-exito" class="alert alert-success" style="color: green; margin-bottom: 15px; display: none;"></div>
        <div id="alert-error" class="alert alert-danger" style="color: red; margin-bottom: 15px; display: none;"></div>

        <form id="form-crear-oferta">
          <div class="form-group-custom">
            <label for="titulo">Título de la oferta</label>
            <input type="text" id="titulo" name="Titulo" placeholder="Ej. Psicólogo Organizacional" required />
          </div>

          <div class="form-group-custom">
            <label for="descripcion">Descripción</label>
            <textarea id="descripcion" name="Descripcion" rows="4" placeholder="Describe las funciones y responsabilidades..." required></textarea>
          </div>

          <div class="form-group-custom">
            <label for="requisitos">Requisitos</label>
            <textarea id="requisitos" name="Requisitos" rows="3" placeholder="Describe los requisitos necesarios..." required></textarea>
          </div>

          <div class="form-row-custom">
            <div class="form-group-custom input-salario">
              <label for="salario">Salario</label>
              <input type="number" id="salario" name="Salario" placeholder="Ej. 2500000" />
            </div>

            <div class="form-group-custom input-modalidad">
              <label>Modalidad</label>
              <div class="radio-group-custom">
                <label class="radio-option">
                  <input type="radio" name="modalidad" value="Virtual" checked />
                  <span>Virtual</span>
                </label>
                <label class="radio-option">
                  <input type="radio" name="modalidad" value="Presencial" />
                  <span>Presencial</span>
                </label>
                <label class="radio-option">
                  <input type="radio" name="modalidad" value="Hibrido" />
                  <span>Híbrido</span>
                </label>
              </div>
            </div>
          </div>

          <button type="submit" class="btn-publicar-oferta">Publicar Oferta</button>
        </form>
      </div>

      <!-- Columna de tablas de datos -->
      <div class="ofertas-data-column">
        
        <!-- Tabla: Mis ofertas publicadas -->
        <div class="data-card">
          <h2>Mis ofertas publicadas</h2>
          <div class="responsive-table-holder">
            <table class="custom-table">
              <thead>
                <tr>
                  <th>Oferta</th>
                  <th>Modalidad</th>
                  <th>Estado</th>
                  <th>Postulaciones</th>
                  <th class="text-center">Acciones</th>
                </tr>
              </thead>
              <!-- CONEXIÓN (empresa.e): las ofertas las llena el script (GET /api/empresa/ofertas) -->
              <tbody id="tabla-ofertas-body">
                <tr>
                  <td colspan="5" style="text-align: center;">Cargando ofertas...</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Bloque de Paginación UI -->
          <div id="pagination-container" class="pagination-wrapper" style="display: none;">
            <button type="button" id="btn-page-prev" class="page-arrow">
              <i class="bi bi-chevron-left"></i>
            </button>
            <div id="page-numbers" style="display: flex; gap: 8px;"></div>
            <button type="button" id="btn-page-next" class="page-arrow">
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>
        </div>

        <!-- Tabla: Postulantes -->
        <div class="data-card">
          <!-- CONEXIÓN (empresa.e): el título y las filas los llena el script con las
               postulaciones reales de la oferta elegida (GET /api/empresa/postulaciones) -->
          <h2 id="titulo-postulantes">Postulantes - Psicólogo Organizacional</h2>
          <div class="responsive-table-holder">
            <table class="custom-table v-align-middle">
              <thead>
                <tr>
                  <th>Psicólogo</th>
                  <th>Fecha</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody id="tabla-postulantes-body">
                <tr>
                  <td>
                    <div class="user-profile-cell">
                      <img src="https://images.pexels.com/photos/4158293/pexels-photo-4158293.jpeg" alt="Ana" />
                      <span>Ana Martínez</span>
                    </div>
                  </td>
                  <td>10/05/2025</td>
                  <td>
                    <div class="action-buttons-group">
                      <button class="btn-table btn-accept">Aceptar</button>
                      <button class="btn-table btn-reject">Rechazar</button>
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>
                    <div class="user-profile-cell">
                      <img src="https://images.pexels.com/photos/220453/pexels-photo-220453.jpeg" alt="Juan" />
                      <span>Juan Gómez</span>
                    </div>
                  </td>
                  <td>08/05/2025</td>
                  <td>
                    <div class="action-buttons-group">
                      <button class="btn-table btn-accept">Aceptar</button>
                      <button class="btn-table btn-reject">Rechazar</button>
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>
                    <div class="user-profile-cell">
                      <img src="https://images.pexels.com/photos/1181686/pexels-photo-1181686.jpeg" alt="Maria" />
                      <span>María López</span>
                    </div>
                  </td>
                  <td>08/05/2025</td>
                  <td>
                    <div class="action-buttons-group">
                      <button class="btn-table btn-accept">Aceptar</button>
                      <button class="btn-table btn-reject">Rechazar</button>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="card-footer-link">
            <!-- cambio: antes iba a /Empresa/Gestion/Postulantes (no existía) -->
            <a href="/Empresa/Postulaciones" class="view-more-btn">Ver todos los postulantes &rarr;</a>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>

<!-- Modal para Editar Oferta -->
<div id="modal-editar" class="modal-backdrop" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="oferta-form-card modal-card">
        <button type="button" id="btn-cerrar-modal" class="btn-close-modal" aria-label="Close">&times;</button>
        <h2>Editar Oferta Laboral</h2>

        <div id="modal-alert-exito" class="alert alert-success" style="color: green; margin-bottom: 15px; display: none;"></div>
        <div id="modal-alert-error" class="alert alert-danger" style="color: red; margin-bottom: 15px; display: none;"></div>

        <form id="form-editar-oferta">
          <div class="form-group-custom">
            <label for="edit-titulo">Título de la oferta</label>
            <input type="text" id="edit-titulo" required />
          </div>

          <div class="form-group-custom">
            <label for="edit-descripcion">Descripción</label>
            <textarea id="edit-descripcion" rows="4" required></textarea>
          </div>

          <div class="form-group-custom">
            <label for="edit-requisitos">Requisitos</label>
            <textarea id="edit-requisitos" rows="3" required></textarea>
          </div>

          <div class="form-row-custom">
            <div class="form-group-custom input-salario">
              <label for="edit-salario">Salario</label>
              <input type="number" id="edit-salario" />
            </div>

            <div class="form-group-custom input-modalidad">
              <label>Modalidad</label>
              <div class="radio-group-custom">
                <label class="radio-option">
                  <input type="radio" name="edit-modalidad" value="Virtual" />
                  <span>Virtual</span>
                </label>
                <label class="radio-option">
                  <input type="radio" name="edit-modalidad" value="Presencial" />
                  <span>Presencial</span>
                </label>
                <label class="radio-option">
                  <input type="radio" name="edit-modalidad" value="Hibrido" />
                  <span>Híbrido</span>
                </label>
              </div>
            </div>
          </div>

          <div class="modal-actions">
            <button type="button" id="btn-cancelar-modal" class="btn-cancelar-oferta">Cancelar</button>
            <button type="submit" class="btn-publicar-oferta">Guardar Cambios</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // =====================================================================
  // CONEXIÓN (empresa.e): Gestión de ofertas con el backend (rutas con la sesión de la empresa)
  //   GET   /api/empresa/ofertas               mis ofertas (tabla + paginación)
  //   POST  /api/empresa/ofertas               "Publicar Oferta"
  //   PUT   /api/empresa/ofertas/:id           ventana "Editar Oferta Laboral"
  //   PATCH /api/empresa/ofertas/:id/estado    cerrar / volver a abrir
  //   GET   /api/empresa/postulaciones         tabla "Postulantes" de la oferta elegida
  // Aceptar / Rechazar postulantes lo maneja VentanasEmpresa.astro (con el id de la fila).
  // =====================================================================
  const BASE = (window as any).PSYNEX_API ?? "http://localhost:8001";
  const API = `${BASE}/api`;

  type Oferta = { id: string; titulo: string; descripcion: string; requisitos: string; salario: number | null; modalidad: string; estado: string; fecha: string; postulaciones: number };
  type Postulacion = { id: string; estado: string; fecha: string; oferta: { id?: string; titulo: string }; psicologo: { nombre: string; perfilId: string | null; tieneFoto: boolean; fotoVersion: string } };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const escapar = (t: string) => String(t ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string);
  const iniciales = (n: string) => n.split(" ").filter(Boolean).slice(0, 2).map((p) => p[0]).join("").toUpperCase();
  const fechaCorta = (f: string) => {
    const d = new Date(f);
    return Number.isNaN(d.getTime()) ? "" : d.toLocaleDateString("es-CO", { day: "2-digit", month: "2-digit", year: "numeric" });
  };
  const textoModalidad = (m: string) => (m === "Hibrido" ? "Híbrido" : m);

  let ofertas: Oferta[] = [];
  let postulaciones: Postulacion[] = [];
  let pagina = 1;
  const POR_PAGINA = 5;
  let ofertaPostulantes = "";

  function alerta(id: string, texto: string) {
    const el = $(id);
    if (!el) return;
    el.textContent = texto;
    el.style.display = texto ? "block" : "none";
  }

  async function pedir(metodo: string, ruta: string, cuerpo?: unknown) {
    const res = await fetch(`${API}${ruta}`, {
      method: metodo,
      credentials: "include",
      headers: cuerpo ? { "Content-Type": "application/json" } : {},
      body: cuerpo ? JSON.stringify(cuerpo) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || data.ok === false) {
      throw new Error(Array.isArray(data.error) ? data.error.join(". ") : (data.error || "Ocurrió un error, intenta de nuevo"));
    }
    return data;
  }

  // ---------- Tabla "Mis ofertas publicadas" ----------
  function pintarOfertas() {
    const tbody = $("tabla-ofertas-body");
    if (!tbody) return;
    if (ofertas.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align: center;">Todavía no has publicado ofertas.</td></tr>`;
      $("pagination-container")!.style.display = "none";
      return;
    }
    const total = Math.max(1, Math.ceil(ofertas.length / POR_PAGINA));
    pagina = Math.min(Math.max(1, pagina), total);
    const visibles = ofertas.slice((pagina - 1) * POR_PAGINA, pagina * POR_PAGINA);
    tbody.innerHTML = visibles.map((o) => `
      <tr>
        <td class="font-semibold">${escapar(o.titulo)}</td>
        <td>${escapar(textoModalidad(o.modalidad))}</td>
        <td><span class="badge ${o.estado === "Activa" ? "status-activa" : ""}" style="${o.estado === "Activa" ? "background:var(--success-bg);color:var(--success-fg)" : "background:var(--bg);color:var(--text-muted)"}">${escapar(o.estado)}</span></td>
        <td>
          <button type="button" class="btn-actions" data-postulantes="${o.id}" title="Ver postulantes">
            ${o.postulaciones} <i class="bi bi-people"></i>
          </button>
        </td>
        <td class="text-center">
          <div class="action-buttons-container">
            <button type="button" class="btn-actions" data-editar="${o.id}" title="Editar oferta"><i class="bi bi-pencil-square"></i></button>
            <button type="button" class="btn-actions" data-estado-oferta="${o.id}" title="${o.estado === "Activa" ? "Cerrar oferta" : "Volver a publicar"}">
              <i class="bi ${o.estado === "Activa" ? "bi-x-circle" : "bi-arrow-counterclockwise"}"></i>
            </button>
          </div>
        </td>
      </tr>`).join("");

    const pag = $("pagination-container");
    if (pag) pag.style.display = total > 1 ? "flex" : "none";
    const nums = $("page-numbers");
    if (nums) {
      nums.innerHTML = Array.from({ length: total }, (_, i) =>
        `<button type="button" class="page-num ${i + 1 === pagina ? "active" : ""}" data-pagina="${i + 1}">${i + 1}</button>`).join("");
    }
    ($("btn-page-prev") as HTMLButtonElement | null)!.disabled = pagina === 1;
    ($("btn-page-next") as HTMLButtonElement | null)!.disabled = pagina === total;
  }

  async function cargarOfertas() {
    try {
      const data = await pedir("GET", "/empresa/ofertas");
      ofertas = data.ofertas ?? [];
    } catch (e) {
      const tbody = $("tabla-ofertas-body");
      if (tbody) tbody.innerHTML = `<tr><td colspan="5" style="text-align: center;">${escapar((e as Error).message)}</td></tr>`;
      return;
    }
    pintarOfertas();
  }

  // ---------- Tabla "Postulantes" de una oferta ----------
  function pintarPostulantes() {
    const tbody = $("tabla-postulantes-body");
    const titulo = $("titulo-postulantes");
    const oferta = ofertas.find((o) => o.id === ofertaPostulantes);
    if (titulo) titulo.textContent = oferta ? `Postulantes - ${oferta.titulo}` : "Postulantes";
    if (!tbody) return;
    const lista = postulaciones.filter((p) => !oferta || p.oferta.id === oferta.id);
    if (lista.length === 0) {
      tbody.innerHTML = `<tr><td colspan="3" style="text-align: center;">${oferta ? "Esta oferta todavía no tiene postulantes." : "Todavía no tienes postulantes."}</td></tr>`;
      return;
    }
    tbody.innerHTML = lista.map((p) => {
      const foto = p.psicologo.perfilId && p.psicologo.tieneFoto
        ? `<img src="${API}/explorar/psicologos/${p.psicologo.perfilId}/foto?v=${p.psicologo.fotoVersion}" alt="${escapar(p.psicologo.nombre)}" />`
        : `<div style="width:36px;height:36px;flex-shrink:0;border-radius:50%;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary);font-weight:700;font-size:12px">${escapar(iniciales(p.psicologo.nombre))}</div>`;
      const decidido = p.estado === "Aceptado" || p.estado === "Rechazado";
      return `
        <tr data-postulacion="${p.id}">
          <td>
            <div class="user-profile-cell">
              ${foto}
              <span>${escapar(p.psicologo.nombre)}</span>
            </div>
          </td>
          <td>${fechaCorta(p.fecha)}</td>
          <td>
            <div class="action-buttons-group">
              ${decidido
                ? `<span class="ve-estado ${p.estado === "Aceptado" ? "ok" : "mal"}">${escapar(p.estado)}</span>`
                : `<button class="btn-table btn-accept">Aceptar</button><button class="btn-table btn-reject">Rechazar</button>`}
            </div>
          </td>
        </tr>`;
    }).join("");
  }

  async function cargarPostulaciones() {
    try {
      const data = await pedir("GET", "/empresa/postulaciones");
      postulaciones = data.postulaciones ?? [];
    } catch {
      postulaciones = [];
    }
    // Por defecto: la oferta más reciente que tenga postulantes
    if (!ofertaPostulantes) ofertaPostulantes = ofertas.find((o) => o.postulaciones > 0)?.id ?? ofertas[0]?.id ?? "";
    pintarPostulantes();
  }

  // ---------- Publicar oferta ----------
  const leerModalidad = (nombre: string) =>
    (document.querySelector<HTMLInputElement>(`input[name="${nombre}"]:checked`)?.value) || "Virtual";

  $("form-crear-oferta")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    alerta("alert-exito", "");
    alerta("alert-error", "");
    const form = e.currentTarget as HTMLFormElement;
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (boton) boton.disabled = true;
    try {
      await pedir("POST", "/empresa/ofertas", {
        titulo: ($("titulo") as HTMLInputElement).value,
        descripcion: ($("descripcion") as HTMLTextAreaElement).value,
        requisitos: ($("requisitos") as HTMLTextAreaElement).value,
        salario: ($("salario") as HTMLInputElement).value,
        modalidad: leerModalidad("modalidad"),
      });
      form.reset();
      alerta("alert-exito", "¡Oferta publicada! Ya la pueden ver los psicólogos.");
      pagina = 1;
      await cargarOfertas();
    } catch (err) {
      alerta("alert-error", (err as Error).message);
    } finally {
      if (boton) boton.disabled = false;
    }
  });

  // ---------- Editar oferta (ventana) ----------
  let editando = "";
  const modal = $("modal-editar");
  const cerrarModal = () => { if (modal) modal.style.display = "none"; };
  $("btn-cerrar-modal")?.addEventListener("click", cerrarModal);
  $("btn-cancelar-modal")?.addEventListener("click", cerrarModal);

  function abrirEditar(id: string) {
    const o = ofertas.find((x) => x.id === id);
    if (!o || !modal) return;
    editando = id;
    ($("edit-titulo") as HTMLInputElement).value = o.titulo;
    ($("edit-descripcion") as HTMLTextAreaElement).value = o.descripcion;
    ($("edit-requisitos") as HTMLTextAreaElement).value = o.requisitos;
    ($("edit-salario") as HTMLInputElement).value = o.salario === null ? "" : String(o.salario);
    document.querySelectorAll<HTMLInputElement>('input[name="edit-modalidad"]').forEach((r) => (r.checked = r.value === o.modalidad));
    alerta("modal-alert-exito", "");
    alerta("modal-alert-error", "");
    modal.style.display = "flex";
  }

  $("form-editar-oferta")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    alerta("modal-alert-error", "");
    try {
      await pedir("PUT", `/empresa/ofertas/${editando}`, {
        titulo: ($("edit-titulo") as HTMLInputElement).value,
        descripcion: ($("edit-descripcion") as HTMLTextAreaElement).value,
        requisitos: ($("edit-requisitos") as HTMLTextAreaElement).value,
        salario: ($("edit-salario") as HTMLInputElement).value,
        modalidad: leerModalidad("edit-modalidad"),
      });
      alerta("modal-alert-exito", "Cambios guardados.");
      await cargarOfertas();
      pintarPostulantes();
      setTimeout(cerrarModal, 700);
    } catch (err) {
      alerta("modal-alert-error", (err as Error).message);
    }
  });

  // ---------- Botones de la tabla y paginación ----------
  document.addEventListener("click", async (e) => {
    const el = e.target as HTMLElement;
    const editar = el.closest<HTMLElement>("[data-editar]");
    if (editar) return abrirEditar(editar.dataset.editar || "");

    const cambiar = el.closest<HTMLElement>("[data-estado-oferta]");
    if (cambiar) {
      const o = ofertas.find((x) => x.id === cambiar.dataset.estadoOferta);
      if (!o) return;
      const nuevo = o.estado === "Activa" ? "Cerrada" : "Activa";
      if (nuevo === "Cerrada" && !confirm(`¿Cerrar la oferta "${o.titulo}"? Ya no recibirá postulaciones.`)) return;
      try {
        await pedir("PATCH", `/empresa/ofertas/${o.id}/estado`, { estado: nuevo });
        await cargarOfertas();
      } catch (err) {
        alerta("alert-error", (err as Error).message);
      }
      return;
    }

    const ver = el.closest<HTMLElement>("[data-postulantes]");
    if (ver) {
      ofertaPostulantes = ver.dataset.postulantes || "";
      pintarPostulantes();
      $("titulo-postulantes")?.scrollIntoView({ behavior: "smooth", block: "start" });
      return;
    }

    const num = el.closest<HTMLElement>("[data-pagina]");
    if (num) {
      pagina = Number(num.dataset.pagina);
      pintarOfertas();
    }
  });
  $("btn-page-prev")?.addEventListener("click", () => { pagina--; pintarOfertas(); });
  $("btn-page-next")?.addEventListener("click", () => { pagina++; pintarOfertas(); });

  // Cuando VentanasEmpresa acepta o rechaza a alguien, se actualiza la lista
  window.addEventListener("empresa:postulacion", (ev) => {
    const d = (ev as CustomEvent).detail as { id: string; estado: string };
    const p = postulaciones.find((x) => x.id === d.id);
    if (p) p.estado = d.estado;
  });

  (async () => {
    await cargarOfertas();
    await cargarPostulaciones();
  })();
</script>
