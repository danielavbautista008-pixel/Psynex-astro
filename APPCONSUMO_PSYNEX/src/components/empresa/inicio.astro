---
import MenuE  from "./menuE.astro";
import "./inicio.css"

// cambio: el saludo sale de una vez con el nombre de la empresa que inició sesión
// (antes decía "Nombre Empresa" hasta que cargaba el script). Se quitó un console.log de prueba.
const nombreEmpresa = Astro.locals.usuario?.NombreCompleto ?? "";
---

<div class="landing-container">
    <MenuE/>
<main class="Bienvenida-Em">
    <!-- Encabezado reactivo dinámico -->
    <header class="dashboard-header">
      <h1 id="titulo-bienvenida">{nombreEmpresa ? `¡Bienvenida, ${nombreEmpresa}!` : "¡Bienvenida!"}</h1>
      <p>Aquí tienes un resumen de tu actividad.</p>
    </header>

    <!-- Grid de Métricas -->
    <section class="metrics-grid">
      <div class="metric-card">
        <div class="metric-icon-circle">
          <i class="bi bi-briefcase-fill"></i>
        </div>
        <div class="ofertas">
          <!-- CONEXIÓN (empresa.e): este número lo llena el script con GET /api/empresa/resumen -->
          <span class="metric-number" id="cant-ofertas">--</span>
          <span class="metric-label">Ofertas activas</span>
          <a href="/Empresa/Ofertas" class="metric-link">Ver ofertas &rarr;</a>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon-circle">
          <i class="bi bi-people-fill"></i>
        </div>
        <div class="ofertas">
          <!-- CONEXIÓN (empresa.e): antes decía 48 fijo; ahora lo llena el script -->
          <span class="metric-number" id="cant-postulaciones">--</span>
          <span class="metric-label">Postulaciones recibidas</span>
          <a href="/Empresa/Postulaciones" class="metric-link">Ver postulaciones &rarr;</a>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon-circle">
          <i class="bi bi-star-fill"></i>
        </div>
        <div class="ofertas">
          <!-- CONEXIÓN (empresa.e): antes decía 7 fijo; ahora lo llena el script -->
          <span class="metric-number" id="cant-favoritos">--</span>
          <span class="metric-label">Psicólogos favoritos</span>
          <a href="/Empresa/Favoritos" class="metric-link">Ver favoritos &rarr;</a>
        </div>
      </div>
    </section>

    <!-- Grid de Acciones Rápidas -->
    <section class="actions-grid">
      <div class="action-card">
        <div class="action-icon-bg">
          <i class="bi bi-search"></i>
        </div>
        <div class="action-details">
          <h3>Buscar Psicólogos</h3>
          <p>Encuentra profesionales verificados para tu empresa.</p>
        </div>
        <a href="/Empresa/BuscarPs" class="action-btn-circle">
          <i class="bi bi-arrow-right-short"></i>
        </a>
      </div>

      <div class="action-card">
        <div class="action-icon-bg">
          <i class="bi bi-plus-lg"></i>
        </div>
        <div class="action-details">
          <h3>Publicar Oferta</h3>
          <p>Publica vacantes y recibe postulaciones.</p>
        </div>
        <a href="/Empresa/Ofertas" class="action-btn-circle">
          <i class="bi bi-arrow-right-short"></i>
        </a>
      </div>
    </section>

    <!-- Tabla de Postulaciones Recientes -->
    <section class="table-card-container">
      <h2>Últimas postulaciones recibidas</h2>

      <!-- CONEXIÓN (empresa.e): las filas de ejemplo se reemplazan con las últimas 5
           postulaciones reales (GET /api/empresa/resumen) -->
      <div class="responsive-table-holder">
        <table class="custom-table">
          <thead>
            <tr>
              <th>Psicólogo</th>
              <th>Oferta</th>
              <th>Fecha</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <div class="table-user">
                  <img src="https://via.placeholder.com/40" alt="Ana Martínez" />
                  <span>Ana Martínez</span>
                </div>
              </td>
              <td>Psicólogo Clínico</td>
              <td>10/05/2025</td>
              <td>
                <button class="status-badge pending" data-estado="pending">Pendiente</button>
              </td>
            </tr>
            <tr>
              <td>
                <div class="table-user">
                  <img src="https://via.placeholder.com/40" alt="Juan Gómez" />
                  <span>Juan Gómez</span>
                </div>
              </td>
              <td>Psicólogo Organizacional</td>
              <td>09/05/2025</td>
              <td>
                <button class="status-badge reviewed" data-estado="reviewed">Revisado</button>
              </td>
            </tr>
            <tr>
              <td>
                <div class="table-user">
                  <img src="https://via.placeholder.com/40" alt="María López" />
                  <span>María López</span>
                </div>
              </td>
              <td>Psicólogo Educativo</td>
              <td>08/05/2025</td>
              <td>
                <button class="status-badge pending" data-estado="pending">Pendiente</button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="table-action-footer">
        <a href="/Empresa/Postulaciones" class="view-more-btn">Ver todas las postulaciones &rarr;</a>
      </div>
    </section>
  </main>
</div>


<!-- Script para consumo de Backend Deno.js y manejo del DOM -->
<script>
  // CONEXIÓN (empresa.e): los datos salen de GET /api/empresa/resumen con la sesión de la empresa
  // (antes se usaba un usuario guardado en localStorage y rutas que no existían en Deno).
  // Se mantiene la idea original: el script llena las tarjetas y la tabla.
  const BASE = (window as any).PSYNEX_API ?? "http://localhost:8001";
  const API_URL = `${BASE}/api`;

  type Ultima = { id: string; estado: string; fecha: string; oferta: string; nombre: string; perfilId: string | null; tieneFoto: boolean; fotoVersion: string };

  const escapar = (t: string) => t.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string);
  const iniciales = (n: string) => n.split(" ").filter(Boolean).slice(0, 2).map((p) => p[0]).join("").toUpperCase();
  const fechaCorta = (f: string) => (f ? `${f.slice(8, 10)}/${f.slice(5, 7)}/${f.slice(0, 4)}` : "N/A");

  document.addEventListener("DOMContentLoaded", async () => {
    const cantOfertasEl = document.getElementById("cant-ofertas");
    const cantPostEl = document.getElementById("cant-postulaciones");
    const cantFavEl = document.getElementById("cant-favoritos");
    const tbody = document.querySelector(".custom-table tbody");

    try {
      const res = await fetch(`${API_URL}/empresa/resumen`, { credentials: "include" });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || "No se pudo cargar el resumen");

      if (cantOfertasEl) cantOfertasEl.textContent = String(data.ofertasActivas ?? 0);
      if (cantPostEl) cantPostEl.textContent = String(data.postulaciones ?? 0);
      if (cantFavEl) cantFavEl.textContent = String(data.favoritos ?? 0);

      const lista: Ultima[] = data.ultimas ?? [];
      if (tbody) {
        tbody.innerHTML = ""; // Limpiar filas estáticas de ejemplo
        if (lista.length === 0) {
          tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:18px">Todavía no has recibido postulaciones.</td></tr>`;
        }
        lista.forEach((post) => {
          const aceptado = post.estado === "Aceptado";
          const foto = post.perfilId && post.tieneFoto
            ? `<img src="${API_URL}/explorar/psicologos/${post.perfilId}/foto?v=${post.fotoVersion}" alt="${escapar(post.nombre)}" />`
            : `<div class="table-user-ini" style="width:40px;height:40px;flex-shrink:0;border-radius:50%;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary);font-weight:700;font-size:13px">${escapar(iniciales(post.nombre))}</div>`;
          tbody.insertAdjacentHTML("beforeend", `
            <tr>
              <td>
                <div class="table-user">
                  ${foto}
                  <span>${escapar(post.nombre)}</span>
                </div>
              </td>
              <td>${escapar(post.oferta || "Oferta laboral")}</td>
              <td>${fechaCorta(post.fecha)}</td>
              <td>
                <button class="status-badge ${aceptado ? "reviewed" : "pending"}" data-id="${post.id}" data-estado="${escapar(post.estado)}" title="Tocar para cambiar el estado">
                  ${escapar(post.estado)}
                </button>
              </td>
            </tr>`);
        });
        activarBotonesEstado();
      }
    } catch (err) {
      console.error("Error cargando datos del dashboard:", err);
      if (cantOfertasEl) cantOfertasEl.textContent = "0";
      if (cantPostEl) cantPostEl.textContent = "0";
      if (cantFavEl) cantFavEl.textContent = "0";
      if (tbody) tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:18px">No se pudo cargar la información. Revisa que el servidor esté encendido.</td></tr>`;
    }
  });

  // Cambia el estado al tocar la etiqueta (Pendiente <-> Aceptado), como en el diseño original.
  // CONEXIÓN (empresa.e): se guarda con PATCH /api/empresa/postulaciones/:id/estado
  function activarBotonesEstado() {
    document.querySelectorAll<HTMLButtonElement>(".status-badge[data-id]").forEach((boton) => {
      boton.addEventListener("click", async () => {
        const postulacionId = boton.dataset.id;
        const nuevoEstado = boton.dataset.estado === "Aceptado" ? "Pendiente" : "Aceptado";
        boton.disabled = true;
        try {
          const response = await fetch(`${API_URL}/empresa/postulaciones/${postulacionId}/estado`, {
            method: "PATCH",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ estado: nuevoEstado }),
          });
          if (response.ok) {
            boton.dataset.estado = nuevoEstado;
            boton.classList.toggle("reviewed", nuevoEstado === "Aceptado");
            boton.classList.toggle("pending", nuevoEstado !== "Aceptado");
            boton.textContent = nuevoEstado;
          } else {
            console.error("El servidor no pudo actualizar el estado");
          }
        } catch (error) {
          console.error("Error de red al actualizar la postulación:", error);
        } finally {
          boton.disabled = false;
        }
      });
    });
  }
</script>

<!-- =====================================================================
     CÓDIGO ORIGINAL (amiga) — se deja tal cual, solo comentado, para no borrar su trabajo.
     Usaba el usuario guardado en localStorage ("sesionPrueba") y las rutas /api/perfilempresa, /api/ofertas y /api/postulaciones, que no existen en Deno.
     La versión activa (arriba) es la CONEXIÓN (empresa.e).
     =====================================================================
<script>
  const API_URL = "http://localhost:8001/api";

  const itemGuardado = localStorage.getItem("sesionPrueba");
  let usuario = null;

  if (itemGuardado !== null) {
    try {
      usuario = JSON.parse(itemGuardado);
    } catch (e) {
      console.error("Error al parsear el localStorage:", e);
    }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    console.log("DOM cargado, iniciando fetch de datos...");
    const titulo = document.getElementById("titulo-bienvenida");
    const cantOfertasEl = document.getElementById("cant-ofertas");
    const tbody = document.querySelector(".custom-table tbody");

    if (!usuario || !usuario.usuario || !usuario.usuario.UsuarioId) {
      if (titulo) titulo.textContent = "No se detectó una sesión activa.";
      return;
    }

    try {
      // 1. Traer perfil de la empresa desde el servidor Deno
      const resEmpresa = await fetch(`${API_URL}/perfilempresa/usuario/${usuario.usuario.UsuarioId}`);
      if (!resEmpresa.ok) throw new Error("No se pudo obtener el perfil de la empresa");
      
      const empresa = await resEmpresa.json();
      console.log("Datos de la empresa obtenidos:", empresa);
      
      if (empresa && empresa.data && empresa.data.NombreEmpresa) {
        if (titulo) titulo.textContent = `¡Bienvenida, ${empresa.data.NombreEmpresa}!`;
      }

      const perfilId = empresa.data.PerfileId || empresa.data.UsuarioId;

      if (perfilId) {
        // 2. Traer conteo de ofertas activas
        const resOfertas = await fetch(`${API_URL}/ofertas/empresa/${perfilId}/contar`);
        if (resOfertas.ok) {
          const data = await resOfertas.json();
          if (cantOfertasEl) cantOfertasEl.textContent = data.total ?? data;
        }

        // 3. Traer las postulaciones recibidas por la empresa
        const resPostulaciones = await fetch(`${API_URL}/postulaciones/empresa/${perfilId}`);
        if (resPostulaciones.ok) {
          const jsonPostulaciones = await resPostulaciones.json();
          const listaPostulaciones = jsonPostulaciones.data || [];

          if (tbody && listaPostulaciones.length > 0) {
            tbody.innerHTML = ""; // Limpiar filas estáticas de ejemplo

            listaPostulaciones.forEach((post: any) => {
              const fechaFormateada = post.FechadePostulacion 
                ? new Date(post.FechadePostulacion).toLocaleDateString() 
                : "N/A";

              // Mapeo de estados según tu base de datos ("Pendiente", "Aceptado", "Rechazado")
              const esAceptado = post.Estado === "Aceptado";
              const estadoClase = esAceptado ? "reviewed" : "pending";
              const estadoTexto = post.Estado || "Pendiente";

              const fila = `
                <tr>
                  <td>
                    <div class="table-user">
                      <img src="https://via.placeholder.com/40" alt="${post.nombreCompleto || 'Candidato'}" />
                      <span>${post.nombreCompleto || 'Usuario Anónimo'}</span>
                    </div>
                  </td>
                  <td>${post.tituloOferta || 'Oferta laboral'}</td>
                  <td>${fechaFormateada}</td>
                  <td>
                    <button class="status-badge ${estadoClase}" data-id="${post.PostulacionId}" data-estado="${post.Estado}">
                      ${estadoTexto}
                    </button>
                  </td>
                </tr>
              `;
              tbody.innerHTML += fila;
            });

            // 4. Activar eventos en los botones de estado para actualizar en el Backend (Deno)
            activarBotonesEstado();
          }
        }
      }
    } catch (err) {
      console.error("Error cargando datos del dashboard:", err);
      if (titulo) titulo.textContent = "Error al cargar la información de la empresa.";
      if (cantOfertasEl) cantOfertasEl.textContent = "0";
    }
  });

  // Función para manejar el cambio de estado y enviarlo por PUT al backend
  function activarBotonesEstado() {
    const botonesEstado = document.querySelectorAll(".status-badge");
    
    botonesEstado.forEach((boton) => {
      boton.addEventListener("click", async () => {
        const postulacionId = boton.getAttribute("data-id");
        const estadoActual = boton.getAttribute("data-estado");
        
        // Alternar estado de ejemplo (Pendiente <-> Aceptado)
        const nuevoEstado = estadoActual === "Pendiente" ? "Aceptado" : "Pendiente";

        try {
          // Petición PUT al backend en Deno
          const response = await fetch(`${API_URL}/postulaciones/${postulacionId}`, {
            method: "PUT",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ Estado: nuevoEstado }),
          });

          if (response.ok) {
            // Actualizar interfaz visual si el backend responde con éxito
            boton.setAttribute("data-estado", nuevoEstado);
            if (nuevoEstado === "Aceptado") {
              boton.classList.remove("pending");
              boton.classList.add("reviewed");
              boton.textContent = "Aceptado";
            } else {
              boton.classList.remove("reviewed");
              boton.classList.add("pending");
              boton.textContent = "Pendiente";
            }
            console.log(`Estado de la postulación ${postulacionId} actualizado a ${nuevoEstado}`);
          } else {
            console.error("El servidor no pudo actualizar el estado");
          }
        } catch (error) {
          console.error("Error de red al actualizar la postulación:", error);
        }
      });
    });
  }
</script>
-->
