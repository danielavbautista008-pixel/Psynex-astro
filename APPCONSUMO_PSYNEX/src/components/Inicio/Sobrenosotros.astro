---

import Navbar from "../Menu/Navbar.astro";
import "./sobrenosotros.css";

// Las 8 fotos del hero, igual que tu List<string> Imagenes original.
const imagenes = [
  "/Imagenes/imagenc.1.jpeg",
  "/Imagenes/imagenc.2.jpeg",
  "/Imagenes/imagenc.3.jpeg",
  "/Imagenes/imagenc.4.jpeg",
  "/Imagenes/imagenc.5.jpeg",
  "/Imagenes/imagenc.6.jpeg",
  "/Imagenes/imagenc.7.jpeg",
  "/Imagenes/imagenc.8.jpeg",
];

const valores = [
  { icono: "bi-heart-fill", titulo: "Empatía", texto: "Escuchamos y comprendemos las necesidades de cada persona." },
  { icono: "bi-shield-check", titulo: "Confianza", texto: "Protegemos la privacidad y seguridad de nuestros usuarios." },
  { icono: "bi-lightbulb", titulo: "Innovación", texto: "Utilizamos tecnología moderna para mejorar la experiencia." },
  { icono: "bi-people-fill", titulo: "Compromiso", texto: "Trabajamos para generar impacto positivo en la comunidad." },
];

const redes = [
  { icono: "bi-instagram", url: "https://www.instagram.com/erika2622_?igsh=MXFtY3ZtNG5hZWJhMA==", label: "Instagram" },
  { icono: "bi-whatsapp", url: "https://wa.me/573202259605", label: "WhatsApp" },
  { icono: "bi-facebook", url: "https://www.facebook.com/share/1EVCvvKbnw/", label: "Facebook" },
  { icono: "bi-envelope", url: "mailto:Psynex.2025.ye@gmail.com", label: "Correo" },
];
---

<Navbar />

<!-- HERO con carrusel de 8 fotos (Bootstrap) -->
<section class="sn-hero">

  <div
    id="carruselNosotros"
    class="carousel slide carousel-fade sn-hero-carousel"
    data-bs-ride="carousel"
    data-bs-interval="4000"
  >
    <div class="carousel-inner h-100">
      {imagenes.map((src, i) => (
        <div class:list={["carousel-item", "h-100", { active: i === 0 }]}>
          <img src={src} alt={`Psynex - imagen ${i + 1}`} />
        </div>
      ))}
    </div>

    <div class="sn-hero-overlay"></div>

    <div class="sn-hero-content">
      <h1>Sobre Nosotros</h1>
      <p>
        Promovemos el bienestar emocional y psicológico mediante
        herramientas digitales accesibles.
      </p>
    </div>

    <!-- Flechas: usan el mismo data-bs-slide de Bootstrap que antes
         manejabas a mano con Anterior()/Siguiente() en C#. -->
    <button class="sn-hero-arrow sn-hero-arrow-prev" type="button" data-bs-target="#carruselNosotros" data-bs-slide="prev" aria-label="Anterior">
      <i class="bi bi-chevron-left"></i>
    </button>
    <button class="sn-hero-arrow sn-hero-arrow-next" type="button" data-bs-target="#carruselNosotros" data-bs-slide="next" aria-label="Siguiente">
      <i class="bi bi-chevron-right"></i>
    </button>

    <!-- Puntos: mismo estilo de "línea delgada" que ya usamos en login,
         para que todo el sitio se vea consistente. -->
    <div class="carousel-indicators sn-hero-dots">
      {imagenes.map((_, i) => (
        <button
          type="button"
          data-bs-target="#carruselNosotros"
          data-bs-slide-to={i}
          class:list={[{ active: i === 0 }]}
          aria-current={i === 0 ? "true" : undefined}
          aria-label={`Ir a la imagen ${i + 1}`}
        />
      ))}
    </div>
  </div>
</section>

<div class="sn-container">

  <!-- MISIÓN Y VISIÓN -->
  <section class="sn-mision-vision">
    <div class="sn-info-card">
      <div class="sn-icon-circle">
        <i class="bi bi-bullseye"></i>
      </div>
      <div class="sn-card-content">
        <h2>Nuestra Misión</h2>
        <p>
          Brindar una plataforma innovadora y accesible que facilite el
          acompañamiento psicológico, promoviendo la salud mental, el
          bienestar emocional y el crecimiento personal.
        </p>
      </div>
    </div>

    <div class="sn-info-card">
      <div class="sn-icon-circle">
        <i class="bi bi-eye"></i>
      </div>
      <div class="sn-card-content">
        <h2>Nuestra Visión</h2>
        <p>
          Ser una plataforma líder en bienestar psicológico, reconocida
          por transformar vidas mediante el acceso a herramientas
          digitales confiables y profesionales.
        </p>
      </div>
    </div>
  </section>

  <!-- VALORES -->
  <section class="sn-valores">
    <div class="sn-section-title">
      <h2>Nuestros Valores</h2>
      <div class="sn-title-line"></div>
    </div>

    <div class="sn-valores-grid">
      {valores.map((v) => (
        <div class="sn-valor-card">
          <div class="sn-valor-icon">
            <i class={`bi ${v.icono}`}></i>
          </div>
          <h3>{v.titulo}</h3>
          <p>{v.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="sn-contacto">
    <div class="sn-section-title">
      <h2>Contáctanos</h2>
      <div class="sn-title-line"></div>
    </div>

    <div class="sn-contact-buttons">
      {redes.map((r) => (
        <a href={r.url} class="sn-contact-btn" target="_blank" rel="noopener noreferrer" aria-label={r.label}>
          <i class={`bi ${r.icono}`}></i>
        </a>
      ))}
    </div>
  </section>

</div>

<script>
  // Si el usuario tiene activado "reducir movimiento" (preferencia de
  // accesibilidad del sistema operativo), detenemos el avance
  // automático del carrusel — se queda quieto en la primera foto, pero
  // las flechas y los puntos siguen funcionando si el usuario SÍ quiere
  // cambiar de imagen manualmente.
  const prefiereMenosMovimiento = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (prefiereMenosMovimiento) {
    // Importamos la clase Carousel directo del paquete — el <script> de
    // BaseLayout importa el bundle completo de Bootstrap, pero como es
    // un import de módulo (no un <script> global tipo CDN), no queda
    // disponible como "window.bootstrap". Aquí sí lo traemos nosotros.
    // @ts-ignore - bootstrap no trae sus propias declaraciones de tipos
    // (.d.ts); el paquete funciona perfecto en JS, esto solo le avisa a
    // TypeScript que no se preocupe por eso.
    const { Carousel } = await import("bootstrap");
    const el = document.getElementById("carruselNosotros");
    if (el) {
      Carousel.getOrCreateInstance(el).pause();
    }
  }
</script>