---


export interface Props {
  logoSrc?: string;
  siteName?: string;
  salirHref?: string;
  salirLabel?: string;
  items?: { label: string; href: string; icono: string }[];
}

const {
  logoSrc = "/Imagenes/logo.png",
  siteName = "PSYNEX",
  salirHref = "/",
  salirLabel = "Volver al sitio",
  items = [
    { label: "Inicio", href: "/Administrador/inicio", icono: "bi-house" },
    { label: "Estadísticas", href: "/Administrador/estadisticas", icono: "bi-bar-chart" },
    { label: "Gestionar cuestionarios", href: "/Administrador/cuestionario", icono: "bi-clipboard-check" },
    { label: "Historial de citas", href: "/Administrador/citas", icono: "bi-calendar-week" },
    { label: "Usuarios", href: "/Administrador/usuarios", icono: "bi-people" },
    { label: "Finanzas", href: "/Administrador/finanzas", icono: "bi-cash-coin" },
    { label: "Verificar psicólogos", href: "/Administrador/verificarpsicologos", icono: "bi-patch-check" },
    { label: "Verificar empresas", href: "/Administrador/verificarempresas", icono: "bi-building-check" },
    { label: "Publicar planes", href: "/Administrador/publicarplanes", icono: "bi-box-seam" },
    { label: "Pagos de empresas", href: "/Administrador/pagosempresas", icono: "bi-buildings" },
    { label: "Pagos de pacientes", href: "/Administrador/pagospacientes", icono: "bi-wallet2" }, // cambio: nuevo (modo temporal de pagos)
    { label: "Reclamos", href: "/Administrador/reclamos", icono: "bi-chat-left-text" }, // cambio: nuevo (reclamos de psicólogos)
    { label: "Métodos de pago", href: "/Administrador/MetodosdePago", icono: "bi-credit-card" },
    { label: "Blog", href: "/Administrador/blog", icono: "bi-journal-text" },
  ],
} = Astro.props;

import "./MenuAdmin.css";

// Marca como activo el enlace de la vista actual, quitando la barra final
// para que "/admin/" y "/admin" cuenten como la misma ruta.
const ruta = Astro.url.pathname.replace(/\/$/, "") || "/admin";
---
<aside class="sidebar-vidrio">
  <!-- cambio: logo + campanita de avisos del administrador -->
  <div class="adm-top">
    <a href="/Administrador/inicio" class="marca"> <!-- cambio: /admin no existía -->
      <img src={logoSrc} alt={siteName} />
      <span>{siteName} <em> </em></span>
    </a>
    <button type="button" class="adm-campana" id="admCampana" aria-label="Avisos del administrador" aria-expanded="false" aria-controls="admPanel">
      <i class="bi bi-bell-fill adm-campana-icono" aria-hidden="true"></i>
      <span class="adm-campana-num" id="admCampanaNum" hidden>0</span>
    </button>
    <!-- cambio: botón de menú (☰) que solo se ve en celular y tableta -->
    <button type="button" class="adm-menu-btn" id="admMenuBtn" aria-label="Abrir menú" aria-expanded="false">
      <i class="bi bi-list"></i>
    </button>
  </div>

  <nav>
    {items.map((item) => (
      <a href={item.href} class:list={["item", { activo: ruta === item.href }]}>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <a href={salirHref} class="salir">
    <i class="bi bi-box-arrow-left"></i>
    <span>{salirLabel}</span>
  </a>
</aside>

<!-- cambio: panel de avisos del administrador (fuera del menú para que no se recorte) -->
<section class="adm-panel" id="admPanel" hidden aria-label="Avisos del administrador">
  <header class="adm-panel-top">
    <div>
      <strong>Avisos</strong>
      <small id="admResumen">Revisando…</small>
    </div>
    <button type="button" class="adm-panel-cerrar" id="admCerrar" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
  </header>

  <h4 class="adm-panel-sub">Tareas pendientes</h4>
  <div class="adm-tareas" id="admTareas"><p class="adm-vacio">Cargando…</p></div>

  <div class="adm-panel-sub adm-panel-sub-fila">
    <h4>Notificaciones</h4>
    <button type="button" class="adm-leer" id="admLeerTodas" hidden>Marcar todas como leídas</button>
  </div>
  <div class="adm-notifs" id="admNotifs"><p class="adm-vacio">Cargando…</p></div>
</section>

<style is:global>
  /* cambio: campanita del administrador (solo colores del tema) */
  .adm-top {
    position: relative;
  }

  .adm-campana {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .adm-campana:hover,
  .adm-campana.tiene {
    color: var(--primary);
    border-color: color-mix(in srgb, var(--primary) 40%, var(--border));
  }

  .adm-campana-icono {
    display: inline-block;
    font-size: 16px;
    transform-origin: 50% 2px;
  }

  .adm-campana.sonando .adm-campana-icono {
    animation: admCampanaMover 1.6s ease-in-out infinite;
  }

  .adm-campana-num {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    display: grid;
    place-items: center;
    border: 2px solid var(--surface);
    border-radius: 999px;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 9.5px;
    font-weight: 700;
    box-sizing: border-box;
  }

  .adm-campana-num[hidden] {
    display: none;
  }

  @keyframes admCampanaMover {
    0%, 100% { transform: rotate(0); }
    10% { transform: rotate(16deg); }
    20% { transform: rotate(-14deg); }
    30% { transform: rotate(10deg); }
    40% { transform: rotate(-6deg); }
    50% { transform: rotate(3deg); }
    60% { transform: rotate(0); }
  }

  .adm-panel {
    position: fixed;
    top: 16px;
    left: 284px;
    z-index: 200;
    width: min(360px, calc(100vw - 300px));
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
    font-family: var(--bs-body-font-family);
    animation: admPanelEntrar 0.2s ease;
  }

  .adm-panel[hidden] {
    display: none;
  }

  @keyframes admPanelEntrar {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  .adm-panel-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 12px;
  }

  .adm-panel-top strong {
    display: block;
    font-family: "Fraunces", Georgia, serif;
    font-size: 18px;
    font-weight: 500;
  }

  .adm-panel-top small {
    color: var(--text-muted);
    font-size: 12px;
  }

  .adm-panel-cerrar {
    border: 0;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .adm-panel-sub,
  .adm-panel-sub h4 {
    margin: 14px 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .adm-panel-sub-fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .adm-panel-sub-fila h4 {
    margin: 0;
  }

  .adm-leer {
    border: 0;
    background: transparent;
    color: var(--primary);
    font-size: 11.5px;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    cursor: pointer;
  }

  .adm-tareas,
  .adm-notifs {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .adm-tarea {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
    font-size: 13px;
    transition: background 0.2s ease;
  }

  .adm-tarea:hover {
    background: var(--primary-soft);
  }

  .adm-tarea i {
    color: var(--primary);
  }

  .adm-tarea span {
    flex: 1;
  }

  .adm-tarea b {
    min-width: 24px;
    height: 22px;
    padding: 0 7px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 11.5px;
  }

  .adm-notif {
    display: flex;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--text);
    text-align: left;
    font: inherit;
    cursor: pointer;
  }

  .adm-notif:hover {
    background: var(--bg);
  }

  .adm-notif.nueva {
    background: color-mix(in srgb, var(--primary) 8%, transparent);
  }

  .adm-notif i {
    color: var(--primary);
    margin-top: 2px;
  }

  .adm-notif div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12.5px;
  }

  .adm-notif small {
    color: var(--text-muted);
    font-size: 11px;
  }

  .adm-vacio {
    margin: 0;
    padding: 8px 2px;
    color: var(--text-muted);
    font-size: 12.5px;
  }

  @media (max-width: 900px) {
    .adm-panel {
      top: 76px;
      left: 12px;
      right: 12px;
      width: auto;
      max-height: calc(100vh - 90px);
    }
  }
</style>

<script>
  // cambio: campanita del administrador.
  //  - Tareas pendientes: GET /api/admin/pendientes (psicólogos y empresas por
  //    verificar, pagos por revisar).
  //  - Notificaciones: GET /api/notificaciones (ej.: "Nuevo pago por revisar").
  // Se mueve mientras haya algo nuevo que no se ha visto; al abrirla se queda
  // quieta hasta que llegue algo más.
  import { API_URL } from "../../lib/api";

  // cambio: abrir / cerrar el menú en celular y tableta
  const menuBtn = document.getElementById("admMenuBtn");
  const menuLateral = document.querySelector<HTMLElement>(".sidebar-vidrio");
  menuBtn?.addEventListener("click", () => {
    const abierto = !menuLateral?.classList.contains("abierto");
    menuLateral?.classList.toggle("abierto", abierto);
    menuBtn.setAttribute("aria-expanded", abierto ? "true" : "false");
    const i = menuBtn.querySelector("i");
    if (i) i.className = abierto ? "bi bi-x-lg" : "bi bi-list";
  });

  const boton = document.getElementById("admCampana");
  const num = document.getElementById("admCampanaNum");
  const panel = document.getElementById("admPanel");
  const resumen = document.getElementById("admResumen");
  const cajaTareas = document.getElementById("admTareas");
  const cajaNotifs = document.getElementById("admNotifs");
  const leerTodas = document.getElementById("admLeerTodas");
  const CLAVE = "admAvisosVistos";

  interface Tarea { clave: string; texto: string; total: number; ruta: string; icono: string }
  interface Notif { NotificacionId: string; Titulo: string; Mensaje: string; EstaLeida: number | string; FechaEnvio: string }

  let totalActual = 0;

  const destinoDe = (titulo: string) => {
    const t = titulo.toLowerCase();
    if (t.includes("reclamo")) return "/Administrador/reclamos";
    if (t.includes("comprobante")) return "/Administrador/pagosempresas";
    if (t.includes("pago")) return "/Administrador/pagospacientes";
    if (t.includes("empresa")) return "/Administrador/verificarempresas";
    if (t.includes("psicólogo") || t.includes("psicologo")) return "/Administrador/verificarpsicologos";
    return "";
  };

  const haceCuanto = (fecha: string) => {
    const min = Math.floor((Date.now() - new Date(fecha).getTime()) / 60000);
    if (min < 1) return "Ahora";
    if (min < 60) return `Hace ${min} min`;
    const h = Math.floor(min / 60);
    if (h < 24) return `Hace ${h} h`;
    const d = Math.floor(h / 24);
    return d === 1 ? "Ayer" : `Hace ${d} días`;
  };

  const leerVistos = () => {
    try { return Number(localStorage.getItem(CLAVE) || 0); } catch { return 0; }
  };
  const guardarVistos = (n: number) => {
    try { localStorage.setItem(CLAVE, String(n)); } catch { /* sin almacenamiento */ }
  };

  function pintarTareas(tareas: Tarea[]) {
    if (!cajaTareas) return;
    cajaTareas.replaceChildren();
    const conAlgo = tareas.filter((t) => t.total > 0);
    if (!conAlgo.length) {
      const p = document.createElement("p");
      p.className = "adm-vacio";
      p.textContent = "Todo al día. No tienes tareas pendientes.";
      cajaTareas.append(p);
      return;
    }
    conAlgo.forEach((t) => {
      const a = document.createElement("a");
      a.className = "adm-tarea";
      a.href = t.ruta;
      const i = document.createElement("i");
      i.className = `bi ${t.icono}`;
      const s = document.createElement("span");
      s.textContent = t.texto;
      const b = document.createElement("b");
      b.textContent = String(t.total);
      a.append(i, s, b);
      cajaTareas.append(a);
    });
  }

  function pintarNotifs(lista: Notif[]) {
    if (!cajaNotifs) return;
    cajaNotifs.replaceChildren();
    if (!lista.length) {
      const p = document.createElement("p");
      p.className = "adm-vacio";
      p.textContent = "No tienes notificaciones.";
      cajaNotifs.append(p);
      return;
    }
    lista.forEach((n) => {
      const item = document.createElement("button");
      item.type = "button";
      item.className = "adm-notif";
      const nueva = Number(n.EstaLeida) !== 1;
      if (nueva) item.classList.add("nueva");
      const i = document.createElement("i");
      i.className = `bi ${nueva ? "bi-bell-fill" : "bi-bell"}`;
      const d = document.createElement("div");
      const t = document.createElement("strong");
      t.textContent = n.Titulo || "Aviso";
      const m = document.createElement("span");
      m.textContent = n.Mensaje || "";
      const f = document.createElement("small");
      f.textContent = haceCuanto(n.FechaEnvio);
      d.append(t, m, f);
      item.append(i, d);
      item.addEventListener("click", async () => {
        if (nueva) {
          await fetch(`${API_URL}/api/notificaciones/${encodeURIComponent(n.NotificacionId)}/leida`, { method: "PATCH", credentials: "include" }).catch(() => null);
        }
        const url = destinoDe(n.Titulo || "");
        if (url && location.pathname !== url) location.href = url;
        else void cargar();
      });
      cajaNotifs.append(item);
    });
  }

  async function cargar() {
    let tareas: Tarea[] = [];
    let pendientes = 0;
    let notifs: Notif[] = [];
    let noLeidas = 0;
    try {
      const [r1, r2] = await Promise.all([
        fetch(`${API_URL}/api/admin/pendientes`, { credentials: "include" }),
        fetch(`${API_URL}/api/notificaciones?limite=10`, { credentials: "include" }),
      ]);
      if (r1.ok) {
        const d1 = await r1.json();
        tareas = d1.tareas ?? [];
        pendientes = Number(d1.total ?? 0);
      }
      if (r2.ok) {
        const d2 = await r2.json();
        notifs = d2.notificaciones ?? [];
        noLeidas = Number(d2.noLeidas ?? 0);
      }
    } catch {
      return; // sin conexión: se intenta en la próxima revisión
    }

    // cambio: el número de la campanita es solo de notificaciones SIN LEER,
    // así al "Marcar todas como leídas" desaparece. Las tareas pendientes
    // se siguen viendo dentro del panel con sus propios números.
    totalActual = pendientes + noLeidas; // para saber si llegó algo nuevo (movimiento)
    if (num) {
      num.hidden = noLeidas === 0;
      num.textContent = noLeidas > 9 ? "9+" : String(noLeidas);
    }
    boton?.classList.toggle("tiene", noLeidas > 0 || pendientes > 0);

    // Se mueve solo si hay más cosas que la última vez que se abrió
    let vistos = leerVistos();
    if (totalActual < vistos) {
      vistos = totalActual;
      guardarVistos(vistos);
    }
    if (!panel || panel.hidden) boton?.classList.toggle("sonando", totalActual > vistos);

    if (resumen) {
      resumen.textContent = pendientes === 0 && noLeidas === 0 ? "Todo al día"
        : `${pendientes} ${pendientes === 1 ? "tarea pendiente" : "tareas pendientes"}${noLeidas ? ` · ${noLeidas} ${noLeidas === 1 ? "notificación nueva" : "notificaciones nuevas"}` : ""}`;
    }
    if (leerTodas) leerTodas.hidden = noLeidas === 0;
    pintarTareas(tareas);
    pintarNotifs(notifs);
  }

  const cerrar = () => {
    if (!panel) return;
    panel.hidden = true;
    boton?.setAttribute("aria-expanded", "false");
  };

  boton?.addEventListener("click", (e) => {
    e.stopPropagation();
    if (!panel) return;
    const abrir = panel.hidden;
    panel.hidden = !abrir;
    boton.setAttribute("aria-expanded", String(abrir));
    if (abrir) {
      boton.classList.remove("sonando");
      guardarVistos(totalActual);
      void cargar();
    }
  });
  document.getElementById("admCerrar")?.addEventListener("click", cerrar);
  document.addEventListener("click", (e) => {
    if (panel && !panel.hidden && !panel.contains(e.target as Node) && e.target !== boton) cerrar();
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") cerrar(); });

  leerTodas?.addEventListener("click", async (e) => {
    e.stopPropagation();
    await fetch(`${API_URL}/api/notificaciones/leer-todas`, { method: "PATCH", credentials: "include" }).catch(() => null);
    // cambio: el número se quita de una vez, sin esperar la próxima revisión
    if (num) num.hidden = true;
    boton?.classList.remove("sonando");
    await cargar();
    guardarVistos(totalActual);
  });

  void cargar();
  setInterval(cargar, 30000);
</script>