---
// =====================================================================
// Sala de videollamada de Psynex (WebRTC)
//
// Pasos que ve la persona:
//   1. salaAviso   -> todavía no abre, ya terminó, cancelada...
//   2. salaPrevia  -> prueba su cámara y micrófono antes de entrar
//   3. salaLlamada -> la sesión
//   4. salaFin     -> salió de la sesión
//
// Citas individuales, de pareja o familiares (hasta 6 personas).
// El video va DIRECTO entre los navegadores: cada persona se conecta con
// cada una de las demás (en "malla"). Deno solo deja entrar a las personas
// de la cita y pasa los "datos de conexión" por el WebSocket del chat.
//
// Cómo se ve:
//   - 2 personas: el otro en grande y tú en un recuadro pequeño (como antes)
//   - 3 a 6 personas: mosaico con todos del mismo tamaño
//   - alguien comparte pantalla: la pantalla en grande y las caras al lado
// =====================================================================
import { API_URL } from "../../lib/api";
import "./Sala.css";

interface Props {
  sala: any;
  error: string;
}

const { sala, error } = Astro.props;

const ZONA = "America/Bogota";
const hora = (f: string) =>
  new Date(f).toLocaleTimeString("es-CO", { hour: "numeric", minute: "2-digit", timeZone: ZONA });
const dia = (f: string) => {
  const t = new Date(f).toLocaleDateString("es-CO", { weekday: "long", day: "numeric", month: "long", timeZone: ZONA });
  return t.charAt(0).toUpperCase() + t.slice(1);
};
const iniciales = (n: string) =>
  n.split(" ").filter(Boolean).slice(0, 2).map((p) => p[0]!.toUpperCase()).join("");
const primerNombre = (n: string) => String(n ?? "").split(" ")[0] || "Participante";

const soyPsicologo = sala?.yo?.rol === "Psicologo";
const otros: { id: string; nombre: string; rol: string; tieneFoto: boolean; principal: boolean }[] = sala?.otros ?? [];
const esGrupo = otros.length > 1;
const formato = String(sala?.formato ?? "Individual");

// Título de la barra: "Sesión con Ana" o "Sesión de pareja"
const tituloSesion = !esGrupo
  ? `Sesión con ${otros[0]?.nombre ?? ""}`
  : formato === "Pareja"
  ? "Sesión de pareja"
  : formato === "Familiar"
  ? "Sesión familiar"
  : "Sesión grupal";
const listaNombres = otros.map((o) => primerNombre(o.nombre)).join(", ");
const inicio = sala ? hora(sala.fechaHora) : "";
const fin = sala ? hora(new Date(new Date(sala.fechaHora).getTime() + sala.duracionMinutos * 60000).toISOString()) : "";
// cambio: el paciente vuelve a su panel (antes iba a la página pública)
const volverHref = soyPsicologo ? "/Psicologos/Citas" : "/Paciente/Inicio";

// Mensaje cuando todavía no se puede entrar
const AVISOS: Record<string, { titulo: string; texto: string }> = {
  temprano: {
    titulo: "La sala aún no está abierta",
    texto: sala ? `Abre a las ${hora(sala.abre)}, 10 minutos antes de la cita. Esta página se abrirá sola a esa hora.` : "",
  },
  terminada: { titulo: "Esta sesión ya terminó", texto: "La sala se cierra 30 minutos después de la hora de la cita." },
  completada: { titulo: "Esta sesión ya terminó", texto: "La cita quedó marcada como realizada." },
  cancelada: { titulo: "Esta cita fue cancelada", texto: "Si quieres reprogramarla, agenda una nueva cita." },
  pendiente: { titulo: "La cita aún no está confirmada", texto: "Cuando el psicólogo la confirme podrás entrar desde aquí." },
};
const aviso = error
  ? { titulo: "No pudimos abrir la sala", texto: error }
  : sala && !sala.puedeEntrar
  ? AVISOS[sala.motivo] ?? { titulo: "La sala no está disponible", texto: "" }
  : null;

// Íconos dibujados aquí mismo: se ven siempre, aunque no cargue ninguna fuente
const svg = (d: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const ICONOS = {
  mic: svg('<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>'),
  micOff: svg('<path d="M15 9.5V6a3 3 0 0 0-5.7-1.3M9 9v2a3 3 0 0 0 4.7 2.5M5 11a7 7 0 0 0 11.4 5.4M19 11a7 7 0 0 1-.6 2.8M12 18v3M3 3l18 18"/>'),
  cam: svg('<rect x="3" y="6" width="13" height="12" rx="2.5"/><path d="m16 10 5-3v10l-5-3"/>'),
  camOff: svg('<path d="M16 16v1.5a.5.5 0 0 1-.5.5H5.5A2.5 2.5 0 0 1 3 15.5v-7A2.5 2.5 0 0 1 5.5 6H7m4 0h2.5A2.5 2.5 0 0 1 16 8.5v2l5-3v10M3 3l18 18"/>'),
  pantalla: svg('<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4M9.5 10 12 7.5 14.5 10M12 7.5V13"/>'),
  notas: svg('<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h6M9 16h4"/>'),
  colgar: svg('<path d="M3.6 14.6c-.6-.6-.6-1.5 0-2.1C6 10.2 8.9 9 12 9s6 1.2 8.4 3.5c.6.6.6 1.5 0 2.1l-1.6 1.6c-.5.5-1.3.6-1.9.2l-1.8-1.2c-.4-.3-.7-.8-.6-1.4l.2-1.3a11 11 0 0 0-5.4 0l.2 1.3c.1.6-.2 1.1-.6 1.4l-1.8 1.2c-.6.4-1.4.3-1.9-.2z"/>'),
  escudo: svg('<path d="M12 3 5 6v5c0 4.4 3 8.3 7 9.5 4-1.2 7-5.1 7-9.5V6z"/><path d="m9.5 12 1.8 1.8 3.5-3.6"/>'),
  personas: svg('<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9" r="2.6"/><path d="M15.5 14.3A4.6 4.6 0 0 1 21 18.5"/>'),
};

const hoja = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.5 3.5C13.2 3.8 7.4 6.1 5 10.2c-1.8 3.1-.5 6.4 2.2 7.6 2.8 1.3 6.1-.1 7.9-2.8 2.1-3.1 2.6-7.1 5.4-11.5Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20c2.8-4.4 6.2-7.1 11.5-9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`;

// Datos para el script (el "<" se escapa para que nunca cierre la etiqueta)
const datosJson = JSON.stringify({ sala, api: API_URL, iconos: ICONOS }).replace(/</g, "\\u003c");
---

<div class="sala-pagina">

  <!-- BARRA SUPERIOR -->
  <header class="sala-barra">
    <a href={volverHref} class="sala-marca" aria-label="Volver a Psynex">
      <span class="sala-marca-hoja" set:html={hoja}></span>
      <span>Psynex</span>
    </a>

    {sala && (
      <div class="sala-quien">
        {esGrupo ? (
          <span class="sala-avatar grupo-icono" set:html={ICONOS.personas}></span>
        ) : (
          <span class="sala-avatar" id="barraAvatar">
            <span>{iniciales(otros[0]?.nombre ?? "")}</span>
          </span>
        )}
        <div>
          <strong>{tituloSesion}</strong>
          <small>
            {esGrupo ? `Con ${listaNombres} · ` : ""}{dia(sala.fechaHora)} · {inicio} a {fin}
          </small>
        </div>
      </div>
    )}

    <div class="sala-barra-derecha">
      <span class="sala-personas" id="salaPersonas" hidden title="Personas en la sala">
        <span class="ico" set:html={ICONOS.personas}></span>
        <span id="salaPersonasN">1</span>
      </span>
      <span class="sala-privada" title="El video va cifrado y directo entre los participantes; no se graba">
        <span class="ico" set:html={ICONOS.escudo}></span> Privada
      </span>
      <span class="sala-tiempo" id="salaTiempo" hidden>00:00</span>
    </div>
  </header>


  <!-- 1. AVISO: no se puede entrar -->
  {aviso && (
    <section class="sala-tarjeta" id="salaAviso" data-motivo={sala?.motivo ?? "error"} data-abre={sala?.abre ?? ""}>
      <div class="sala-icono" set:html={hoja}></div>
      <h1>{aviso.titulo}</h1>
      <p>{aviso.texto}</p>
      {sala?.motivo === "temprano" && (
        <p class="sala-cuenta">Faltan <strong id="cuentaRegresiva">--:--</strong></p>
      )}
      <a href={volverHref} class="sala-boton secundario">
        {soyPsicologo ? "Ir a mis citas" : "Volver a mi panel"}
      </a>
    </section>
  )}


  {sala?.puedeEntrar && (
    <>
      <!-- 2. ANTES DE ENTRAR -->
      <section class="sala-previa" id="salaPrevia">
        <div class="previa-video" id="previaVideoCaja">
          <video id="videoPrevia" autoplay playsinline muted></video>
          <div class="previa-sin-video" id="previaSinVideo">
            <span class="sala-avatar grande"><span>{iniciales(String(sala.yo.nombre))}</span></span>
            <small id="previaEstadoCamara">Activando tu cámara…</small>
          </div>
          <span class="previa-hablando"><span class="ondas" aria-hidden="true"><i></i><i></i><i></i></span> Te escuchamos</span>
          <div class="previa-controles">
            <button type="button" class="control" id="previaMic" aria-label="Silenciar micrófono" title="Micrófono">
              <Fragment set:html={ICONOS.mic} />
            </button>
            <button type="button" class="control" id="previaCam" aria-label="Apagar cámara" title="Cámara">
              <Fragment set:html={ICONOS.cam} />
            </button>
          </div>
        </div>

        <div class="previa-texto">
          <span class="sala-etiqueta">{esGrupo ? tituloSesion : "Sala de sesión"}</span>
          <h1>Todo listo para tu sesión</h1>
          <p>Revisa que te veas y te escuches bien. Cuando quieras, entra a la sala.</p>

          <!-- Quién ya entró (se actualiza solo) -->
          <ul class="previa-participantes" id="previaParticipantes">
            {otros.map((o) => (
              <li data-id={o.id}>
                <span class="punto"></span>
                <span>{o.nombre}{o.rol === "Psicologo" ? " (psicólogo)" : ""}</span>
                <small>No ha entrado</small>
              </li>
            ))}
          </ul>

          <button type="button" class="sala-boton" id="btnEntrar">
            Entrar a la sesión →
          </button>

          <ul class="previa-pistas">
            <li>Busca un lugar tranquilo y privado.</li>
            <li>Usa audífonos para que no haya eco.</li>
            <li>La sesión no se graba.</li>
          </ul>
        </div>
      </section>


      <!-- 3. LA SESIÓN -->
      <section class="sala-llamada" id="salaLlamada" hidden>
        <div class="llamada-centro">
          <div class="escenario solo" id="escenario">
            <!-- Pantalla que comparte alguien (solo se ve cuando comparte) -->
            <video id="videoPantalla" class="pantalla-compartida" autoplay playsinline muted></video>
            <span class="pantalla-de" id="pantallaDe" hidden></span>

            <!-- Un mosaico por persona; el mío va de último -->
            <div class="mosaicos" id="mosaicos">
              <div class="mosaico yo" id="miVideoCaja">
                <video id="videoLocal" autoplay playsinline muted></video>
                <span class="mosaico-sin" id="miVideoSin" hidden>
                  <span class="sala-avatar"><span>{iniciales(String(sala.yo.nombre))}</span></span>
                </span>
                <span class="mosaico-nombre">
                  <span class="ondas" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="mic-apagado" id="miMicApagado" hidden><Fragment set:html={ICONOS.micOff} /></span>
                  Tú
                </span>
              </div>
            </div>

            <!-- Copia de un video solo para la ventana flotante -->
            <video id="videoFlotante" class="video-flotante" autoplay playsinline muted aria-hidden="true"></video>

            <div class="banner-compartir" id="bannerCompartir" hidden>
              <span>Estás compartiendo tu pantalla</span>
              <button type="button" class="flotante" id="btnFlotante" hidden>Ver la sesión en ventana flotante</button>
              <button type="button" id="btnDejarCompartir">Dejar de compartir</button>
            </div>

            <!-- Mientras nadie más ha entrado -->
            <div class="escenario-espera" id="escenarioEspera">
              <span class="sala-avatar enorme" id="esperaAvatar">
                {esGrupo ? <span class="grupo-icono" set:html={ICONOS.personas}></span> : <span>{iniciales(otros[0]?.nombre ?? "")}</span>}
              </span>
              <p id="esperaTexto">
                <span class="hoja-respira" set:html={hoja}></span>
                <span id="esperaMensaje">{esGrupo ? "Esperando a los demás participantes…" : `Esperando a ${primerNombre(otros[0]?.nombre ?? "")}…`}</span>
              </p>
            </div>
          </div>

          <div class="controles" role="toolbar" aria-label="Controles de la sesión">
            <button type="button" class="control" id="ctrlMic" aria-label="Silenciar micrófono" title="Micrófono">
              <Fragment set:html={ICONOS.mic} />
            </button>
            <button type="button" class="control" id="ctrlCam" aria-label="Apagar cámara" title="Cámara">
              <Fragment set:html={ICONOS.cam} />
            </button>
            <button type="button" class="control" id="ctrlPantalla" aria-label="Compartir pantalla" title="Compartir pantalla">
              <Fragment set:html={ICONOS.pantalla} />
            </button>
            {soyPsicologo && (
              <button type="button" class="control activo" id="ctrlNotas" aria-label="Mostrar u ocultar notas" title="Notas de la sesión">
                <Fragment set:html={ICONOS.notas} />
              </button>
            )}
            <button type="button" class="control colgar" id="ctrlColgar" aria-label="Salir de la sesión" title="Salir de la sesión">
              <Fragment set:html={ICONOS.colgar} />
            </button>
          </div>
        </div>

        {soyPsicologo && (
          <aside class="notas" id="panelNotas">
            <div class="notas-cabeza">
              <strong>Notas de la sesión</strong>
              <small>
                Solo las ves tú. Se guardan en el historial de {esGrupo ? primerNombre(String(sala.pacienteNombre ?? "")) : "el paciente"}.
              </small>
            </div>
            <textarea id="notasTexto" maxlength="5000" placeholder="Escribe aquí lo importante de la sesión…"></textarea>
            <div class="notas-pie">
              <small id="notasEstado">Borrador guardado en este navegador</small>
              <button type="button" class="sala-boton pequeno" id="btnGuardarNota">Guardar en historial</button>
            </div>
          </aside>
        )}
      </section>


      <!-- 4. FIN -->
      <section class="sala-tarjeta" id="salaFin" hidden>
        <div class="sala-icono" set:html={hoja}></div>
        <h1>Saliste de la sesión</h1>
        <p id="finTexto">Puedes volver a entrar mientras la sala siga abierta (hasta las {hora(sala.cierra)}).</p>
        <div class="fin-botones">
          <button type="button" class="sala-boton" id="btnVolverEntrar">Volver a entrar</button>
          {soyPsicologo && (
            <button type="button" class="sala-boton secundario" id="btnCompletar">Marcar la cita como realizada</button>
          )}
          <!-- cambio: ahora es un botón visible para volver al panel -->
          <a href={volverHref} class="sala-boton secundario">{soyPsicologo ? "Ir a mis citas" : "Volver a mi panel"}</a>
        </div>
      </section>
    </>
  )}

  <!-- Avisos pequeños (abajo en el centro) -->
  <div class="sala-toast" id="salaToast" role="status" aria-live="polite" hidden></div>
</div>

<script type="application/json" id="salaDatos" set:html={datosJson}></script>

<script>
  /* =====================================================
     DATOS
  ===================================================== */
  const datos = JSON.parse(document.getElementById("salaDatos")?.textContent || "{}");
  const sala = datos.sala;
  const API: string = datos.api ?? "http://localhost:8001"; // cambio (túnel): "" = misma dirección de la página
  const ICONOS: Record<string, string> = datos.iconos || {};

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;

  // Si la sala aún no abre: cuenta regresiva y se recarga sola
  const avisoSala = $("salaAviso");
  if (avisoSala?.dataset.motivo === "temprano" && avisoSala.dataset.abre) {
    const abre = new Date(avisoSala.dataset.abre).getTime();
    const pintar = () => {
      const falta = Math.max(0, abre - Date.now());
      const m = Math.floor(falta / 60000);
      const s = Math.floor((falta % 60000) / 1000);
      const caja = $("cuentaRegresiva");
      if (caja) caja.textContent = m >= 60 ? `${Math.floor(m / 60)} h ${m % 60} min` : `${m}:${String(s).padStart(2, "0")}`;
      if (falta <= 0) location.reload();
    };
    pintar();
    setInterval(pintar, 1000);
  }

  if (sala?.puedeEntrar) iniciarSala();

  function iniciarSala() {
    type Miembro = { id: string; nombre: string; rol: string; tieneFoto: boolean; fotoVersion?: string; principal: boolean };
    const soyPsicologo = sala.yo.rol === "Psicologo";
    const yoId = String(sala.yo.id);
    const miembros = new Map<string, Miembro>((sala.otros ?? []).map((o: Miembro) => [String(o.id), o]));
    const esGrupo = miembros.size > 1;
    const primer = (n: string) => String(n ?? "").split(" ")[0] || "Participante";
    const nombreDe = (id: string) => primer(miembros.get(id)?.nombre ?? "Participante");
    const iniciales = (n: string) =>
      String(n ?? "").split(" ").filter(Boolean).slice(0, 2).map((p) => p[0]!.toUpperCase()).join("") || "?";
    // cambio: ?v= cambia cuando la persona cambia su foto (así no sale la foto vieja)
    const urlFoto = (id: string) =>
      `${API}/api/sala/${encodeURIComponent(sala.citaId)}/foto/${encodeURIComponent(id)}?v=${encodeURIComponent(miembros.get(id)?.fotoVersion ?? "")}`;

    // Servidores para encontrar la ruta entre los navegadores.
    // STUN de Google (gratis). Cuando se publique, se agrega un TURN (coturn).
    const ICE_SERVERS: RTCIceServer[] = [{ urls: ["stun:stun.l.google.com:19302", "stun:stun1.l.google.com:19302"] }];

    const videoPrevia = $<HTMLVideoElement>("videoPrevia")!;
    const videoLocal = $<HTMLVideoElement>("videoLocal")!;
    const videoPantalla = $<HTMLVideoElement>("videoPantalla")!;
    const escenario = $("escenario")!;
    const mosaicos = $("mosaicos")!;

    let local: MediaStream = new MediaStream();
    let camara: MediaStreamTrack | null = null; // pista de cámara (no se pierde al compartir pantalla)
    let pantalla: MediaStream | null = null;
    let micActivo = true;
    let camActiva = true;

    let enLlamada = false;
    let inicioConexion = 0;
    let reloj: ReturnType<typeof setInterval> | undefined;


    /* ---------------- AVISOS ---------------- */
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    function avisar(texto: string, ms = 4000) {
      const t = $("salaToast");
      if (!t) return;
      t.textContent = texto;
      t.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => (t.hidden = true), ms);
    }

    function mostrar(id: "salaPrevia" | "salaLlamada" | "salaFin") {
      ["salaPrevia", "salaLlamada", "salaFin"].forEach((x) => {
        const el = $(x);
        if (el) el.hidden = x !== id;
      });
    }

    // Foto (si tiene) sobre las iniciales; si no carga, quedan las iniciales
    function ponerFoto(caja: HTMLElement | null, id: string) {
      if (!caja || !miembros.get(id)?.tieneFoto) return;
      const img = document.createElement("img");
      img.src = urlFoto(id);
      img.alt = "";
      img.addEventListener("error", () => img.remove());
      caja.append(img);
    }
    if (!esGrupo) {
      const unico = [...miembros.keys()][0];
      if (unico) ["barraAvatar", "esperaAvatar"].forEach((id) => ponerFoto($(id), unico));
    }


    /* ---------------- ANTES DE ENTRAR: quién está ---------------- */
    const enSala = new Set<string>(); // quiénes están dentro ahora mismo

    function pintarPresentes() {
      document.querySelectorAll<HTMLLIElement>("#previaParticipantes li").forEach((li) => {
        const dentro = enSala.has(li.dataset.id ?? "");
        li.classList.toggle("en-sala", dentro);
        const t = li.querySelector("small");
        if (t) t.textContent = dentro ? "Ya está en la sala" : "No ha entrado";
      });
      const total = $("salaPersonas");
      const n = $("salaPersonasN");
      if (total && n) {
        total.hidden = !enLlamada || !esGrupo;
        n.textContent = String(pares.size + 1);
      }
    }


    /* ---------------- CÁMARA Y MICRÓFONO ---------------- */
    async function pedirMedios(): Promise<MediaStream> {
      const estado = $("previaEstadoCamara");
      if (!navigator.mediaDevices?.getUserMedia) {
        if (estado) estado.textContent = "Este navegador no permite usar la cámara aquí (se necesita HTTPS).";
        return new MediaStream();
      }
      try {
        return await navigator.mediaDevices.getUserMedia({
          // En grupo se pide un poco menos de calidad: cada uno envía su video a varios
          video: esGrupo ? { width: { ideal: 960 }, height: { ideal: 540 } } : { width: { ideal: 1280 }, height: { ideal: 720 } },
          audio: { echoCancellation: true, noiseSuppression: true },
        });
      } catch {
        try {
          const soloAudio = await navigator.mediaDevices.getUserMedia({ audio: true });
          if (estado) estado.textContent = "No pudimos usar tu cámara. Entrarás solo con audio.";
          return soloAudio;
        } catch {
          if (estado) estado.textContent = "No pudimos usar tu cámara ni tu micrófono. Revisa los permisos (el candado junto a la dirección).";
          return new MediaStream();
        }
      }
    }

    function pintarBotonesMedios() {
      const tieneMic = local.getAudioTracks().length > 0;
      const tieneCam = local.getVideoTracks().length > 0;
      [["previaMic", "ctrlMic"], ["previaCam", "ctrlCam"]].forEach(([a, b], i) => {
        const activo = i === 0 ? micActivo && tieneMic : camActiva && tieneCam;
        const disponible = i === 0 ? tieneMic : tieneCam;
        [a, b].forEach((id) => {
          const btn = $<HTMLButtonElement>(id);
          if (!btn) return;
          btn.classList.toggle("apagado", !activo);
          btn.disabled = !disponible;
          btn.innerHTML = i === 0
            ? (activo ? ICONOS.mic : ICONOS.micOff)
            : (activo ? ICONOS.cam : ICONOS.camOff);
          btn.setAttribute("aria-label", i === 0
            ? (activo ? "Silenciar micrófono" : "Activar micrófono")
            : (activo ? "Apagar cámara" : "Encender cámara"));
        });
      });
      const sinVideo = !(camActiva && tieneCam);
      const previaSin = $("previaSinVideo");
      if (previaSin) previaSin.hidden = !sinVideo;
      const miSin = $("miVideoSin");
      if (miSin) miSin.hidden = !sinVideo;
      const miMic = $("miMicApagado");
      if (miMic) miMic.hidden = micActivo && tieneMic;
    }

    function cambiarMic() {
      micActivo = !micActivo;
      local.getAudioTracks().forEach((t) => (t.enabled = micActivo));
      pintarBotonesMedios();
      avisarMedios();
    }

    function cambiarCam() {
      camActiva = !camActiva;
      local.getVideoTracks().forEach((t) => (t.enabled = camActiva));
      pintarBotonesMedios();
      avisarMedios();
    }

    const misMedios = () => ({ mic: micActivo, cam: camActiva && !!camara, pantalla: !!pantalla });

    // A todos (o a una persona: la que acaba de conectarse)
    function avisarMedios(para?: string) {
      if (enLlamada) señal("medios", misMedios(), para);
    }

    $("previaMic")?.addEventListener("click", cambiarMic);
    $("previaCam")?.addEventListener("click", cambiarCam);
    $("ctrlMic")?.addEventListener("click", cambiarMic);
    $("ctrlCam")?.addEventListener("click", cambiarCam);


    /* ---------------- ¿QUIÉN ESTÁ HABLANDO? ----------------
       Se mide el volumen de cada micrófono y, cuando alguien habla,
       su recuadro se ilumina con el color del tema y aparecen barritas. */
    let audioCtx: AudioContext | null = null;
    const detectores = new Map<string, () => void>();

    function contextoAudio() {
      if (!audioCtx) {
        try {
          audioCtx = new AudioContext();
        } catch {
          return null;
        }
      }
      if (audioCtx.state === "suspended") audioCtx.resume().catch(() => {});
      return audioCtx;
    }

    // El navegador solo deja usar el audio después de un clic
    document.addEventListener("click", () => contextoAudio());

    function vigilarVoz(clave: string, pista: MediaStreamTrack | null | undefined, alHablar: (hablando: boolean) => void) {
      dejarDeVigilar(clave);
      const ctx = contextoAudio();
      if (!ctx || !pista) return alHablar(false);

      const fuente = ctx.createMediaStreamSource(new MediaStream([pista]));
      const analizador = ctx.createAnalyser();
      analizador.fftSize = 512;
      fuente.connect(analizador);
      const datosAudio = new Uint8Array(analizador.fftSize);

      let activo = true;
      let hablando = false;
      let ultimaVoz = 0;
      const medir = () => {
        if (!activo) return;
        analizador.getByteTimeDomainData(datosAudio);
        let suma = 0;
        for (const v of datosAudio) suma += ((v - 128) / 128) ** 2;
        const volumen = Math.sqrt(suma / datosAudio.length);
        const ahora = performance.now();
        if (volumen > 0.035 && pista.enabled) ultimaVoz = ahora;
        // Se mantiene encendido un momento para que no parpadee entre palabras
        const ahoraHabla = ahora - ultimaVoz < 350;
        if (ahoraHabla !== hablando) {
          hablando = ahoraHabla;
          alHablar(hablando);
        }
        requestAnimationFrame(medir);
      };
      medir();

      detectores.set(clave, () => {
        activo = false;
        fuente.disconnect();
        alHablar(false);
      });
    }

    function dejarDeVigilar(clave: string) {
      detectores.get(clave)?.();
      detectores.delete(clave);
    }

    (async () => {
      local = await pedirMedios();
      camara = local.getVideoTracks()[0] ?? null;
      videoPrevia.srcObject = local;
      pintarBotonesMedios();
      // Mi voz: en la prueba de antes de entrar y en mi recuadro durante la sesión
      vigilarVoz("yo", local.getAudioTracks()[0], (h) => {
        $("previaVideoCaja")?.classList.toggle("hablando", h);
        $("miVideoCaja")?.classList.toggle("hablando", h);
      });
    })();


    /* ---------------- MOSAICOS (uno por persona) ---------------- */
    type Vista = { caja: HTMLElement; video: HTMLVideoElement; sin: HTMLElement; mic: HTMLElement; estado: HTMLElement };

    function crearMosaico(id: string): Vista {
      const m = miembros.get(id);
      const caja = document.createElement("div");
      caja.className = "mosaico";
      caja.dataset.id = id;

      const video = document.createElement("video");
      video.autoplay = true;
      video.playsInline = true;

      const sin = document.createElement("span");
      sin.className = "mosaico-sin";
      sin.hidden = true;
      const avatar = document.createElement("span");
      avatar.className = "sala-avatar";
      const ini = document.createElement("span");
      ini.textContent = iniciales(m?.nombre ?? "");
      avatar.append(ini);
      ponerFoto(avatar, id);
      sin.append(avatar);

      const nombre = document.createElement("span");
      nombre.className = "mosaico-nombre";
      nombre.innerHTML = '<span class="ondas" aria-hidden="true"><i></i><i></i><i></i></span>';
      const mic = document.createElement("span");
      mic.className = "mic-apagado";
      mic.hidden = true;
      mic.innerHTML = ICONOS.micOff;
      const texto = document.createElement("span");
      texto.textContent = `${primer(m?.nombre ?? "Participante")}${m?.rol === "Psicologo" ? " · Psicólogo" : ""}`;
      nombre.append(mic, texto);

      const estado = document.createElement("span");
      estado.className = "mosaico-estado";
      estado.textContent = "Conectando…";

      caja.append(video, sin, nombre, estado);
      // Los demás van antes que mi recuadro; el psicólogo primero
      const yo = $("miVideoCaja");
      if (m?.rol === "Psicologo") mosaicos.prepend(caja);
      else mosaicos.insertBefore(caja, yo);
      return { caja, video, sin, mic, estado };
    }


    /* ---------------- CONEXIONES (una por persona) ---------------- */
    // Tres canales fijos y siempre en este orden:
    //   0 = micrófono · 1 = cámara · 2 = pantalla compartida
    // Así compartir pantalla NO reemplaza la cámara: van las dos a la vez.
    const pistasPropias = (): (MediaStreamTrack | null)[] => [
      local.getAudioTracks()[0] ?? null,
      camara,
      pantalla?.getVideoTracks()[0] ?? null,
    ];

    type Par = {
      id: string;
      pc: RTCPeerConnection;
      camara: MediaStream; // micrófono y cámara de esa persona
      pantalla: MediaStream; // la pantalla que comparte
      ice: RTCIceCandidateInit[]; // candidatos que llegaron antes de tiempo
      medios: { mic: boolean; cam: boolean; pantalla: boolean };
      vista: Vista;
      reintento?: ReturnType<typeof setTimeout>;
    };
    const pares = new Map<string, Par>();

    function crearPar(id: string, inicioYo: boolean): Par {
      cerrarPar(id, false);
      const pc = new RTCPeerConnection({ iceServers: ICE_SERVERS });

      // Quien ofrece crea los tres canales; el otro los recibe en la oferta
      if (inicioYo) {
        const [mic, cam, pant] = pistasPropias();
        pc.addTransceiver(mic ?? "audio", { direction: "sendrecv" });
        pc.addTransceiver(cam ?? "video", { direction: "sendrecv" });
        pc.addTransceiver(pant ?? "video", { direction: "sendrecv" });
      }

      const vista = document.querySelector<HTMLElement>(`.mosaico[data-id="${CSS.escape(id)}"]`)
        ? reutilizarMosaico(id)
        : crearMosaico(id);
      const par: Par = {
        id,
        pc,
        camara: new MediaStream(),
        pantalla: new MediaStream(),
        ice: [],
        medios: { mic: true, cam: true, pantalla: false },
        vista,
      };
      vista.video.srcObject = par.camara;
      vista.estado.textContent = "Conectando…";
      vista.estado.hidden = false;

      pc.onicecandidate = (e) => {
        if (e.candidate) señal("ice", e.candidate.toJSON(), id);
      };

      // Lo que llega: el canal 2 es su pantalla; lo demás, su micrófono y cámara
      pc.ontrack = (e) => {
        const canal = pc.getTransceivers().indexOf(e.transceiver);
        if (canal === 2) par.pantalla.addTrack(e.track);
        else par.camara.addTrack(e.track);
        if (e.track.kind === "audio") {
          vigilarVoz(`par-${id}`, e.track, (h) => vista.caja.classList.toggle("hablando", h));
        }
      };

      pc.onconnectionstatechange = () => {
        const estado = pc.connectionState;
        if (estado === "connected") {
          clearTimeout(par.reintento);
          vista.estado.hidden = true;
          vista.caja.classList.remove("reconectando");
          if (!inicioConexion) {
            inicioConexion = Date.now();
            iniciarReloj();
          }
          avisarMedios(id);
        } else if (estado === "disconnected") {
          vista.estado.textContent = "Reconectando…";
          vista.estado.hidden = false;
          vista.caja.classList.add("reconectando");
        } else if (estado === "failed") {
          vista.estado.textContent = "Se perdió la conexión…";
          vista.estado.hidden = false;
          // Para no chocar, vuelve a llamar solo uno de los dos (el de id "menor")
          if (yoId < id) par.reintento = setTimeout(() => llamar(id), 1500);
        }
      };

      pares.set(id, par);
      acomodar();
      return par;
    }

    function reutilizarMosaico(id: string): Vista {
      const caja = document.querySelector<HTMLElement>(`.mosaico[data-id="${CSS.escape(id)}"]`)!;
      return {
        caja,
        video: caja.querySelector("video")!,
        sin: caja.querySelector<HTMLElement>(".mosaico-sin")!,
        mic: caja.querySelector<HTMLElement>(".mic-apagado")!,
        estado: caja.querySelector<HTMLElement>(".mosaico-estado")!,
      };
    }

    // quitarVista=false cuando se va a reconectar (se conserva su recuadro)
    function cerrarPar(id: string, quitarVista = true) {
      const par = pares.get(id);
      if (!par) return;
      clearTimeout(par.reintento);
      par.pc.ontrack = null;
      par.pc.onicecandidate = null;
      par.pc.onconnectionstatechange = null;
      par.pc.close();
      dejarDeVigilar(`par-${id}`);
      pares.delete(id);
      if (quitarVista) par.vista.caja.remove();
      if (compartiendoId === id) elegirPantalla();
      acomodar();
    }

    function cerrarTodos() {
      [...pares.keys()].forEach((id) => cerrarPar(id));
    }

    // Yo llegué: ofrezco conexión a quien ya estaba
    async function llamar(id: string) {
      const par = crearPar(id, true);
      const oferta = await par.pc.createOffer();
      await par.pc.setLocalDescription(oferta);
      señal("oferta", par.pc.localDescription?.toJSON(), id);
    }

    // Alguien me ofrece conexión: respondo
    async function responder(id: string, oferta: RTCSessionDescriptionInit) {
      const par = crearPar(id, false);
      await par.pc.setRemoteDescription(oferta);
      // Pongo mi micrófono, cámara y pantalla en los mismos tres canales
      const canales = par.pc.getTransceivers();
      const mias = pistasPropias();
      for (let i = 0; i < canales.length && i < 3; i++) {
        canales[i].direction = "sendrecv";
        await canales[i].sender.replaceTrack(mias[i]).catch(() => {});
      }
      await vaciarIce(par);
      const respuesta = await par.pc.createAnswer();
      await par.pc.setLocalDescription(respuesta);
      señal("respuesta", par.pc.localDescription?.toJSON(), id);
    }

    async function vaciarIce(par: Par) {
      const pendientes = par.ice;
      par.ice = [];
      for (const c of pendientes) await par.pc.addIceCandidate(c).catch(() => {});
    }


    /* ---------------- CÓMO SE ACOMODAN LOS VIDEOS ---------------- */
    let compartiendoId: string | null = null; // quién comparte pantalla (otra persona)

    function acomodar() {
      const n = pares.size;
      escenario.classList.toggle("solo", n === 0);
      escenario.classList.toggle("dos", n === 1);
      escenario.classList.toggle("grupo", n >= 2);
      escenario.dataset.personas = String(n + 1);
      escenario.classList.toggle("compartiendo", !!compartiendoId);
      if (n === 0 && enLlamada) {
        ponerEspera(esGrupo ? "Esperando a los demás participantes…" : `Esperando a ${nombreDe([...miembros.keys()][0])}…`);
      } else quitarEspera();
      pintarPresentes();
    }

    // Muestra en grande la pantalla de quien esté compartiendo (si hay alguien)
    function elegirPantalla() {
      const quien = [...pares.values()].find((p) => p.medios.pantalla);
      compartiendoId = quien?.id ?? null;
      videoPantalla.srcObject = quien ? quien.pantalla : null;
      const etiqueta = $("pantallaDe");
      if (etiqueta) {
        etiqueta.hidden = !quien;
        etiqueta.textContent = quien ? `Pantalla de ${nombreDe(quien.id)}` : "";
      }
      acomodar();
    }


    /* ---------------- WEBSOCKET (señalización) ---------------- */
    let ws: WebSocket | null = null;
    let espera = 1000;

    function señal(accion: string, extra: unknown = null, para?: string) {
      if (ws?.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ tipo: "sala", citaId: sala.citaId, accion, datos: extra, ...(para ? { para } : {}) }));
      }
    }

    function conectar() {
      ws = new WebSocket((API || location.origin).replace(/^http/, "ws") + "/api/chat/ws");

      ws.addEventListener("open", () => {
        espera = 1000;
        // En la sala: "entré"; antes de entrar: "¿quién está?"
        señal(enLlamada ? "entrar" : "hola");
      });

      ws.addEventListener("message", async (e) => {
        let ev: any;
        try {
          ev = JSON.parse(String(e.data));
        } catch {
          return;
        }
        if (ev.tipo !== "sala" || ev.citaId !== sala.citaId) return;
        try {
          await recibir(ev.accion, ev.datos, ev.de ? String(ev.de) : "");
        } catch (err) {
          console.error("Sala:", err);
        }
      });

      ws.addEventListener("close", () => {
        ws = null;
        setTimeout(conectar, espera);
        espera = Math.min(espera * 2, 10000);
      });
    }

    conectar();
    setInterval(() => ws?.readyState === WebSocket.OPEN && ws.send(JSON.stringify({ tipo: "ping" })), 25000);

    async function recibir(accion: string, d: any, de: string) {
      if (de && de !== yoId && !miembros.has(de)) return; // solo personas de esta cita

      switch (accion) {
        // Quiénes están dentro (al abrir la página o al entrar)
        case "presentes": {
          const ids: string[] = (d?.ids ?? []).map(String).filter((id: string) => miembros.has(id));
          enSala.clear();
          ids.forEach((id) => enSala.add(id));
          pintarPresentes();
          if (enLlamada) {
            // Me conecto con cada uno de los que ya estaban (si no lo estoy ya)
            for (const id of ids) {
              const par = pares.get(id);
              if (!par || ["failed", "closed"].includes(par.pc.connectionState)) await llamar(id);
            }
          }
          break;
        }

        // Alguien entró: él me ofrece la conexión (siempre ofrece el que llega)
        case "entro":
          enSala.add(de);
          pintarPresentes();
          if (enLlamada) avisar(`${nombreDe(de)} entró a la sesión`, 2500);
          break;

        case "oferta":
          if (enLlamada) await responder(de, d);
          break;

        case "respuesta": {
          const par = pares.get(de);
          if (par && par.pc.signalingState === "have-local-offer") {
            await par.pc.setRemoteDescription(d);
            await vaciarIce(par);
          }
          break;
        }

        case "ice": {
          if (!d) break;
          const par = pares.get(de);
          if (!par) break;
          if (par.pc.remoteDescription) await par.pc.addIceCandidate(d).catch(() => {});
          else par.ice.push(d);
          break;
        }

        case "medios": {
          const par = pares.get(de);
          if (!par) break;
          par.medios = { mic: d?.mic !== false, cam: d?.cam !== false, pantalla: d?.pantalla === true };
          par.vista.mic.hidden = par.medios.mic;
          par.vista.sin.hidden = par.medios.cam;
          par.vista.caja.classList.toggle("sin-video", !par.medios.cam);
          // Alguien empezó o dejó de compartir pantalla
          if (par.medios.pantalla || compartiendoId === de) elegirPantalla();
          break;
        }

        case "salio":
          enSala.delete(de);
          pintarPresentes();
          if (enLlamada && pares.has(de)) {
            cerrarPar(de);
            avisar(`${nombreDe(de)} salió de la sesión`);
          }
          break;

        case "error":
          avisar(typeof d === "string" ? d : "No puedes entrar a esta sala.");
          break;
      }
    }


    /* ---------------- ESPERA / RELOJ ---------------- */
    function ponerEspera(texto: string) {
      const caja = $("escenarioEspera");
      const t = $("esperaMensaje");
      if (t) t.textContent = texto;
      if (caja) caja.hidden = false;
    }

    function quitarEspera() {
      const caja = $("escenarioEspera");
      if (caja) caja.hidden = true;
    }

    function iniciarReloj() {
      const caja = $("salaTiempo");
      if (!caja) return;
      caja.hidden = false;
      clearInterval(reloj);
      reloj = setInterval(() => {
        const s = Math.floor((Date.now() - inicioConexion) / 1000);
        const h = Math.floor(s / 3600);
        const mm = String(Math.floor((s % 3600) / 60)).padStart(2, "0");
        const ss = String(s % 60).padStart(2, "0");
        caja.textContent = h ? `${h}:${mm}:${ss}` : `${mm}:${ss}`;
      }, 1000);
    }


    /* ---------------- ENTRAR / SALIR ---------------- */
    function entrar() {
      enLlamada = true;
      videoLocal.srcObject = local;
      mostrar("salaLlamada");
      acomodar();
      pintarBotonesMedios();
      señal("entrar"); // el servidor responde "presentes" y me conecto con cada uno
    }

    function salir() {
      señal("salir");
      enLlamada = false;
      cerrarTodos();
      dejarDeCompartir();
      clearInterval(reloj);
      mostrar("salaFin");
      pintarPresentes();
    }

    $("btnEntrar")?.addEventListener("click", entrar);
    $("btnVolverEntrar")?.addEventListener("click", entrar);
    $("ctrlColgar")?.addEventListener("click", salir);

    // Si cierra la pestaña, los demás se enteran
    window.addEventListener("beforeunload", () => {
      if (enLlamada) señal("salir");
    });


    /* ---------------- COMPARTIR PANTALLA ---------------- */
    async function compartirPantalla() {
      if (pantalla) return dejarDeCompartir();
      if (!navigator.mediaDevices?.getDisplayMedia) return avisar("Este navegador no permite compartir pantalla.");
      if (compartiendoId) return avisar(`${nombreDe(compartiendoId)} ya está compartiendo su pantalla.`);
      // Chrome, al compartir una pestaña o ventana, salta a ella y la sala queda
      // escondida. Con CaptureController se le pide que se quede en la sala.
      const Controlador = (window as any).CaptureController;
      const controlador = Controlador ? new Controlador() : null;
      try {
        pantalla = await navigator.mediaDevices.getDisplayMedia(
          { video: true, ...(controlador ? { controller: controlador } : {}) } as DisplayMediaStreamOptions,
        );
        // Debe llamarse justo después de que el navegador entrega la pantalla
        try {
          controlador?.setFocusBehavior?.("no-focus-change");
        } catch { /* si es pantalla completa no aplica */ }
      } catch {
        pantalla = null;
        return; // canceló
      }
      const pista = pantalla.getVideoTracks()[0];
      pista.addEventListener("ended", dejarDeCompartir);
      for (const par of pares.values()) {
        await par.pc.getTransceivers()[2]?.sender.replaceTrack(pista).catch(() => {});
      }
      $("ctrlPantalla")?.classList.add("activo");
      const banner = $("bannerCompartir");
      if (banner) banner.hidden = false;
      avisarMedios();
      // Ventana flotante con las caras, por si se va a otra pestaña
      const btnFlotante = $("btnFlotante");
      if (btnFlotante) btnFlotante.hidden = !document.pictureInPictureEnabled;
      abrirFlotante();
    }

    // Video de otra persona en una ventanita encima de todo (Picture-in-Picture).
    // En grupo se muestra a quien esté hablando (o al primero).
    async function abrirFlotante() {
      if (!document.pictureInPictureEnabled || document.pictureInPictureElement) return;
      const flotante = $<HTMLVideoElement>("videoFlotante");
      const par = [...pares.values()].find((p) => p.vista.caja.classList.contains("hablando")) ?? [...pares.values()][0];
      if (!flotante || !par) return;
      try {
        flotante.srcObject = par.camara;
        await flotante.play().catch(() => {});
        await flotante.requestPictureInPicture();
      } catch { /* el navegador pide un clic: queda el botón del aviso */ }
    }

    $("btnFlotante")?.addEventListener("click", abrirFlotante);

    async function dejarDeCompartir() {
      if (!pantalla) return;
      pantalla.getTracks().forEach((t) => t.stop());
      pantalla = null;
      if (document.pictureInPictureElement) document.exitPictureInPicture().catch(() => {});
      for (const par of pares.values()) {
        await par.pc.getTransceivers()[2]?.sender.replaceTrack(null).catch(() => {});
      }
      $("ctrlPantalla")?.classList.remove("activo");
      const banner = $("bannerCompartir");
      if (banner) banner.hidden = true;
      avisarMedios();
    }

    $("btnDejarCompartir")?.addEventListener("click", dejarDeCompartir);
    $("ctrlPantalla")?.addEventListener("click", compartirPantalla);


    /* ---------------- NOTAS (solo psicólogo) ---------------- */
    if (soyPsicologo) {
      const notas = $<HTMLTextAreaElement>("notasTexto")!;
      const estado = $("notasEstado")!;
      const clave = `psynex-notas-${sala.citaId}`;

      try {
        notas.value = localStorage.getItem(clave) ?? "";
      } catch { /* sin almacenamiento: no pasa nada */ }

      notas.addEventListener("input", () => {
        try {
          localStorage.setItem(clave, notas.value);
          estado.textContent = "Borrador guardado en este navegador";
        } catch {
          estado.textContent = "Borrador sin guardar";
        }
      });

      $("ctrlNotas")?.addEventListener("click", () => {
        const panel = $("panelNotas");
        if (!panel) return;
        panel.hidden = !panel.hidden;
        $("ctrlNotas")?.classList.toggle("activo", !panel.hidden);
      });

      $("btnGuardarNota")?.addEventListener("click", async () => {
        const contenido = notas.value.trim();
        if (contenido.length < 3) return avisar("Escribe la nota antes de guardarla.");
        const boton = $<HTMLButtonElement>("btnGuardarNota")!;
        boton.disabled = true;
        try {
          const res = await fetch(`${API}/api/psicologo/pacientes/${encodeURIComponent(sala.pacientePerfilId)}/notas`, {
            method: "POST",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ contenido, citaId: sala.citaId }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(Array.isArray(data.error) ? data.error.join(". ") : data.error);
          notas.value = "";
          try { localStorage.removeItem(clave); } catch { /* nada */ }
          estado.textContent = "Nota guardada en el historial";
          avisar("Nota guardada en el historial del paciente");
        } catch (err) {
          avisar((err as Error).message || "No se pudo guardar la nota");
        } finally {
          boton.disabled = false;
        }
      });

      $("btnCompletar")?.addEventListener("click", async () => {
        const boton = $<HTMLButtonElement>("btnCompletar")!;
        boton.disabled = true;
        try {
          const res = await fetch(`${API}/api/sala/${encodeURIComponent(sala.citaId)}/completar`, {
            method: "PATCH",
            credentials: "include",
          });
          if (!res.ok) throw new Error();
          boton.textContent = "Cita marcada como realizada ✓";
          const fin = $("finTexto");
          if (fin) fin.textContent = "La cita quedó marcada como realizada.";
          const volver = $("btnVolverEntrar");
          if (volver) volver.hidden = true;
        } catch {
          boton.disabled = false;
          avisar("No se pudo marcar la cita. Inténtalo de nuevo.");
        }
      });
    }
  }
</script>
