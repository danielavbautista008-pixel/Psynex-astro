---
import MenuAdmin from "../Menu/MenuAdmin.astro";
import "./cuestionarios.css";
---

<div class="cuestionarios-layout">

    <!-- =========================================
         MENÚ ADMINISTRADOR
    ========================================== -->
    <MenuAdmin />


    <!-- =========================================
         CONTENIDO PRINCIPAL
    ========================================== -->
    <main class="cuestionarios-page">

        <!-- =====================================
             ENCABEZADO
        ====================================== -->
        <header class="page-header">

            <div class="header-info">

                <div class="header-icon">
                    <i class="bi bi-clipboard2-pulse"></i>
                </div>

                <div>
                    <h1>Gestión de Cuestionarios</h1>

                    <p>
                        Administra los cuestionarios clínicos de la plataforma.
                    </p>
                </div>

            </div>

            <button
                class="btn-nuevo"
                id="btnNuevo"
            >
                <i class="bi bi-plus-lg"></i>
                Nuevo cuestionario
            </button>

        </header>


        <!-- =====================================
             CONTENIDO EN DOS COLUMNAS
        ====================================== -->
        <div class="dashboard-content">


            <!-- =================================
                 COLUMNA PRINCIPAL
            ================================== -->
            <section class="contenido-principal">


                <!-- =================================
                     TÍTULO LISTA
                ================================== -->
                <div class="section-heading">

                    <div>
                        <h2>Cuestionarios</h2>

                        <span id="contadorCuestionarios">
                            Mostrando 3 cuestionarios
                        </span>
                    </div>

                </div>


                <!-- =================================
                     FILTROS
                ================================== -->
                <div class="filtros">

                    <!-- BUSCADOR -->
                    <div class="buscador">

                        <i class="bi bi-search"></i>

                        <input
                            type="text"
                            id="buscarCuestionario"
                            placeholder="Buscar cuestionario..."
                        />

                    </div>


                    <!-- CATEGORÍA -->
                    <select id="filtroCategoria">

                        <option value="todas">
                            Todas las categorías
                        </option>

                        <option value="Ansiedad">
                            Ansiedad
                        </option>

                        <option value="Depresión">
                            Depresión
                        </option>

                        <option value="Estrés">
                            Estrés
                        </option>

                        <option value="Autoestima">
                            Autoestima
                        </option>

                        <option value="Sueño">
                            Sueño
                        </option>

                    </select>


                    <!-- ESTADO -->
                    <select id="filtroEstado">

                        <option value="todos">
                            Todos
                        </option>

                        <option value="activo">
                            Activos
                        </option>

                        <option value="inactivo">
                            Inactivos
                        </option>

                    </select>

                </div>


                <!-- =================================
                     LISTA DE CUESTIONARIOS
                ================================== -->
                <div
                    class="cuestionarios-lista"
                    id="cuestionariosLista"
                >
                </div>


                <!-- =================================
                     PAGINACIÓN
                ================================== -->
                <div class="paginacion">

                    <button
                        class="pagina-btn"
                        id="paginaAnterior"
                    >
                        <i class="bi bi-chevron-left"></i>
                    </button>


                    <div
                        class="paginas"
                        id="paginas"
                    >
                    </div>


                    <button
                        class="pagina-btn"
                        id="paginaSiguiente"
                    >
                        <i class="bi bi-chevron-right"></i>
                    </button>

                </div>

            </section>



            <!-- =================================
                 COLUMNA DERECHA
            ================================== -->
            <aside class="columna-lateral">


                <!-- =================================
                     RESUMEN
                ================================== -->
                <section class="panel-lateral">

                    <div class="panel-header">

                        <div>
                            <h3>Resumen</h3>

                            <p>
                                Estado de los cuestionarios
                            </p>
                        </div>

                        <i class="bi bi-bar-chart-line"></i>

                    </div>


                    <div class="resumen-grid">


                        <!-- TOTAL -->
                        <div class="resumen-item">

                            <div class="resumen-icon purple">
                                <i class="bi bi-grid"></i>
                            </div>

                            <div>
                                <strong id="totalCuestionarios">
                                    12
                                </strong>

                                <span>
                                    Total
                                </span>
                            </div>

                        </div>


                        <!-- ACTIVOS -->
                        <div class="resumen-item">

                            <div class="resumen-icon green">
                                <i class="bi bi-check-lg"></i>
                            </div>

                            <div>
                                <strong id="totalActivos">
                                    9
                                </strong>

                                <span>
                                    Activos
                                </span>
                            </div>

                        </div>


                        <!-- INACTIVOS -->
                        <div class="resumen-item">

                            <div class="resumen-icon red">
                                <i class="bi bi-x-lg"></i>
                            </div>

                            <div>
                                <strong id="totalInactivos">
                                    3
                                </strong>

                                <span>
                                    Inactivos
                                </span>
                            </div>

                        </div>


                        <!-- RESPUESTAS -->
                        <div class="resumen-item">

                            <div class="resumen-icon blue">
                                <i class="bi bi-people"></i>
                            </div>

                            <div>
                                <strong id="totalRespuestas">
                                    248
                                </strong>

                                <span>
                                    Respuestas
                                </span>
                            </div>

                        </div>

                    </div>

                </section>



                <!-- =================================
                     ACCIONES RÁPIDAS
                ================================== -->
                <section class="panel-lateral acciones-panel">

                    <div class="panel-header">

                        <div>

                            <h3>
                                Acciones rápidas
                            </h3>

                            <p>
                                Gestiona tus cuestionarios
                            </p>

                        </div>

                    </div>


                    <div class="acciones-rapidas">


                        <button
                            class="accion-rapida"
                            id="accionNuevo"
                        >

                            <span class="accion-icon purple">
                                <i class="bi bi-plus-lg"></i>
                            </span>

                            <span>
                                Nuevo cuestionario
                            </span>

                            <i class="bi bi-chevron-right"></i>

                        </button>


                        <button
                            class="accion-rapida"
                            id="accionActivos"
                        >

                            <span class="accion-icon green">
                                <i class="bi bi-check-circle"></i>
                            </span>

                            <span>
                                Ver activos
                            </span>

                            <i class="bi bi-chevron-right"></i>

                        </button>


                        <button
                            class="accion-rapida"
                            id="accionInactivos"
                        >

                            <span class="accion-icon red">
                                <i class="bi bi-x-circle"></i>
                            </span>

                            <span>
                                Ver inactivos
                            </span>

                            <i class="bi bi-chevron-right"></i>

                        </button>


                    </div>

                </section>

            </aside>

        </div>

    </main>

</div>



<!-- =====================================================
     MODAL NUEVO CUESTIONARIO
====================================================== -->

<div
    class="modal-overlay"
    id="modalNuevo"
>

    <div class="modal modal-grande">

        <div class="modal-header">

            <div>
                <h2>Nuevo cuestionario</h2>

                <p>
                    Crea un nuevo cuestionario para la plataforma.
                </p>
            </div>

            <button
                class="modal-cerrar"
                data-close="modalNuevo"
            >
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        <div class="modal-body">

            <!-- INFORMACIÓN -->
            <div class="form-grid">


                <div class="form-group">

                    <label>
                        Nombre del cuestionario
                    </label>

                    <input
                        type="text"
                        id="nuevoNombre"
                        placeholder="Ej. Ansiedad Generalizada"
                    />

                </div>


                <div class="form-group">

                    <label>
                        Categoría
                    </label>

                    <select id="nuevoCategoria">

                        <option value="">
                            Seleccionar categoría
                        </option>

                        <option value="Ansiedad">
                            Ansiedad
                        </option>

                        <option value="Depresión">
                            Depresión
                        </option>

                        <option value="Estrés">
                            Estrés
                        </option>

                        <option value="Autoestima">
                            Autoestima
                        </option>

                        <option value="Sueño">
                            Sueño
                        </option>

                    </select>

                </div>


                <div class="form-group form-full">

                    <label>
                        Descripción
                    </label>

                    <textarea
                        id="nuevoDescripcion"
                        rows="3"
                        placeholder="Describe el objetivo del cuestionario..."
                    ></textarea>

                </div>


                <div class="form-group">

                    <label>
                        Número de preguntas
                    </label>

                    <input
                        type="number"
                        id="nuevoNumeroPreguntas"
                        min="1"
                        value="5"
                    />

                </div>


                <div class="form-group">

                    <label>
                        Puntaje máximo
                    </label>

                    <input
                        type="number"
                        id="nuevoPuntaje"
                        min="1"
                        value="20"
                    />

                </div>

            </div>


            <!-- PREGUNTAS -->
            <div class="preguntas-section">

                <div class="preguntas-heading">

                    <div>
                        <h3>Preguntas</h3>

                        <p>
                            Agrega las preguntas del cuestionario.
                        </p>
                    </div>

                    <button
                        class="btn-agregar-pregunta"
                        id="btnAgregarPregunta"
                    >
                        <i class="bi bi-plus"></i>
                        Agregar pregunta
                    </button>

                </div>


                <div
                    id="listaPreguntas"
                    class="lista-preguntas"
                >

                    <div class="pregunta-row">

                        <span class="numero-pregunta">
                            1
                        </span>

                        <input
                            type="text"
                            placeholder="Escribe la pregunta..."
                            class="input-pregunta"
                        />

                        <button
                            class="btn-eliminar-pregunta"
                            type="button"
                        >
                            <i class="bi bi-trash"></i>
                        </button>

                    </div>


                    <div class="pregunta-row">

                        <span class="numero-pregunta">
                            2
                        </span>

                        <input
                            type="text"
                            placeholder="Escribe la pregunta..."
                            class="input-pregunta"
                        />

                        <button
                            class="btn-eliminar-pregunta"
                            type="button"
                        >
                            <i class="bi bi-trash"></i>
                        </button>

                    </div>

                </div>

            </div>

        </div>


        <div class="modal-footer">

            <button
                class="btn-secundario"
                data-close="modalNuevo"
            >
                Cancelar
            </button>

            <button
                class="btn-principal"
                id="btnGuardarNuevo"
            >
                <i class="bi bi-check-lg"></i>
                Crear cuestionario
            </button>

        </div>

    </div>

</div>



<!-- =====================================================
     MODAL EDITAR
====================================================== -->

<div
    class="modal-overlay"
    id="modalEditar"
>

    <div class="modal modal-mediano">

        <div class="modal-header">

            <div>

                <h2>
                    Editar cuestionario
                </h2>

                <p>
                    Modifica la información del cuestionario.
                </p>

            </div>

            <button
                class="modal-cerrar"
                data-close="modalEditar"
            >
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        <div class="modal-body">

            <div class="form-group">

                <label>
                    Nombre
                </label>

                <input
                    type="text"
                    id="editarNombre"
                />

            </div>


            <div class="form-group">

                <label>
                    Categoría
                </label>

                <select id="editarCategoria">

                    <option value="Ansiedad">
                        Ansiedad
                    </option>

                    <option value="Depresión">
                        Depresión
                    </option>

                    <option value="Estrés">
                        Estrés
                    </option>

                    <option value="Autoestima">
                        Autoestima
                    </option>

                    <option value="Sueño">
                        Sueño
                    </option>

                </select>

            </div>


            <div class="form-group">

                <label>
                    Descripción
                </label>

                <textarea
                    id="editarDescripcion"
                    rows="4"
                ></textarea>

            </div>


            <div class="form-grid">

                <div class="form-group">

                    <label>
                        Número de preguntas
                    </label>

                    <input
                        type="number"
                        id="editarPreguntas"
                    />

                </div>


                <div class="form-group">

                    <label>
                        Puntaje máximo
                    </label>

                    <input
                        type="number"
                        id="editarPuntaje"
                    />

                </div>

            </div>

        </div>


        <div class="modal-footer">

            <button
                class="btn-secundario"
                data-close="modalEditar"
            >
                Cancelar
            </button>

            <button
                class="btn-principal"
                id="btnGuardarEdicion"
            >
                <i class="bi bi-check-lg"></i>
                Guardar cambios
            </button>

        </div>

    </div>

</div>



<!-- =====================================================
     MODAL ESTADÍSTICAS
====================================================== -->

<div
    class="modal-overlay"
    id="modalEstadisticas"
>

    <div class="modal modal-estadisticas">

        <div class="modal-header">

            <div>

                <span class="badge-categoria-modal" id="estadisticasCategoria">Categoría</span>

                <h2>
                    Estadísticas Clínicas
                </h2>

                <p id="estadisticasNombre">
                    Ansiedad Generalizada
                </p>

            </div>

            <button
                class="modal-cerrar"
                data-close="modalEstadisticas"
            >
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        <div class="modal-body">

            <div class="estadisticas-grid">

                <div class="estadistica-box">

                    <div class="estadistica-icon purple">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <strong id="statRespuestas">
                        0
                    </strong>

                    <span>
                        Respuestas
                    </span>

                </div>


                <div class="estadistica-box">

                    <div class="estadistica-icon green">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                    <strong id="statCompletados">
                        0%
                    </strong>

                    <span>
                        Finalización
