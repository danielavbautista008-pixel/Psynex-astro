                    </div>

                    <div class="distribucion-item">
                        <div class="distribucion-labels">
                            <span class="nivel-badge moderado"><i class="bi bi-emoji-neutral-fill"></i> Moderado</span>
                            <span class="porcentaje-val" id="porcentajeModerado">25%</span>
                        </div>
