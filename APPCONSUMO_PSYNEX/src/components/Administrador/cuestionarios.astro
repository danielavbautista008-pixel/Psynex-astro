<!-- =====================================================
     MODAL ELIMINAR (MÁS PEQUEÑO Y PROFESIONAL)
====================================================== -->

<div
    class="modal-overlay"
    id="modalEliminar"
>

    <div class="modal modal-pequeno modal-eliminar-card">

        <button
            class="modal-cerrar modal-cerrar-absoluto"
            data-close="modalEliminar"
        >
            <i class="bi bi-x-lg"></i>
        </button>

        <div class="confirmacion-icon-wrapper">
            <div class="confirmacion-icon danger">
                <i class="bi bi-trash3-fill"></i>
            </div>
        </div>

