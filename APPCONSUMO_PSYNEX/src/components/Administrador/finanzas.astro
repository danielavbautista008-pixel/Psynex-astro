---
import MenuAdmin from "../Menu/MenuAdmin.astro";
import "./finanzas.css";

import { apiGet } from "../../lib/api";

// ---------------------------------------------------------------
// Datos reales: GET /api/admin/finanzas/panel (solo Admin)
// Todo corresponde al MES ACTUAL.
// ---------------------------------------------------------------
const cookie = Astro.request.headers.get("cookie");
const respuesta = await apiGet(cookie, "/api/admin/finanzas/panel");
const panel = respuesta?.panel;

const pesos = (n: number) => "$" + Math.round(n ?? 0).toLocaleString("es-CO");

const ingresosMes = panel?.ingresosMes ?? 0;
const ingresosAnterior = panel?.ingresosMesAnterior ?? 0;
const cambio = ingresosAnterior > 0
  ? Math.round(((ingresosMes - ingresosAnterior) / ingresosAnterior) * 100)
  : null;
const cambioTexto = cambio === null ? "Sin datos del mes anterior" : `${Math.abs(cambio)}% vs. mes anterior`;
const cambioFlecha = (cambio ?? 0) >= 0 ? "bi-arrow-up" : "bi-arrow-down";

const comisionPorcentaje = panel?.comisionPorcentaje ?? 30;

// Citas gratis: tope del mes (lo configura el admin en recompensasperiodo)
const cupo = panel?.recompensas?.cupo ?? 0;
const usadas = panel?.recompensas?.otorgadas ?? 0;
const porcentajeUsado = cupo > 0 ? Math.round((usadas / cupo) * 100) : 0;
const disponibles = Math.max(cupo - usadas, 0);
// Cuánto representan las citas gratis frente a los ingresos del mes
const descuentoIngresos = ingresosMes > 0
  ? Math.round(((panel?.gastoRecompensas ?? 0) / ingresosMes) * 100)
  : 0;

// La relación empresa -> plan contratado todavía no existe en la base de
// datos (la está trabajando el módulo de Empresas), así que la tabla queda vacía.
const empresas: {
  iniciales: string; nombre: string; nit: string; plan: string;
  usuarios: string; monto: string; estado: string; estadoClass: string;
}[] = [];

const psicologos = ((panel?.rankingPsicologos ?? []) as any[]).map((p: any, i: number) => ({
  inicial: String(i + 1),
  nombre: p.nombre,
  citas: String(p.citas),
}));
---

<div class="finanzas-page">

  <MenuAdmin />

  <main class="finanzas-content">

    <!-- ENCABEZADO -->
    <header class="finanzas-header">

      <div class="header-info">

        <div class="header-icon">
          <i class="bi bi-wallet2"></i>
        </div>

        <div>
          <span class="section-label">FINANZAS</span>
          <h1>Finanzas</h1>
          <p>Consulta los ingresos, pagos y gastos de la plataforma.</p>
        </div>

      </div>

      <div class="periodo-general">
        <i class="bi bi-calendar3"></i>

        <select aria-label="Periodo general">
          <option>Septiembre 2026</option>
          <option>Agosto 2026</option>
          <option>Julio 2026</option>
        </select>

        <i class="bi bi-chevron-down"></i>
      </div>

    </header>


    <!-- RESUMEN FINANCIERO -->
    <section class="resumen-finanzas">

      <!-- PRINCIPAL -->
      <article class="finanza-card principal">

        <div class="finanza-card-top">

          <div class="finanza-icon">
            <i class="bi bi-wallet2"></i>
          </div>

          <span class="finanza-label">
            Ingresos totales este mes
          </span>

        </div>

        <strong class="finanza-value">
          {pesos(ingresosMes)}
        </strong>

        <div class="finanza-change">
          <i class={`bi ${cambioFlecha}`}></i>
          {cambioTexto}
        </div>

      </article>


      <!-- EMPRESAS -->
      <article class="finanza-card">

        <div class="finanza-card-top">

          <div class="finanza-icon empresas">
            <i class="bi bi-buildings"></i>
          </div>

          <span class="finanza-label">
            Pagado por empresas
          </span>

        </div>

        <strong class="finanza-value">
          {pesos(panel?.pagadoEmpresas)}
        </strong>

        <span class="finanza-description">
          Planes contratados
        </span>

      </article>


      <!-- PSICÓLOGOS -->
      <article class="finanza-card">

        <div class="finanza-card-top">

          <div class="finanza-icon psicologos">
            <i class="bi bi-person-check"></i>
          </div>

          <span class="finanza-label">
            Retenido de psicólogos
          </span>

        </div>

        <strong class="finanza-value">
          {pesos(panel?.comisionMes)}
        </strong>

        <span class="finanza-description">
          Comisión Psynex
        </span>

      </article>


      <!-- CITAS GRATIS -->
      <article class="finanza-card recompensa">

        <div class="finanza-card-top">

          <div class="finanza-icon">
            <i class="bi bi-gift"></i>
          </div>

          <span class="finanza-label">
            Gastado en citas gratis
          </span>

        </div>

        <strong class="finanza-value">
          {pesos(panel?.gastoRecompensas)}
        </strong>

        <span class="finanza-description">
          Fondo de recompensas
        </span>

      </article>

    </section>


    <!-- CONTENIDO PRINCIPAL -->
    <section class="finanzas-grid">

      <!-- EMPRESAS Y PLANES -->
      <section class="panel-finanzas empresas-panel">

        <div class="panel-header">

          <div class="panel-heading">

            <div class="panel-icon">
              <i class="bi bi-buildings"></i>
            </div>

            <div>
              <h2>Empresas y sus planes</h2>
              <p>
                Controla los planes contratados y el estado de pago.
              </p>
            </div>

          </div>

          <div class="periodo-panel">

            <span>Período</span>

            <select aria-label="Periodo de empresas">
              <option>Septiembre 2026</option>
              <option>Agosto 2026</option>
              <option>Julio 2026</option>
            </select>

          </div>

        </div>


        <div class="tabla-wrapper">

          <table class="tabla-empresas">

            <thead>
              <tr>
                <th>Empresa</th>
                <th>Plan contratado</th>
                <th>Monto mensual</th>
                <th>Estado de pago</th>
                <th></th>
              </tr>
            </thead>

            <tbody>

              {
                empresas.map((empresa) => (
                  <tr>

                    <td>

                      <div class="empresa-info">

                        <div class="empresa-avatar">
                          {empresa.iniciales}
                        </div>

                        <div>
                          <strong>{empresa.nombre}</strong>
                          <small>{empresa.nit}</small>
                        </div>

                      </div>

                    </td>

                    <td>

                      <div class="plan-info">
                        <strong>{empresa.plan}</strong>
                        <small>{empresa.usuarios}</small>
                      </div>

                    </td>

                    <td>
                      <span class="monto">
                        {empresa.monto}
                      </span>
                    </td>

                    <td>

                      <span class={`estado-pago ${empresa.estadoClass}`}>
                        <span></span>
                        {empresa.estado}
                      </span>

                    </td>

                    <td>
                      <button
                        class="btn-tabla"
                        aria-label={`Opciones de ${empresa.nombre}`}
                      >
                        <i class="bi bi-three-dots-vertical"></i>
                      </button>
                    </td>

                  </tr>
                ))
              }

            </tbody>

          </table>

        </div>


        <div class="tabla-footer">

          <span>
            Mostrando {empresas.length} empresas
          </span>

          <div class="paginacion">

            <button disabled>
              <i class="bi bi-chevron-left"></i>
            </button>

            <button class="activo">1</button>

            <button disabled>
              <i class="bi bi-chevron-right"></i>
            </button>

          </div>

        </div>

      </section>


      <!-- COLUMNA DERECHA -->
      <div class="columna-finanzas">

        <!-- DESCUENTO POR TERAPIA -->
        <section class="panel-finanzas descuento-panel">

          <div class="panel-heading">

            <div class="panel-icon">
              <i class="bi bi-percent"></i>
            </div>

            <div>
              <h2>Descuento por terapia</h2>

              <p>
                Por cada cita se descuenta un porcentaje de la tarifa.
                Este es el total de comisión de Psynex en el mes.
              </p>
            </div>

          </div>


          <div class="comision-resumen">

            <div class="comision-icon">
              <i class="bi bi-percent"></i>
            </div>

            <div class="comision-dato">

              <strong>{comisionPorcentaje}% por terapia</strong>

              <span>
                Porcentaje de comisión
              </span>

            </div>

            <div class="comision-separador"></div>

            <div class="comision-dato monto-comision">

              <strong>{pesos(panel?.comisionMes)}</strong>

              <span>
                Total en el mes
              </span>

            </div>

          </div>


          <div class="ranking-header">

            <h3>
              Psicólogos con más citas atendidas
            </h3>

            <button>
              Ver todos
              <i class="bi bi-chevron-right"></i>
            </button>

          </div>


          <div class="ranking-list">

            {
              psicologos.map((psicologo) => (
                <div class="ranking-item">

                  <span class="ranking-number">
                    {psicologo.inicial}
                  </span>

                  <span class="ranking-name">
                    {psicologo.nombre}
                  </span>

                  <strong>
                    {psicologo.citas} citas
                  </strong>

                </div>
              ))
            }

          </div>

        </section>


        <!-- FONDO DE CITAS GRATIS -->
        <section class="panel-finanzas recompensa-panel">

          <div class="panel-heading">

            <div class="panel-icon recompensa-icon">
              <i class="bi bi-gift"></i>
            </div>

            <div>
              <h2>Fondo de citas gratuitas</h2>

              <p>
                Controla el uso del fondo y el porcentaje de descuento
                de los ingresos.
              </p>
            </div>

          </div>


          <div class="recompensa-resumen">

            <div>
              <strong>{cupo}</strong>
              <span>Tope mensual</span>
            </div>

            <div>
              <strong>{usadas}</strong>
              <span>Usadas este mes</span>
            </div>

            <div>
              <strong>{descuentoIngresos}%</strong>
              <span>Descuento en ingresos</span>
            </div>

          </div>


          <div class="progreso-container">

            <div class="progreso-barra">
              <span style={`width: ${porcentajeUsado}%`}></span>
            </div>

            <div class="progreso-info">

              <span>
                {porcentajeUsado}% del total
              </span>

              <span>
                {disponibles} disponibles
              </span>

            </div>

          </div>

        </section>

      </div>

    </section>

  </main>

</div>