---
import MenuAdmin from "../Menu/MenuAdmin.astro";
import "./verificarempresas.css";
import { apiGet, API_URL } from "../../lib/api";

// ---------------------------------------------------------------
// Datos reales: GET /api/admin/empresas?estado=todos y /resumen
// ---------------------------------------------------------------
const cookie = Astro.request.headers.get("cookie");
const [respuesta, datosResumen] = await Promise.all([
  apiGet(cookie, "/api/admin/empresas?estado=todos&porPagina=100"),
  apiGet(cookie, "/api/admin/empresas/resumen"),
]);

const haceCuanto = (fecha: string) => {
  const dias = Math.floor((Date.now() - new Date(fecha).getTime()) / 86_400_000);
  if (dias <= 0) return "hoy";
  if (dias === 1) return "hace 1 día";
  if (dias < 30) return `hace ${dias} días`;
  const meses = Math.floor(dias / 30);
  return meses === 1 ? "hace 1 mes" : `hace ${meses} meses`;
};

const iniciales = (nombre: string) =>
  nombre.split(" ").filter(Boolean).slice(0, 2).map((p) => p[0]!.toUpperCase()).join("");

const COLORES = ["purple", "blue", "green"];

// La API responde { empresas: [...] }
const empresas = ((respuesta?.empresas ?? respuesta?.datos ?? []) as any[]).map((e: any, i: number) => {
  const nombre = e.NombreEmpresa || e.NombreCompleto;
  const activa = Number(e.EstaVerificada) === 1;
  const hace = haceCuanto(e.CreadoEn);
  return {
    id: e.PerfileId, // el backend identifica la empresa por su PerfileId
    nombre,
    iniciales: iniciales(nombre),
    nit: e.Nit ? `NIT: ${e.Nit}` : "NIT: —",
    ciudad: e.Direccion || "—",
    estado: activa ? "activa" : "pendiente",
    registro: activa ? `Activa ${hace}` : hace.charAt(0).toUpperCase() + hace.slice(1),
    color: COLORES[i % COLORES.length],
    // Logo (si lo subió): GET /api/admin/empresas/:perfileId/logo
    logo: Number(e.TieneLogo ?? 0) === 1
      ? `${API_URL}/api/admin/empresas/${encodeURIComponent(e.PerfileId)}/logo`
      : "",
  };
});

const resumen = datosResumen?.resumen ?? { total: 0, verificadas: 0, pendientes: 0 };
// La base de datos todavía no distingue "rechazada" de "pendiente" (ver notas).
const rechazadas = 0;
---

<div class="empresas-page">

    <MenuAdmin />

    <main class="empresas-content">

        <!-- =====================================================
             ENCABEZADO
        ====================================================== -->

        <header class="empresas-header">

            <div class="header-left">

                <div class="header-icon">
                    <i class="bi bi-building-check"></i>
                </div>

                <div>
                    <h1>Verificar empresas</h1>

                    <p>
                        Revisa y valida la documentación de las empresas
                        registradas en la plataforma.
                    </p>
                </div>

            </div>

            <!-- TRES PUNTICOS -->
            <button
                class="btn-resumen"
                id="btnResumen"
                aria-label="Mostrar resumen"
            >
                <i class="bi bi-three-dots-vertical"></i>
            </button>

        </header>


        <!-- =====================================================
             FILTROS
        ====================================================== -->

        <section class="filtros-empresas">

            <div class="busqueda">

                <i class="bi bi-search"></i>

                <input
                    type="text"
                    id="buscarEmpresa"
                    placeholder="Buscar empresa..."
                />

            </div>


            <select id="filtroCiudad">

                <option value="todas">
                    Todas las ciudades
                </option>

                <option value="bogota">
                    Bogotá
                </option>

                <option value="medellin">
                    Medellín
                </option>

                <option value="cali">
                    Cali
                </option>

                <option value="bucaramanga">
                    Bucaramanga
                </option>

            </select>


            <select id="filtroEstado">

                <option value="todos">
                    Todos los estados
                </option>

                <option value="pendiente">
                    Pendientes
                </option>

                <option value="activa">
                    Activas
                </option>

                <option value="rechazada">
                    Rechazadas
                </option>

            </select>

        </section>


        <!-- =====================================================
             PESTAÑAS
        ====================================================== -->

        <div class="tabs-empresas">

            <button
                class="tab-empresa activa"
                data-tab="pendientes"
            >
                <i class="bi bi-clock"></i>

                Pendientes

                <span id="contadorPendientes">
                    {resumen.pendientes}
                </span>

            </button>


            <button
                class="tab-empresa"
                data-tab="activas"
            >
                <i class="bi bi-check-circle"></i>

                Activas

                <span id="contadorActivas">
                    {resumen.verificadas}
                </span>

            </button>

        </div>


        <!-- =====================================================
             CONTENIDO PRINCIPAL
        ====================================================== -->

        <section class="empresas-layout">

            <!-- =================================================
                 LISTA
            ================================================== -->

            <div class="empresas-lista">

                <div class="lista-header">

                    <div>
                        <h2 id="tituloLista">
                            Empresas pendientes
                        </h2>

                        <p id="subtituloLista">
                            Revisa las solicitudes que esperan validación.
                        </p>
                    </div>

                    <i class="bi bi-buildings"></i>

                </div>


                {empresas.map((e) => (

                <article
                    class={`empresa-item ${e.estado === "activa" ? "empresa-activa" : ""}`}
                    data-id={e.id}
                    data-nombre={e.nombre}
                    data-nit={e.nit}
                    data-registro={e.registro}
                    data-ciudad={e.ciudad}
                    data-estado={e.estado}
                    data-logo={e.logo}
                >

                    <div class={`empresa-logo logo-${e.color}`}>
                        {e.estado === "activa"
                            ? <span>{e.iniciales}</span>
                            : <i class="bi bi-buildings"></i>}
                        {e.logo && <img src={e.logo} alt="" loading="lazy" onerror="this.remove()" />}
                    </div>

                    <div class="empresa-info">

                        <div class="empresa-nombre-row">

                            <h3>
                                {e.nombre}
                            </h3>

                            <span class={`estado estado-${e.estado}`}>
                                <span></span>
                                {e.estado === "activa" ? "Activa" : "Pendiente"}
                            </span>

                        </div>

                        <p class="nit">
                            {e.nit}
                        </p>

                        <div class="empresa-documentos">

                            <span>
                                <i class="bi bi-file-earmark-text"></i>
                                Cámara de Comercio
                            </span>

                            <span>
                                <i class="bi bi-file-earmark-text"></i>
                                RUT
                            </span>

                        </div>

                        <div class="empresa-meta">

                            <span>
                                <i class="bi bi-calendar3"></i>
                                {e.registro}
                            </span>

                            <span>
                                <i class="bi bi-geo-alt"></i>
                                {e.ciudad}
                            </span>

                        </div>

                    </div>

                </article>

                ))}

            </div>


            <!-- =================================================
                 DETALLE
            ================================================== -->

            <div class="empresa-detalle" id="empresaDetalle">

                <!-- SE LLENA AL SELECCIONAR -->

                <div class="detalle-vacio" id="detalleVacio">

                    <div class="detalle-vacio-icon">
                        <i class="bi bi-building-check"></i>
                    </div>

                    <h2>
                        Selecciona una empresa
                    </h2>

                    <p>
                        Selecciona una empresa de la lista para revisar
                        su información y documentación.
                    </p>

                </div>


                <!-- =================================================
                     DETALLE DE EMPRESA
                ================================================== -->

                <div
                    class="detalle-contenido"
                    id="detalleContenido"
                    style="display:none;"
                >

                    <div class="detalle-header">

                        <div class="detalle-identidad">

                            <div
                                class="detalle-logo logo-purple"
                                id="detalleLogo"
                            >
                                <i class="bi bi-buildings"></i>
                            </div>

                            <div>

                                <div class="detalle-nombre">

                                    <h2 id="detalleNombre">
                                        Nova Soluciones S.A.S.
                                    </h2>

                                    <span
                                        class="estado estado-pendiente"
                                        id="detalleEstado"
                                    >
                                        <span></span>
                                        Pendiente
                                    </span>

                                </div>

                                <p id="detalleNit">
                                    NIT: 901.234.567-8
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="detalle-linea"></div>


                    <!-- INFORMACIÓN -->

                    <div class="info-empresa">

                        <div class="info-box">

                            <div class="info-icon">
                                <i class="bi bi-calendar3"></i>
                            </div>

                            <div>
                                <small>Registro</small>
                                <strong id="detalleRegistro">
                                    Hace 2 días
                                </strong>
                            </div>

                        </div>


                        <div class="info-box">

                            <div class="info-icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>

                            <div>
                                <small>Ciudad</small>
                                <strong id="detalleCiudad">
                                    Bogotá, Colombia
                                </strong>
                            </div>

                        </div>

                    </div>


                    <!-- DOCUMENTOS -->

                    <div class="documentos-section">

                        <div class="documentos-header">

                            <div>

                                <h3>
                                    Documentos
                                </h3>

                                <p>
                                    Revisa la documentación antes
                                    de tomar una decisión.
                                </p>

                            </div>

                            <span id="contadorDocumentosEmpresa">
                                0 documentos
                            </span>

                        </div>


                        <!-- Se llena con los documentos reales al elegir una empresa
                             (GET /api/admin/empresas/:perfileId/documentos) -->
                        <div id="listaDocumentosEmpresa"></div>

                    </div>


                    <!-- ACCIONES -->

                    <p class="decision-hecha" id="decisionHecha" hidden>
                        Esta empresa ya fue verificada y está activa.
                    </p>

                    <div class="detalle-acciones" id="detalleAcciones">

                        <button
                            class="btn-rechazar"
                            id="btnRechazar"
                        >
                            <i class="bi bi-x-lg"></i>
                            Rechazar
                        </button>

                        <button
                            class="btn-activar"
                            id="btnActivar"
                        >
                            <i class="bi bi-check-lg"></i>
                            Activar empresa
                        </button>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- =========================================================
         PANEL RESUMEN
    ========================================================== -->

    <aside
        class="resumen-panel"
        id="resumenPanel"
    >

        <div class="resumen-header">

            <div>

                <h2>
                    Resumen
                </h2>

                <p>
                    Estado de las empresas
                </p>

            </div>

            <button id="cerrarResumen">
                <i class="bi bi-x-lg"></i>
            </button>

        </div>


        <div class="resumen-grid">

            <div class="resumen-card">

                <div class="resumen-icon icon-purple">
                    <i class="bi bi-buildings"></i>
                </div>

                <strong>{resumen.total}</strong>

                <span>Total</span>

            </div>


            <div class="resumen-card">

                <div class="resumen-icon icon-green">
                    <i class="bi bi-check-lg"></i>
                </div>

                <strong>{resumen.verificadas}</strong>

                <span>Activas</span>

            </div>


            <div class="resumen-card">

                <div class="resumen-icon icon-yellow">
                    <i class="bi bi-clock"></i>
                </div>

                <strong>{resumen.pendientes}</strong>

                <span>Pendientes</span>

            </div>


            <div class="resumen-card">

                <div class="resumen-icon icon-red">
                    <i class="bi bi-x-lg"></i>
                </div>

                <strong>{rechazadas}</strong>

                <span>Rechazadas</span>

            </div>

        </div>

    </aside>


    <!-- =========================================================
         MODAL DOCUMENTOS
    ========================================================== -->

    <div
        class="modal-overlay"
        id="modalDocumentos"
    >

        <div class="modal modal-documentos">

            <div class="modal-header">

                <div>

                    <h2>
                        Documentos de la empresa
                    </h2>

                    <p>
                        Nova Soluciones S.A.S.
                    </p>

                </div>

                <button
                    class="cerrar-modal"
                    data-cerrar="modalDocumentos"
                >
                    <i class="bi bi-x-lg"></i>
                </button>

            </div>


            <div class="modal-body">

                <div class="modal-empresa">

                    <div class="modal-empresa-icon">
                        <i class="bi bi-buildings"></i>
                    </div>

                    <div>

                        <strong>
                            Nova Soluciones S.A.S.
                        </strong>

                        <span>
                            NIT: 901.234.567-8
                        </span>

                    </div>

                </div>


                <div class="modal-documento">

                    <div class="documento-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>

                        <strong>
                            Cámara de Comercio
                        </strong>

                        <small>
                            Certificado de existencia
                            y representación legal
                        </small>

                    </div>

                    <div class="documento-actions">

                        <button class="btn-documento btn-ver">
                            <i class="bi bi-eye"></i>
                            Ver
                        </button>

                        <button class="btn-documento">
                            <i class="bi bi-download"></i>
                            Descargar
                        </button>

                    </div>

                </div>


                <div class="modal-documento">

                    <div class="documento-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>

                        <strong>
                            RUT
                        </strong>

                        <small>
                            Registro Único Tributario
                        </small>

                    </div>

                    <div class="documento-actions">

                        <button class="btn-documento btn-ver">
                            <i class="bi bi-eye"></i>
                            Ver
                        </button>

                        <button class="btn-documento">
                            <i class="bi bi-download"></i>
                            Descargar
                        </button>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button
                    class="btn-cancelar"
                    data-cerrar="modalDocumentos"
                >
                    Cerrar
                </button>

            </div>

        </div>

    </div>


    <!-- =========================================================
         AVISO PEQUEÑO (reemplaza las alertas del navegador)
    ========================================================== -->

    <div class="aviso-admin" id="avisoAdmin" hidden>
        <div class="aviso-admin-caja" role="alertdialog" aria-modal="true" aria-labelledby="avisoAdminTitulo">
            <h3 id="avisoAdminTitulo">Listo</h3>
            <p id="avisoAdminTexto"></p>
            <button type="button" id="avisoAdminCerrar">Entendido</button>
        </div>
    </div>


    <!-- =========================================================
         MODAL ACTIVAR
    ========================================================== -->

    <div
        class="modal-overlay"
        id="modalActivar"
    >

        <div class="modal modal-pequeno">

            <div class="modal-header">

                <div>

                    <h2>
                        Activar empresa
                    </h2>

                    <p>
                        Confirma la activación.
                    </p>

                </div>

                <button
                    class="cerrar-modal"
                    data-cerrar="modalActivar"
                >
                    <i class="bi bi-x-lg"></i>
                </button>

            </div>


            <div class="modal-body">

                <div class="confirmacion-icon">
                    <i class="bi bi-check-lg"></i>
                </div>

                <h3>
                    ¿Activar esta empresa?
                </h3>

                <p class="confirmacion-texto">
                    La empresa quedará activa en la plataforma.
                </p>

            </div>


            <div class="modal-footer">

                <button
                    class="btn-cancelar"
                    data-cerrar="modalActivar"
                >
                    Cancelar
                </button>

                <button
                    class="btn-activar"
                    id="confirmarActivar"
                >
                    <i class="bi bi-check-lg"></i>
                    Activar empresa
                </button>

            </div>

        </div>

    </div>


    <!-- =========================================================
         MODAL RECHAZAR
    ========================================================== -->

    <div
        class="modal-overlay"
        id="modalRechazar"
    >

        <div class="modal modal-pequeno">

            <div class="modal-header">

                <div>

                    <h2>
                        Rechazar empresa
                    </h2>

                    <p>
                        Indica el motivo del rechazo.
                    </p>

                </div>

                <button
                    class="cerrar-modal"
                    data-cerrar="modalRechazar"
                >
                    <i class="bi bi-x-lg"></i>
                </button>

            </div>


            <div class="modal-body">

                <div class="rechazo-alerta">

                    <i class="bi bi-exclamation-circle"></i>

                    <span>
                        La empresa podrá corregir la documentación
                        y volver a solicitar la validación.
                    </span>

                </div>


                <label>
                    Motivo del rechazo
                </label>

                <textarea
                    id="motivoRechazo"
                    placeholder="Escribe el motivo del rechazo..."
                ></textarea>

            </div>


            <div class="modal-footer">

                <button
                    class="btn-cancelar"
                    data-cerrar="modalRechazar"
                >
                    Cancelar
                </button>

                <button
                    class="btn-rechazar"
                    id="confirmarRechazo"
                >
                    <i class="bi bi-x-lg"></i>
                    Rechazar
                </button>

            </div>

        </div>

    </div>


    <!-- =========================================================
         MODAL EDITAR PLAN
    ========================================================== -->

    <div
        class="modal-overlay"
        id="modalPlan"
    >

        <div class="modal modal-pequeno">

            <div class="modal-header">

                <div>

                    <h2>
                        Editar plan
                    </h2>

                    <p>
                        Modifica la configuración de la empresa.
                    </p>

                </div>

                <button
                    class="cerrar-modal"
                    data-cerrar="modalPlan"
                >
                    <i class="bi bi-x-lg"></i>
                </button>

            </div>


            <div class="modal-body">

                <div class="form-group">

                    <label>
                        Plan
                    </label>

                    <select>

                        <option>
                            Plan 10 citas/mes
                        </option>

                        <option selected>
                            Plan 20 citas/mes
                        </option>

                        <option>
                            Plan 50 citas/mes
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Precio mensual
                    </label>

                    <input
                        type="number"
                        value="200000"
                    />

                </div>

            </div>


            <div class="modal-footer">

                <button
                    class="btn-cancelar"
                    data-cerrar="modalPlan"
                >
                    Cancelar
                </button>

                <button class="btn-activar">

                    <i class="bi bi-check-lg"></i>

                    Guardar cambios

                </button>

            </div>

        </div>

    </div>

</div>


<script>
// @ts-nocheck
    import { API_URL } from "../../lib/api";

    // PerfileId de la empresa seleccionada
    let empresaSeleccionadaId = "";


    /* =====================================================
       AVISO PEQUEÑO
    ====================================================== */

    function avisar(texto, titulo) {
        document.getElementById("avisoAdminTitulo").textContent = titulo || "Listo";
        document.getElementById("avisoAdminTexto").textContent = texto;
        document.getElementById("avisoAdmin").hidden = false;
        document.getElementById("avisoAdminCerrar").focus();
    }

    document.getElementById("avisoAdminCerrar")?.addEventListener("click", () => {
        document.getElementById("avisoAdmin").hidden = true;
    });

    document.getElementById("avisoAdmin")?.addEventListener("click", (event) => {
        if (event.target === event.currentTarget) event.currentTarget.hidden = true;
    });


    /* =====================================================
       LOGO Y BOTONES DEL DETALLE
    ====================================================== */

    function pintarLogoDetalle(empresa) {
        const caja = document.getElementById("detalleLogo");
        if (!caja) return;
        caja.innerHTML = '<i class="bi bi-buildings"></i>';
        const logo = empresa.getAttribute("data-logo");
        if (logo) {
            const img = document.createElement("img");
            img.src = logo;
            img.alt = "";
            img.addEventListener("error", () => img.remove());
            caja.append(img);
        }
    }

    // Si la empresa ya está activa, los botones Activar/Rechazar desaparecen
    function pintarAcciones(estado) {
        const activa = estado === "activa";
        document.getElementById("detalleAcciones").hidden = activa;
        document.getElementById("decisionHecha").hidden = !activa;
    }

    /* =====================================================
       RESUMEN
    ====================================================== */

    const btnResumen = document.getElementById("btnResumen");
    const resumenPanel = document.getElementById("resumenPanel");
    const cerrarResumen = document.getElementById("cerrarResumen");

    btnResumen?.addEventListener("click", () => {

        resumenPanel?.classList.toggle("mostrar");

    });


    cerrarResumen?.addEventListener("click", () => {

        resumenPanel?.classList.remove("mostrar");

    });


    /* =====================================================
       SELECCIONAR EMPRESA
    ====================================================== */

    const empresas = document.querySelectorAll(".empresa-item");

    const detalleVacio =
        document.getElementById("detalleVacio");

    const detalleContenido =
        document.getElementById("detalleContenido");


    empresas.forEach((empresa) => {

        empresa.addEventListener("click", () => {

            empresas.forEach((item) => {

                item.classList.remove("seleccionada");

            });

            empresa.classList.add("seleccionada");

            detalleVacio.style.display = "none";

            detalleContenido.style.display = "block";


            const nombre =
                empresa.getAttribute("data-nombre");

            empresaSeleccionadaId =
                empresa.getAttribute("data-id") || "";

            cargarDocumentos(empresaSeleccionadaId);

            document.getElementById("detalleNit").textContent =
                empresa.getAttribute("data-nit") || "";

            document.getElementById("detalleRegistro").textContent =
                empresa.getAttribute("data-registro") || "";

            document.getElementById("detalleCiudad").textContent =
                empresa.getAttribute("data-ciudad") || "";

            const estado =
                empresa.getAttribute("data-estado");


            document.getElementById("detalleNombre").textContent =
                nombre || "Empresa";

            pintarLogoDetalle(empresa);

            pintarAcciones(estado);


            if (estado === "activa") {

                document.getElementById("detalleEstado").innerHTML =
                    "<span></span> Activa";

                document.getElementById("detalleEstado").className =
                    "estado estado-activa";

            }

            else if (estado === "pendiente") {

                document.getElementById("detalleEstado").innerHTML =
                    "<span></span> Pendiente";

                document.getElementById("detalleEstado").className =
                    "estado estado-pendiente";

            }

        });

    });


    /* =====================================================
       MODALES
    ====================================================== */

    function abrirModal(id) {

        const modal = document.getElementById(id);

        if (modal) {

            modal.classList.add("mostrar");

            document.body.classList.add("modal-abierto");

        }

    }


    function cerrarModal(id) {

        const modal = document.getElementById(id);

        if (modal) {

            modal.classList.remove("mostrar");

            document.body.classList.remove("modal-abierto");

        }

    }


    document.querySelectorAll("[data-cerrar]").forEach((boton) => {

        boton.addEventListener("click", () => {

            const id =
                boton.getAttribute("data-cerrar");

            cerrarModal(id);

        });

    });


    document.querySelectorAll(".modal-overlay").forEach((modal) => {

        modal.addEventListener("click", (event) => {

            if (event.target === modal) {

                modal.classList.remove("mostrar");

                document.body.classList.remove("modal-abierto");

            }

        });

    });


    /* =====================================================
       DOCUMENTOS REALES DE LA EMPRESA
       Lista:   GET /api/admin/empresas/:perfileId/documentos
       Archivo: GET /api/admin/empresas/documentos/:documentoId
    ====================================================== */

    const NOMBRES_DOCUMENTO = {
        rut: ["RUT", "Registro Único Tributario"],
        camara_comercio: ["Cámara de Comercio", "Certificado de existencia y representación legal"],
    };

    const urlDocumento = (id) =>
        `${API_URL}/api/admin/empresas/documentos/${encodeURIComponent(id)}`;

    async function descargarDocumento(doc) {
        try {
            const res = await fetch(urlDocumento(doc.DocumentoArchivoId), { credentials: "include" });
            if (!res.ok) throw new Error(String(res.status));
            const blob = await res.blob();
            const enlace = document.createElement("a");
            enlace.href = URL.createObjectURL(blob);
            enlace.download = doc.NombreOriginal || "documento";
            enlace.click();
            setTimeout(() => URL.revokeObjectURL(enlace.href), 1000);
        } catch (error) {
            console.error(error);
            avisar("No se pudo descargar el documento.", "Error");
        }
    }

    async function cargarDocumentos(perfileId) {
        const lista = document.getElementById("listaDocumentosEmpresa");
        const contador = document.getElementById("contadorDocumentosEmpresa");
        if (!lista) return;
        lista.innerHTML = "<p class=\"documentos-vacio\">Cargando documentos...</p>";

        let documentos = [];
        try {
            const res = await fetch(`${API_URL}/api/admin/empresas/${encodeURIComponent(perfileId)}/documentos`, {
                credentials: "include",
            });
            const data = res.ok ? await res.json() : null;
            documentos = data?.documentos ?? [];
        } catch (error) {
            console.error(error);
        }

        // Si se eligió otra empresa mientras cargaba, no se pinta
        if (perfileId !== empresaSeleccionadaId) return;

        if (contador) {
            contador.textContent = `${documentos.length} ${documentos.length === 1 ? "documento" : "documentos"}`;
        }

        lista.replaceChildren();
        if (!documentos.length) {
            const vacio = document.createElement("p");
            vacio.className = "documentos-vacio";
            vacio.textContent = "Esta empresa no ha subido documentos.";
            lista.append(vacio);
            return;
        }

        documentos.forEach((doc) => {
            const [titulo, descripcion] = NOMBRES_DOCUMENTO[doc.Tipo] ?? [doc.Tipo, ""];

            const fila = document.createElement("div");
            fila.className = "documento-row";

            const icono = document.createElement("div");
            icono.className = "documento-icon";
            icono.innerHTML = '<i class="bi bi-file-earmark-text"></i>';

            const info = document.createElement("div");
            info.className = "documento-info";
            const strong = document.createElement("strong");
            strong.textContent = titulo;
            const small = document.createElement("small");
            small.textContent = descripcion ? `${descripcion} · ${doc.NombreOriginal}` : doc.NombreOriginal;
            info.append(strong, small);

            const acciones = document.createElement("div");
            acciones.className = "documento-actions";

            const ver = document.createElement("button");
            ver.type = "button";
            ver.className = "btn-documento btn-ver";
            ver.innerHTML = '<i class="bi bi-eye"></i> Ver';
            ver.addEventListener("click", (event) => {
                event.stopPropagation();
                window.open(urlDocumento(doc.DocumentoArchivoId), "_blank", "noopener");
            });

            const bajar = document.createElement("button");
            bajar.type = "button";
            bajar.className = "btn-documento";
            bajar.innerHTML = '<i class="bi bi-download"></i> Descargar';
            bajar.addEventListener("click", (event) => {
                event.stopPropagation();
                descargarDocumento(doc);
            });

            acciones.append(ver, bajar);
            fila.append(icono, info, acciones);
            lista.append(fila);
        });
    }


    /* =====================================================
       BACKEND: PATCH /api/admin/empresas/:perfileId/verificacion
       Devuelve true si se guardó. El backend también le envía
       un correo a la empresa con la decisión.
    ====================================================== */
    async function enviarDecision(aprobado, motivoRechazo) {
        if (!empresaSeleccionadaId) {
            avisar("Selecciona una empresa de la lista.", "Falta la empresa");
            return false;
        }
        try {
            const res = await fetch(
                `${API_URL}/api/admin/empresas/${empresaSeleccionadaId}/verificacion`,
                {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify(
                        aprobado ? { aprobado: true } : { aprobado: false, motivoRechazo }
                    ),
                }
            );
            if (res.status === 401) {
                window.location.href = "/Inicio/login";
                return false;
            }
            if (!res.ok) {
                const data = await res.json().catch(() => ({}));
                avisar(
                    Array.isArray(data.error) ? data.error.join(", ")
                    : (data.error || "No se pudo guardar la decisión."),
                    "No se pudo guardar"
                );
                return false;
            }
            return true;
        } catch (error) {
            console.error(error);
            avisar("No se pudo conectar con el servidor.", "Sin conexión");
            return false;
        }
    }

    /* =====================================================
       ACTIVAR
    ====================================================== */

    document
        .getElementById("btnActivar")
        ?.addEventListener("click", () => {

            abrirModal("modalActivar");

        });


    document
        .getElementById("confirmarActivar")
        ?.addEventListener("click", async () => {

            const guardado = await enviarDecision(true);

            if (!guardado) {

                return;

            }

            cerrarModal("modalActivar");

            // Se actualiza en pantalla sin recargar: queda activa y sin botones
            const item = document.querySelector(
                `.empresa-item[data-id="${CSS.escape(empresaSeleccionadaId)}"]`
            );
            if (item) {
                item.setAttribute("data-estado", "activa");
                item.classList.add("empresa-activa");
                const badge = item.querySelector(".estado");
                if (badge) {
                    badge.className = "estado estado-activa";
                    badge.innerHTML = "<span></span> Activa";
                }
            }
            const detalleEstado = document.getElementById("detalleEstado");
            detalleEstado.className = "estado estado-activa";
            detalleEstado.innerHTML = "<span></span> Activa";
            pintarAcciones("activa");

            avisar(
                "La empresa quedó activa. Le enviamos un correo con la noticia.",
                "Empresa activada"
            );

        });


    /* =====================================================
       RECHAZAR
    ====================================================== */

    document
        .getElementById("btnRechazar")
        ?.addEventListener("click", () => {

            abrirModal("modalRechazar");

        });


    document
        .getElementById("confirmarRechazo")
        ?.addEventListener("click", async () => {

            const motivo =
                document.getElementById("motivoRechazo").value.trim();


            if (motivo.length < 5) {

                avisar("Escribe el motivo del rechazo (mínimo 5 caracteres).", "Falta el motivo");

                return;

            }


            const guardado = await enviarDecision(false, motivo);


            if (!guardado) {


                return;


            }


            cerrarModal("modalRechazar");

            document.getElementById("motivoRechazo").value = "";

            avisar(
                "La solicitud fue rechazada. Le enviamos un correo con el motivo.",
                "Solicitud rechazada"
            );

        });


    /* =====================================================
       PESTAÑAS
    ====================================================== */

    const tabs =
        document.querySelectorAll(".tab-empresa");


    tabs.forEach((tab) => {

        tab.addEventListener("click", () => {

            tabs.forEach((item) => {

                item.classList.remove("activa");

            });

            tab.classList.add("activa");

            const tipo =
                tab.getAttribute("data-tab");


            empresas.forEach((empresa) => {

                const estado =
                    empresa.getAttribute("data-estado");

                if (tipo === "pendientes") {

                    empresa.style.display =
                        estado === "pendiente"
                            ? "flex"
                            : "none";

                }

                else {

                    empresa.style.display =
                        estado === "activa"
                            ? "flex"
                            : "none";

                }

            });


            const titulo =
                document.getElementById("tituloLista");

            const subtitulo =
                document.getElementById("subtituloLista");


            if (tipo === "pendientes") {

                titulo.textContent =
                    "Empresas pendientes";

                subtitulo.textContent =
                    "Revisa las solicitudes que esperan validación.";

            }

            else {

                titulo.textContent =
                    "Empresas activas";

                subtitulo.textContent =
                    "Empresas que ya fueron verificadas y activadas.";

            }

        });

    });


    /* =====================================================
       BUSCADOR
    ====================================================== */

    const buscador =
        document.getElementById("buscarEmpresa");


    buscador?.addEventListener("input", () => {

        const texto =
            buscador.value.toLowerCase().trim();


        empresas.forEach((empresa) => {

            const nombre =
                empresa.getAttribute("data-nombre")?.toLowerCase() || "";


            if (nombre.includes(texto)) {

                empresa.style.display = "flex";

            }

            else {

                empresa.style.display = "none";

            }

        });

    });

</script>