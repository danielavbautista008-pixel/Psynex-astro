---
import MenuAdmin from "../Menu/MenuAdmin.astro";
import "./verificarpsicologos.css";
import { apiGet, API_URL } from "../../lib/api";

// ---------------------------------------------------------------
// Datos reales: GET /api/admin/psicologos?estado=todos (solo Admin)
// Se convierten a la misma forma que usaba el arreglo de ejemplo,
// y se le pasan al <script> de abajo con define:vars.
// ---------------------------------------------------------------
const cookie = Astro.request.headers.get("cookie");
const respuesta = await apiGet(cookie, "/api/admin/psicologos?estado=todos&porPagina=100");

const COLORES = ["morado", "azul", "rosa", "verde"];

// "Hace 3 días", "Hoy", "Hace 2 meses"...
const haceCuanto = (fecha: string) => {
  const dias = Math.floor((Date.now() - new Date(fecha).getTime()) / 86_400_000);
  if (dias <= 0) return "Hoy";
  if (dias === 1) return "Hace 1 día";
  if (dias < 30) return `Hace ${dias} días`;
  const meses = Math.floor(dias / 30);
  return meses === 1 ? "Hace 1 mes" : `Hace ${meses} meses`;
};

const estadoDe = (p: any) =>
  p.EstaVerificado ? "Verificado"
  : String(p.EstadoVerificacion ?? "").toLowerCase() === "rechazado" ? "Rechazado"
  : "Pendiente";

// La API responde { psicologos: [...] }
const psicologosBD = (respuesta?.psicologos ?? respuesta?.datos ?? []).map((p: any, i: number) => ({
  id: p.PerfilId, // el backend identifica al psicólogo por su PerfilId
  nombre: p.NombreCompleto,
  especialidad: p.Especialidades ?? "Sin especialidad registrada",
  correo: p.Email,
  telefono: p.Telefono || "—",
  registro: haceCuanto(p.CreadoEn),
  ciudad: p.Direccion || "—",
  experiencia: p.AniosExperiencia != null
    ? `${p.AniosExperiencia} ${Number(p.AniosExperiencia) === 1 ? "año" : "años"}`
    : "—",
  estado: estadoDe(p),
  color: COLORES[i % COLORES.length],
  // Foto de perfil (si la subió): GET /api/admin/psicologos/:perfilId/foto
  foto: Number(p.TieneFoto ?? 0) === 1
    ? `${API_URL}/api/admin/psicologos/${encodeURIComponent(p.PerfilId)}/foto`
    : "",
}));
