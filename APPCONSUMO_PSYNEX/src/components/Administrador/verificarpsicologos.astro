<script is:inline define:vars={{ psicologosBD, API_URL }}>

    // Datos reales que vienen del servidor (ver la parte de arriba)
    const psicologos = psicologosBD;


    let indiceActual = -1;


    /* =====================================================
       FOTO (si no tiene o no carga, queda el ícono)
    ====================================================== */

    function htmlAvatar(psicologo) {
        if (!psicologo.foto) return '<i class="bi bi-person"></i>';
        return '<i class="bi bi-person"></i><img src="' + psicologo.foto +
            '" alt="" loading="lazy" onerror="this.remove()" />';
    }


    /* =====================================================
       AVISO PEQUEÑO
    ====================================================== */

    function avisar(texto, titulo) {
        document.getElementById("avisoAdminTitulo").textContent = titulo || "Listo";
        document.getElementById("avisoAdminTexto").textContent = texto;
        document.getElementById("avisoAdmin").hidden = false;
        document.getElementById("avisoAdminCerrar").focus();
    }

    document.getElementById("avisoAdminCerrar").addEventListener("click", function () {
        document.getElementById("avisoAdmin").hidden = true;
    });

    document.getElementById("avisoAdmin").addEventListener("click", function (event) {
        if (event.target === this) this.hidden = true;
    });


    /* =====================================================
       BOTONES DE DECISIÓN: desaparecen cuando ya está verificado
    ====================================================== */

    function pintarDecision(psicologo) {
        const nota = document.getElementById("decisionHecha");
        const botones = document.getElementById("decisionBotones");
        const btnRechazar = document.getElementById("btnRechazar");

        if (psicologo.estado === "Verificado") {
            botones.hidden = true;
            nota.hidden = false;
            nota.textContent = "Este psicólogo ya fue verificado y está activo.";
        } else if (psicologo.estado === "Rechazado") {
            // Se puede verificar después si corrige sus documentos
            botones.hidden = false;
            btnRechazar.hidden = true;
            nota.hidden = false;
            nota.textContent = "Esta solicitud fue rechazada. Puedes verificarla si ya corrigió sus documentos.";
        } else {
            botones.hidden = false;
            btnRechazar.hidden = false;
            nota.hidden = true;
        }
    }


    const lista = document.getElementById("listaPsicologos");
    const detalleVacio = document.getElementById("detalleVacio");
    const detalleContenido = document.getElementById("detalleContenido");

    const resumenMenu = document.getElementById("resumenMenu");
    const btnResumen = document.getElementById("btnResumen");

    const buscar = document.getElementById("buscarPsicologo");
    const filtroEspecialidad = document.getElementById("filtroEspecialidad");
    const filtroEstado = document.getElementById("filtroEstado");

    const footerDots = document.getElementById("footerDots");


    /* =====================================================
       RESUMEN
    ====================================================== */

    btnResumen.addEventListener("click", function (event) {

        event.stopPropagation();

        resumenMenu.classList.toggle("mostrar");

    });


    document.addEventListener("click", function (event) {

        if (
            !event.target.closest(".header-actions")
        ) {

            resumenMenu.classList.remove("mostrar");

        }

    });


    /* =====================================================
       RENDER LISTA
    ====================================================== */

    function obtenerFiltrados() {

        const texto = buscar.value.toLowerCase().trim();

        const especialidad = filtroEspecialidad.value;

        const estado = filtroEstado.value;


        return psicologos.filter(function (psicologo) {

            const coincideNombre =
                psicologo.nombre.toLowerCase().includes(texto) ||
                psicologo.especialidad.toLowerCase().includes(texto);

            const coincideEspecialidad =
                !especialidad ||
                psicologo.especialidad.toLowerCase()
                    .includes(especialidad.toLowerCase());

            const coincideEstado =
                !estado ||
                psicologo.estado === estado;


            return (
                coincideNombre &&
                coincideEspecialidad &&
                coincideEstado
            );

        });

    }


    function renderLista() {

        const filtrados = obtenerFiltrados();

        lista.innerHTML = "";


        if (filtrados.length === 0) {

            lista.innerHTML = `
                <div class="lista-vacia">
                    <i class="bi bi-person-x"></i>
                    <span>No se encontraron psicólogos.</span>
                </div>
            `;

            indiceActual = -1;

            mostrarVacio();

            actualizarDots([]);

            actualizarResumen();

            return;

        }


        filtrados.forEach(function (psicologo) {

            const item = document.createElement("button");

            item.type = "button";

            item.className = "psicologo-item";

            item.dataset.id = psicologo.id;


            if (
                indiceActual !== -1 &&
                psicologos[indiceActual] &&
                psicologos[indiceActual].id === psicologo.id
            ) {

                item.classList.add("seleccionado");

            }


            item.innerHTML = `

                <div class="psicologo-avatar avatar-${psicologo.color}">
                    ${htmlAvatar(psicologo)}
                </div>

                <div class="psicologo-item-info">

                    <strong>
                        ${psicologo.nombre}
                    </strong>

                    <span>
                        ${psicologo.especialidad}
                    </span>

                    <small>
                        ${psicologo.registro}
                    </small>

                </div>

                <span
                    class="punto-estado ${psicologo.estado.toLowerCase()}"
                ></span>

            `;


            item.addEventListener("click", function () {

                seleccionarPsicologo(psicologo.id);

            });


            lista.appendChild(item);

        });


        actualizarDots(filtrados);

        actualizarResumen();

    }


    /* =====================================================
       SELECCIONAR
    ====================================================== */

    function seleccionarPsicologo(id) {

        const indice = psicologos.findIndex(function (item) {

            return item.id === id;

        });


        if (indice === -1) {
            return;
        }


        indiceActual = indice;

        const psicologo = psicologos[indice];

        cargarDocumentos(psicologo.id);


        detalleVacio.hidden = true;

        detalleContenido.hidden = false;


        document.getElementById("detalleNombre").textContent =
            psicologo.nombre;

        document.getElementById("detalleEspecialidad").textContent =
            psicologo.especialidad;

        document.getElementById("detalleCorreo").textContent =
            psicologo.correo;

        document.getElementById("detalleTelefono").textContent =
            psicologo.telefono;

        document.getElementById("detalleRegistro").textContent =
            psicologo.registro;

        document.getElementById("detalleCiudad").textContent =
            psicologo.ciudad;

        document.getElementById("detalleExperiencia").textContent =
            psicologo.experiencia;


        const estado = document.getElementById("detalleEstado");

        estado.className =
            "estado-badge " +
            psicologo.estado.toLowerCase();

        estado.innerHTML = `
            <span></span>
            ${psicologo.estado}
        `;

        document.getElementById("detalleAvatar").innerHTML =
            htmlAvatar(psicologo);

        pintarDecision(psicologo);


        actualizarListaSeleccionada();

    }


    function actualizarListaSeleccionada() {

        const items =
            lista.querySelectorAll(".psicologo-item");


        items.forEach(function (item) {

            const id =
                item.dataset.id;


            item.classList.toggle(
                "seleccionado",
                psicologos[indiceActual] &&
                psicologos[indiceActual].id === id
            );

        });

    }


    function mostrarVacio() {

        detalleVacio.hidden = false;

        detalleContenido.hidden = true;

    }


    /* =====================================================
       PUNTICOS INFERIORES
    ====================================================== */

    function actualizarDots(items) {

        footerDots.innerHTML = "";


        items.forEach(function (psicologo, posicion) {

            const dot =
                document.createElement("button");


            dot.type = "button";

            dot.className = "footer-dot";


            if (
                psicologos[indiceActual] &&
                psicologos[indiceActual].id === psicologo.id
            ) {

                dot.classList.add("activo");

            }


            dot.title = psicologo.nombre;


            dot.addEventListener("click", function () {

                seleccionarPsicologo(psicologo.id);

            });


            footerDots.appendChild(dot);

        });

    }


    /* =====================================================
       ANTERIOR
    ====================================================== */

    document
        .getElementById("btnAnterior")
        .addEventListener("click", function () {

            const filtrados = obtenerFiltrados();


            if (filtrados.length === 0) {
                return;
            }


            if (indiceActual === -1) {

                seleccionarPsicologo(
                    filtrados[0].id
                );

                return;

            }


            const posicion =
                filtrados.findIndex(function (item) {

                    return item.id ===
                        psicologos[indiceActual].id;

                });


            const anterior =
                posicion <= 0
                    ? filtrados[filtrados.length - 1]
                    : filtrados[posicion - 1];


            seleccionarPsicologo(anterior.id);

            actualizarDots(filtrados);

        });


    /* =====================================================
       SIGUIENTE
    ====================================================== */

    document
        .getElementById("btnSiguiente")
        .addEventListener("click", function () {

            const filtrados = obtenerFiltrados();


            if (filtrados.length === 0) {
                return;
            }


            if (indiceActual === -1) {

                seleccionarPsicologo(
                    filtrados[0].id
                );

                return;

            }


            const posicion =
                filtrados.findIndex(function (item) {

                    return item.id ===
                        psicologos[indiceActual].id;

                });


            const siguiente =
                posicion >= filtrados.length - 1
                    ? filtrados[0]
                    : filtrados[posicion + 1];


            seleccionarPsicologo(siguiente.id);

            actualizarDots(filtrados);

        });


    /* =====================================================
       FILTROS
    ====================================================== */

    buscar.addEventListener("input", function () {

        renderLista();

    });


    filtroEspecialidad.addEventListener("change", function () {

        renderLista();

    });


    filtroEstado.addEventListener("change", function () {

        renderLista();

    });


    /* =====================================================
       MODAL PERFIL
    ====================================================== */

    document
        .getElementById("btnVerPerfil")
        .addEventListener("click", function () {

            if (indiceActual === -1) {
                return;
            }


            const psicologo =
                psicologos[indiceActual];


            document.getElementById("perfilNombre").textContent =
                psicologo.nombre;

            document.getElementById("perfilNombreHeader").textContent =
                psicologo.nombre;

            document.getElementById("perfilEspecialidad").textContent =
                psicologo.especialidad;

            document.getElementById("perfilCorreo").textContent =
                psicologo.correo;

            document.getElementById("perfilTelefono").textContent =
                psicologo.telefono;

            document.getElementById("perfilCiudad").textContent =
                psicologo.ciudad;

            document.getElementById("perfilExperiencia").textContent =
                psicologo.experiencia;

            document.querySelector("#modalPerfil .perfil-modal-avatar").innerHTML =
                htmlAvatar(psicologo);


            abrirModal("modalPerfil");

        });


    /* =====================================================
       DOCUMENTOS REALES DEL PSICÓLOGO
       Lista:   GET /api/admin/psicologos/:perfilId/documentos
       Archivo: GET /api/admin/psicologos/documentos/:documentoId
    ====================================================== */

    var NOMBRES_DOCUMENTO = {
        tarjeta_profesional: ["Tarjeta profesional", "Registro profesional", "bi-file-earmark-text"],
        cedula: ["Cédula de ciudadanía", "Documento de identidad", "bi-person-vcard"],
        diploma: ["Diploma o título profesional", "Documento de formación académica", "bi-file-earmark-pdf"],
        certificado_vigencia: ["Certificado de vigencia", "Antecedentes / vigencia profesional", "bi-file-earmark-check"],
    };

    var documentosPedidos = "";

    function urlDocumento(id) {
        return API_URL + "/api/admin/psicologos/documentos/" + encodeURIComponent(id);
    }

    function descargarDocumento(doc) {
        fetch(urlDocumento(doc.DocumentoArchivoId), { credentials: "include" })
            .then(function (res) {
                if (!res.ok) throw new Error(String(res.status));
                return res.blob();
            })
            .then(function (blob) {
                var enlace = document.createElement("a");
                enlace.href = URL.createObjectURL(blob);
                enlace.download = doc.NombreOriginal || "documento";
                enlace.click();
                setTimeout(function () { URL.revokeObjectURL(enlace.href); }, 1000);
            })
            .catch(function (error) {
                console.error(error);
                avisar("No se pudo descargar el documento.", "Error");
            });
    }

    function cargarDocumentos(perfilId) {
        var lista = document.getElementById("listaDocumentosPsicologo");
        var contador = document.getElementById("contadorDocumentosPsicologo");
        if (!lista) return;
        documentosPedidos = perfilId;
        lista.innerHTML = "<p class=\"documentos-vacio\">Cargando documentos...</p>";

        fetch(API_URL + "/api/admin/psicologos/" + encodeURIComponent(perfilId) + "/documentos", {
            credentials: "include",
        })
            .then(function (res) { return res.ok ? res.json() : null; })
            .catch(function () { return null; })
            .then(function (data) {
                // Si se eligió otro psicólogo mientras cargaba, no se pinta
                if (documentosPedidos !== perfilId) return;
                var documentos = (data && data.documentos) || [];

                if (contador) {
                    contador.textContent = documentos.length + (documentos.length === 1 ? " documento" : " documentos");
                }

                lista.replaceChildren();
                if (!documentos.length) {
                    var vacio = document.createElement("p");
                    vacio.className = "documentos-vacio";
                    vacio.textContent = "Este psicólogo no ha subido documentos.";
                    lista.append(vacio);
                    return;
                }

                documentos.forEach(function (doc) {
                    var nombres = NOMBRES_DOCUMENTO[doc.Tipo] || [doc.Tipo, "", "bi-file-earmark-text"];

                    var fila = document.createElement("div");
                    fila.className = "documento-row";

                    var info = document.createElement("div");
                    info.className = "documento-info";

                    var icono = document.createElement("div");
                    icono.className = "documento-icono";
                    var i = document.createElement("i");
                    i.className = "bi " + nombres[2];
                    icono.append(i);

                    var textos = document.createElement("div");
                    var strong = document.createElement("strong");
                    strong.textContent = nombres[0];
                    var span = document.createElement("span");
                    span.textContent = nombres[1] ? nombres[1] + " · " + doc.NombreOriginal : doc.NombreOriginal;
                    textos.append(strong, span);
                    info.append(icono, textos);

                    var acciones = document.createElement("div");
                    acciones.className = "documento-actions";

                    var ver = document.createElement("button");
                    ver.type = "button";
                    ver.className = "btn-documento btn-ver-documento";
                    ver.innerHTML = '<i class="bi bi-eye"></i> Ver';
                    ver.addEventListener("click", function () {
                        window.open(urlDocumento(doc.DocumentoArchivoId), "_blank", "noopener");
                    });

                    var bajar = document.createElement("button");
                    bajar.type = "button";
                    bajar.className = "btn-documento btn-descargar-documento";
                    bajar.innerHTML = '<i class="bi bi-download"></i> Descargar';
                    bajar.addEventListener("click", function () {
                        descargarDocumento(doc);
                    });

                    acciones.append(ver, bajar);
                    fila.append(info, acciones);
                    lista.append(fila);
                });
            });
    }


    /* =====================================================
       BACKEND: PATCH /api/admin/psicologos/:perfilId/verificacion
       Devuelve true si se guardó. El backend también le envía
       un correo al psicólogo con la decisión.
    ====================================================== */
    async function enviarDecision(perfilId, aprobado, motivoRechazo) {
        try {
            const res = await fetch(
                API_URL + "/api/admin/psicologos/" + perfilId + "/verificacion",
                {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify(
                        aprobado ? { aprobado: true } : { aprobado: false, motivoRechazo }
                    )
                }
            );
            if (res.status === 401) {
                window.location.href = "/Inicio/login";
                return false;
            }
            if (!res.ok) {
                const data = await res.json().catch(function () { return {}; });
                avisar(
                    Array.isArray(data.error) ? data.error.join(", ")
                    : (data.error || "No se pudo guardar la decisión."),
                    "No se pudo guardar"
                );
                return false;
            }
            return true;
        } catch (error) {
            console.error(error);
            avisar("No se pudo conectar con el servidor.", "Sin conexión");
            return false;
        }
    }


    /* =====================================================
       VERIFICAR
    ====================================================== */

    document
        .getElementById("btnVerificar")
        .addEventListener("click", async function () {

            if (indiceActual === -1) {
                return;
            }


            const guardado = await enviarDecision(
                psicologos[indiceActual].id, true
            );

            if (!guardado) {
                return;
            }

            psicologos[indiceActual].estado =
                "Verificado";


            const id =
                psicologos[indiceActual].id;


            renderLista();

            // Sigue viendo al mismo psicólogo, ya sin los botones
            if (obtenerFiltrados().some(function (p) { return p.id === id; })) {
                seleccionarPsicologo(id);
            } else {
                indiceActual = -1;
                mostrarVacio();
            }

            actualizarResumen();


            avisar(
                "El psicólogo fue verificado y activado. Le enviamos un correo con la noticia.",
                "Psicólogo verificado"
            );

        });


    /* =====================================================
       RECHAZAR
    ====================================================== */

    document
        .getElementById("btnRechazar")
        .addEventListener("click", function () {

            if (indiceActual === -1) {
                return;
            }


            document.getElementById(
                "motivoRechazo"
            ).value = "";


            abrirModal("modalRechazar");

        });


    /* =====================================================
       CONFIRMAR RECHAZO
    ====================================================== */

    document
        .getElementById("btnConfirmarRechazo")
        .addEventListener("click", async function () {

            if (indiceActual === -1) {
                return;
            }


            const motivo =
                document.getElementById(
                    "motivoRechazo"
                ).value.trim();


            if (motivo.length < 5) {

                avisar(
                    "Escribe el motivo del rechazo (mínimo 5 caracteres).",
                    "Falta el motivo"
                );

                return;

            }


            const guardado = await enviarDecision(
                psicologos[indiceActual].id, false, motivo
            );

            if (!guardado) {
                return;
            }



            psicologos[indiceActual].estado =
                "Rechazado";


            const idRechazado =
                psicologos[indiceActual].id;


            cerrarModal("modalRechazar");

            renderLista();

            if (obtenerFiltrados().some(function (p) { return p.id === idRechazado; })) {
                seleccionarPsicologo(idRechazado);
            } else {
                indiceActual = -1;
                mostrarVacio();
            }

            actualizarResumen();

            avisar(
                "La solicitud fue rechazada. Le enviamos un correo con el motivo.",
                "Solicitud rechazada"
            );

        });


    /* =====================================================
       MODALES
    ====================================================== */

    function abrirModal(id) {

        const modal =
            document.getElementById(id);


        modal.classList.add("mostrar");

        document.body.classList.add(
            "modal-abierto"
        );

    }


    function cerrarModal(id) {

        const modal =
            document.getElementById(id);


        modal.classList.remove("mostrar");

        document.body.classList.remove(
            "modal-abierto"
        );

    }


    document
        .querySelectorAll("[data-cerrar]")
        .forEach(function (boton) {

            boton.addEventListener("click", function () {

                cerrarModal(
                    boton.dataset.cerrar
                );

            });

        });


    document
        .querySelectorAll(".modal-overlay")
        .forEach(function (modal) {

            modal.addEventListener(
                "click",
                function (event) {

                    if (
                        event.target === modal
                    ) {

                        cerrarModal(modal.id);

                    }

                }
            );

        });


    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key !== "Escape") {
                return;
            }


            document
                .querySelectorAll(".modal-overlay.mostrar")
                .forEach(function (modal) {

                    cerrarModal(modal.id);

                });

        }
    );


    /* =====================================================
       RESUMEN
    ====================================================== */

    function actualizarResumen() {

        const total =
            psicologos.length;


        const verificados =
            psicologos.filter(function (item) {

                return item.estado === "Verificado";

            }).length;


        const pendientes =
            psicologos.filter(function (item) {

                return item.estado === "Pendiente";

            }).length;


        const rechazados =
            psicologos.filter(function (item) {

                return item.estado === "Rechazado";

            }).length;


        document.getElementById(
            "resumenTotal"
        ).textContent = total;


        document.getElementById(
            "resumenVerificados"
        ).textContent = verificados;


        document.getElementById(
            "resumenPendientes"
        ).textContent = pendientes;


        document.getElementById(
            "resumenRechazados"
        ).textContent = rechazados;


        document.getElementById(
            "contadorPendientes"
        ).textContent =
            pendientes + " pendientes";

    }


    /* =====================================================
       INICIALIZAR
    ====================================================== */

    renderLista();

    actualizarResumen();

</script>