---
import MenuAdmin from "../Menu/MenuAdmin.astro";
import "./usuarios.css";
---

<div class="usuarios-page">

  <MenuAdmin />

  <main class="usuarios-content">

    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <header class="usuarios-header">

      <div>
        <span class="section-kicker">Administración</span>

        <h1>
          <i class="bi bi-people"></i>
          Usuarios
        </h1>

        <p>
          Consulta y administra los usuarios de la plataforma.
        </p>
      </div>

      <button
        id="btnAbrirResumen"
        class="btn-resumen"
        type="button"
      >
        <i class="bi bi-bar-chart"></i>
        Ver resumen
      </button>

    </header>


    <!-- =====================================================
         FILTROS
    ====================================================== -->

    <section class="usuarios-filtros">

      <div class="buscador-usuarios">

        <i class="bi bi-search"></i>

        <input
          id="buscarUsuario"
          type="text"
          placeholder="Buscar por nombre, correo o documento..."
        />

      </div>


      <select id="filtroTipo">

        <option value="todos">
          Todos los roles
        </option>

        <option value="Paciente">
          Pacientes
        </option>

        <option value="Psicólogo">
          Psicólogos
        </option>

        <option value="Empresa">
          Empresas
        </option>

      </select>


      <select id="filtroEstado">

        <option value="todos">
          Todos los estados
        </option>

        <option value="Activo">
          Activos
        </option>

        <option value="Inactivo">
          Inactivos
        </option>

      </select>


      <button
        id="btnAbrirReportes"
        class="btn-reportes"
        type="button"
      >
        <i class="bi bi-flag"></i>
        Reportes
      </button>

    </section>


    <!-- =====================================================
         TABLA
    ====================================================== -->

    <section class="usuarios-table-card">

      <div class="table-header">

        <div>
          <h2>Usuarios registrados</h2>

          <p>
            Pacientes, psicólogos y empresas.
          </p>
        </div>

        <span class="total-usuarios">
          8 usuarios
