          Cancelar
        </button>

        <button
          type="button"
          class="btn-danger"
          id="btnConfirmarEstado"
        >
          <i class="bi bi-power"></i>
          Confirmar
        </button>

      </div>

    </div>

  </div>

</div>


<script>

  /* =========================================================
     MODALES
  ========================================================= */

  const modalIds = [
    "modalResumen",
    "modalDetalle",
    "modalReportes",
    "modalEstado"
  ];


  const obtenerModal = (
    id: string
  ): HTMLElement | null => {

    return document.getElementById(id);

  };


  const abrirModal = (
    id: string
  ): void => {

    const modal =
      obtenerModal(id);

    if (!modal) return;

    modal.classList.add("mostrar");

    document.body.classList.add(
      "modal-abierto"
    );

  };


  const cerrarModal = (
    id: string
  ): void => {

    const modal =
      obtenerModal(id);

    if (modal) {
      modal.classList.remove("mostrar");
    }


    const hayOtroModal =
      modalIds.some((modalId) => {

        const elemento =
          obtenerModal(modalId);

        return (
          elemento?.classList.contains(
            "mostrar"
          ) ?? false
        );

      });


    if (!hayOtroModal) {

      document.body.classList.remove(
        "modal-abierto"
      );

    }

  };


  /* =========================================================
     RESUMEN
  ========================================================= */

  document
    .getElementById("btnAbrirResumen")
    ?.addEventListener(
      "click",
      () => {

        abrirModal(
          "modalResumen"
        );

      }
    );


  /* =========================================================
     REPORTES
  ========================================================= */

  document
    .getElementById("btnAbrirReportes")
    ?.addEventListener(
      "click",
      () => {

        abrirModal(
          "modalReportes"
        );

      }
    );


  /* =========================================================
     CERRAR
  ========================================================= */

  document
    .querySelectorAll<HTMLElement>(
      "[data-close]"
    )
    .forEach((boton) => {

      boton.addEventListener(
        "click",
        () => {

          const id =
            boton.dataset.close;

          if (id) {
            cerrarModal(id);
          }

        }
      );

    });


  /* =========================================================
     CLICK FUERA
  ========================================================= */

  document
    .querySelectorAll<HTMLElement>(
      ".modal-overlay"
    )
    .forEach((overlay) => {

      overlay.addEventListener(
        "click",
        (event) => {

          if (
            event.target === overlay
          ) {

            cerrarModal(
              overlay.id
            );

          }

        }
      );

    });


  /* =========================================================
     FILTROS
  ========================================================= */

  const buscador =
    document.getElementById(
      "buscarUsuario"
    ) as HTMLInputElement | null;


  const filtroTipo =
    document.getElementById(
      "filtroTipo"
    ) as HTMLSelectElement | null;


  const filtroEstado =
    document.getElementById(
      "filtroEstado"
    ) as HTMLSelectElement | null;


  const filas =
    document.querySelectorAll<HTMLElement>(
      ".usuario-row"
    );


  const aplicarFiltros =
    (): void => {

      const texto =
        buscador?.value
          .toLowerCase()
          .trim() ?? "";


      const tipo =
        filtroTipo?.value ??
        "todos";


      const estado =
        filtroEstado?.value ??
        "todos";


      filas.forEach(
        (fila) => {

          const contenido =
            fila.textContent
              ?.toLowerCase() ?? "";


          const filaTipo =
            fila.dataset.tipo ?? "";


          const filaEstado =
            fila.dataset.estado ?? "";


          const mostrar =
            contenido.includes(texto) &&
            (
              tipo === "todos" ||
              filaTipo === tipo
            ) &&
            (
              estado === "todos" ||
              filaEstado === estado
            );


          fila.style.display =
            mostrar ? "" : "none";

        }
      );

    };


  buscador?.addEventListener(
    "input",
    aplicarFiltros
  );


  filtroTipo?.addEventListener(
    "change",
    aplicarFiltros
  );


  filtroEstado?.addEventListener(
    "change",
    aplicarFiltros
  );


  /* =========================================================
     DETALLE
  ========================================================= */

  const abrirDetalle = (
    fila: HTMLElement
  ): void => {

    const nombre =
      fila.dataset.nombre ?? "";


    const tipo =
      fila.dataset.tipo ?? "";


    const tipoClass =
      fila.dataset.tipoClass ?? "";


    const documento =
      fila.dataset.documento ?? "";


    const correo =
      fila.dataset.correo ?? "";


    const telefono =
      fila.dataset.telefono ?? "";


    const iniciales =
      fila.dataset.iniciales ?? "";


    const estado =
      fila.dataset.estado ?? "";


    const nombreDetalle =
      document.getElementById(
        "detalleNombre"
      );


    const tipoDetalle =
      document.getElementById(
        "detalleTipo"
      );


    const documentoDetalle =
      document.getElementById(
        "detalleDocumento"
      );


    const correoDetalle =
      document.getElementById(
        "detalleCorreo"
      );


    const telefonoDetalle =
      document.getElementById(
        "detalleTelefono"
      );


    const avatarDetalle =
      document.getElementById(
        "detalleAvatar"
      );


    if (nombreDetalle) {

      nombreDetalle.textContent =
        nombre;

    }


    if (tipoDetalle) {

      tipoDetalle.textContent =
        tipo;

      tipoDetalle.className =
        `tipo-badge ${tipoClass}`;

    }


    if (documentoDetalle) {

      documentoDetalle.textContent =
        documento;

    }


    if (correoDetalle) {

      correoDetalle.textContent =
        correo;

    }


    if (telefonoDetalle) {

      telefonoDetalle.textContent =
        telefono;

    }


    if (avatarDetalle) {

      avatarDetalle.textContent =
        iniciales;

      avatarDetalle.className =
        `detalle-avatar ${tipoClass}`;

    }


    const modalEstado =
      document.getElementById(
        "modalEstado"
      );


    if (modalEstado) {

      modalEstado.dataset.usuarioId =
        fila.dataset.id ?? "";

      modalEstado.dataset.usuarioNombre =
        nombre;

      modalEstado.dataset.usuarioEstado =
        estado;

    }


    abrirModal(
      "modalDetalle"
    );

  };


  document
    .querySelectorAll<HTMLElement>(
      '[data-action="detalle"]'
    )
    .forEach((boton) => {

      boton.addEventListener(
        "click",
        (event) => {

          event.stopPropagation();


          const id =
            boton.dataset.id ?? "";


          const fila =
            document.querySelector<HTMLElement>(
              `.usuario-row[data-id="${id}"]`
            );


          if (fila) {

            abrirDetalle(
              fila
            );

          }

        }
      );

    });


  /* =========================================================
     CAMBIAR ESTADO
  ========================================================= */

  document
    .querySelectorAll<HTMLElement>(
      '[data-action="estado"]'
    )
    .forEach((boton) => {

      boton.addEventListener(
        "click",
        (event) => {

          event.stopPropagation();


          const nombre =
            boton.dataset.nombre ?? "";


          const estado =
            boton.dataset.estado ?? "";


          const modalEstado =
            document.getElementById(
              "modalEstado"
            );


          if (modalEstado) {

            modalEstado.dataset.usuarioId =
              boton.dataset.id ?? "";

            modalEstado.dataset.usuarioNombre =
              nombre;

            modalEstado.dataset.usuarioEstado =
              estado;

          }


          const titulo =
            document.getElementById(
              "estadoTitulo"
            );


          const descripcion =
            document.getElementById(
              "estadoDescripcion"
            );


          const usuario =
            document.getElementById(
              "estadoUsuario"
            );


          if (usuario) {

            usuario.textContent =
              nombre;

          }


          if (estado === "Activo") {

            if (titulo) {

              titulo.textContent =
                "¿Desactivar usuario?";

            }


            if (descripcion) {

              descripcion.textContent =
                "El usuario no podrá acceder temporalmente a la plataforma.";

            }

          } else {

            if (titulo) {

              titulo.textContent =
                "¿Activar usuario?";

            }


            if (descripcion) {

              descripcion.textContent =
                "El usuario podrá volver a acceder a la plataforma.";

            }

          }


          abrirModal(
            "modalEstado"
          );

        }
      );

    });


  /* =========================================================
     CAMBIAR ESTADO DESDE DETALLE
  ========================================================= */

  document
    .getElementById(
      "btnDesactivarDesdeDetalle"
    )
    ?.addEventListener(
      "click",
      () => {

        const detalle =
          document.getElementById(
            "modalDetalle"
          );


        const estado =
          document.getElementById(
            "modalEstado"
          );


        if (
          detalle &&
          estado
        ) {

          estado.dataset.usuarioId =
            detalle.dataset.usuarioId ?? "";

          estado.dataset.usuarioNombre =
            detalle.dataset.usuarioNombre ?? "";

          estado.dataset.usuarioEstado =
            detalle.dataset.usuarioEstado ?? "";

        }


        cerrarModal(
          "modalDetalle"
        );


        abrirModal(
          "modalEstado"
        );

      }
    );


  /* =========================================================
     ESC
  ========================================================= */

  document.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key === "Escape"
      ) {

        modalIds.forEach(
          (id) => {

            cerrarModal(id);

          }
        );

      }

    }
  );

</script>