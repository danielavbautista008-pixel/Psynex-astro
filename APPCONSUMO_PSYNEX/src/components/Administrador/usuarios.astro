        </article>


        <article class="reporte-item">

          <div class="reporte-icon">
            <i class="bi bi-chat-left-text"></i>
          </div>

          <div class="reporte-info">

            <strong>
              Queja recibida
            </strong>

            <p>
              Se recibió una queja relacionada
              con una cita.
            </p>

            <small>
              Ayer · Revisado
            </small>

          </div>

          <button
            type="button"
            class="reporte-ver"
