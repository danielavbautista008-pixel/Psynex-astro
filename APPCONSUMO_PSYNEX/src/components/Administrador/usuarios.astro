      class="modal-box modal-resumen"
      role="dialog"
      aria-modal="true"
    >

      <div class="modal-header">

        <div>
          <span class="modal-kicker">
            Resumen
          </span>

          <h2>
            Usuarios de la plataforma
          </h2>

          <p>
            Distribución actual de usuarios.
          </p>
        </div>

        <button
          type="button"
          class="modal-close"
          data-close="modalResumen"
