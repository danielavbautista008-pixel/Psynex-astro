      </div>


      <div class="usuarios-table">

        <!-- CABECERA -->

        <div class="usuario-table-head">

          <span>Usuario</span>
          <span>Rol</span>
          <span>Contacto</span>
          <span>Estado</span>
          <span>Acciones</span>

        </div>


        <!-- =================================================
