<script>
// @ts-nocheck
import { API_URL } from "../../lib/api";

// Envía cambios de un plan al backend. Devuelve true si se guardó.
//   Nuevo:  POST  /api/admin/planes
//   Editar: PATCH /api/admin/planes/:id
async function guardarEnBackend(id, datos) {
    try {
        const res = await fetch(
            id ? `${API_URL}/api/admin/planes/${id}` : `${API_URL}/api/admin/planes`,
            {
                method: id ? "PATCH" : "POST",
                headers: { "Content-Type": "application/json" },
                credentials: "include",
                body: JSON.stringify(datos),
            }
        );
        if (res.status === 401) {
            window.location.href = "/Inicio/login";
            return false;
        }
        if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            alert(Array.isArray(data.error) ? data.error.join(", ") : (data.error || "No se pudo guardar el plan."));
            return false;
        }
        return true;
    } catch (error) {
        console.error(error);
        alert("No se pudo conectar con el servidor.");
        return false;
    }
}

// Id del plan que se está editando (null = plan nuevo)
let planEditandoId = null;

document.addEventListener("DOMContentLoaded", () => {

    const modalPlan = document.getElementById("modalPlan");
    const modalEmpresas = document.getElementById("modalEmpresas");

    const btnNuevoPlan = document.getElementById("btnNuevoPlan");
    const btnGuardarPlan = document.getElementById("btnGuardarPlan");

    const tituloEmpresas = document.getElementById("tituloEmpresas");

    const nombrePlan = document.getElementById("nombrePlan");
    const descripcionPlan = document.getElementById("descripcionPlan");
    const precioPlan = document.getElementById("precioPlan");
    const usuariosPlan = document.getElementById("usuariosPlan");

    const buscarPlan = document.getElementById("buscarPlan");
    const filtroEstado = document.getElementById("filtroEstado");
    const checksCaracteristicas =
        document.querySelectorAll(".caracteristicas-check input[type=checkbox]");
    const textoCheck = (check) => check.parentElement?.textContent?.trim() || "";



    /* =====================================================
       ABRIR MODAL NUEVO PLAN
    ====================================================== */

    btnNuevoPlan?.addEventListener("click", () => {

        if (!modalPlan) return;
        planEditandoId = null;

        modalPlan.classList.add("mostrar");

        document.body.classList.add("modal-abierto");

        nombrePlan.value = "";
        descripcionPlan.value = "";
        precioPlan.value = "";
        usuariosPlan.value = "";

    });



    /* =====================================================
       CERRAR MODALES
    ====================================================== */

    document.querySelectorAll("[data-cerrar-modal]").forEach((boton) => {

        boton.addEventListener("click", () => {

            modalPlan?.classList.remove("mostrar");

            document.body.classList.remove("modal-abierto");

        });

    });



    document.querySelectorAll("[data-cerrar-empresas]").forEach((boton) => {

        boton.addEventListener("click", () => {

            modalEmpresas?.classList.remove("mostrar");

            document.body.classList.remove("modal-abierto");

        });

    });



    /* =====================================================
       CERRAR AL HACER CLICK EN EL FONDO
    ====================================================== */

    modalPlan?.addEventListener("click", (event) => {

        if (event.target === modalPlan) {

            modalPlan.classList.remove("mostrar");

            document.body.classList.remove("modal-abierto");

        }

    });



    modalEmpresas?.addEventListener("click", (event) => {

        if (event.target === modalEmpresas) {

            modalEmpresas.classList.remove("mostrar");

            document.body.classList.remove("modal-abierto");

        }

    });



    /* =====================================================
       VER EMPRESAS
    ====================================================== */

    document.querySelectorAll("[data-plan]").forEach((boton) => {

        boton.addEventListener("click", () => {

            const plan = boton.dataset.plan;

            tituloEmpresas.textContent = `Empresas — ${plan}`;

            modalEmpresas?.classList.add("mostrar");

            document.body.classList.add("modal-abierto");

        });

    });



    /* =====================================================
       ACTIVAR / DESACTIVAR PLAN
    ====================================================== */

    document.querySelectorAll("[data-toggle-plan]").forEach((boton) => {

        boton.addEventListener("click", async () => {

            const card = boton.closest(".plan-card");

            if (!card) return;

            // PATCH /api/admin/planes/:id  { publicado }
            const guardado = await guardarEnBackend(card.dataset.id, {
                publicado: card.dataset.estado !== "activo",
            });
            if (!guardado) return;

            const estado = card.querySelector(".estado-plan");
            const textoBoton = boton.querySelector("i");

            if (!estado) return;


            const estaActivo = card.dataset.estado === "activo";


            if (estaActivo) {

                card.dataset.estado = "inactivo";

                estado.classList.remove("activo");
                estado.classList.add("inactivo");

                estado.innerHTML = `
                    <span></span>
                    Inactivo
                `;

                boton.classList.remove("btn-desactivar");
                boton.classList.add("btn-activar");

                boton.innerHTML = `
                    <i class="bi bi-toggle-on"></i>
                    Activar plan
                `;

            } else {

                card.dataset.estado = "activo";

                estado.classList.remove("inactivo");
                estado.classList.add("activo");

                estado.innerHTML = `
                    <span></span>
                    Activo
                `;

                boton.classList.remove("btn-activar");
                boton.classList.add("btn-desactivar");

                boton.innerHTML = `
                    <i class="bi bi-toggle-off"></i>
                    Desactivar plan
                `;

            }

            actualizarCantidadPlanes();

        });

    });



    /* =====================================================
       BUSCAR PLAN
    ====================================================== */

    buscarPlan?.addEventListener("input", filtrarPlanes);

    filtroEstado?.addEventListener("change", filtrarPlanes);


    function filtrarPlanes() {

        const texto = buscarPlan?.value
            ?.toLowerCase()
            ?.trim() || "";

        const estadoFiltro = filtroEstado?.value || "todos";

        const tarjetas = document.querySelectorAll(".plan-card");

        tarjetas.forEach((tarjeta) => {

            const nombre =
                tarjeta.dataset.nombre?.toLowerCase() || "";

            const estado =
                tarjeta.dataset.estado || "";

            const coincideNombre =
                nombre.includes(texto);

            const coincideEstado =
                estadoFiltro === "todos" ||
                estado === estadoFiltro;

            tarjeta.style.display =
                coincideNombre && coincideEstado
                    ? ""
                    : "none";

        });

    }



    /* =====================================================
       ACTUALIZAR CANTIDAD
    ====================================================== */

    function actualizarCantidadPlanes() {

        const tarjetas =
            document.querySelectorAll(".plan-card");

        let activos = 0;

        tarjetas.forEach((tarjeta) => {

            if (tarjeta.dataset.estado === "activo") {
                activos++;
            }

        });

        const contador =
            document.getElementById("cantidadPlanes");

        if (contador) {
            contador.textContent =
                `${tarjetas.length} planes`;
        }

        const total =
            document.getElementById("totalPlanes");

        if (total) {
            total.textContent =
                tarjetas.length;
        }

    }



    /* =====================================================
       GUARDAR / PUBLICAR PLAN
    ====================================================== */

    btnGuardarPlan?.addEventListener("click", async () => {

        if (!nombrePlan?.value.trim()) {

            nombrePlan.focus();

            nombrePlan.style.borderColor = "#ef5b63";

            setTimeout(() => {
                nombrePlan.style.borderColor = "";
            }, 1800);

            return;

        }


        const precio = Number(precioPlan.value);


        const citas = Number(usuariosPlan.value);


        if (!precio || precio <= 0) {


            alert("Escribe un precio válido.");


            return;


        }


        


        const datos = {


            nombre: nombrePlan.value.trim(),


            descripcion: descripcionPlan.value.trim(),


            tipo: "Empresarial",


            precio,


            cantidadSesiones: citas > 0 ? citas : null,


            beneficios: [...checksCaracteristicas]


                .filter((c) => c.checked)


                .map(textoCheck)


                .join("\n"),


            ...(planEditandoId ? {} : { publicado: true }),


        };


        


        const guardado = await guardarEnBackend(planEditandoId, datos);


        if (!guardado) return;


        


        modalPlan?.classList.remove("mostrar");

        document.body.classList.remove("modal-abierto");

        alert(planEditandoId ? "El plan fue actualizado correctamente." : "El plan fue publicado correctamente.");

        window.location.reload();

    });



    /* =====================================================
       EDITAR PLAN
    ====================================================== */

    document.querySelectorAll("[data-editar]").forEach((boton) => {
        boton.addEventListener("click", () => {
            const card = boton.closest(".plan-card");
            if (!card) return;

            planEditandoId = card.dataset.id;

            modalPlan?.classList.add("mostrar");
            document.body.classList.add("modal-abierto");

            nombrePlan.value = card.dataset.nombre || "";
            descripcionPlan.value = card.dataset.descripcion || "";
            precioPlan.value = card.dataset.precio || "";
            usuariosPlan.value = card.dataset.citas || "";

            const beneficios = (card.dataset.beneficios || "").split("\n");
            checksCaracteristicas.forEach((check) => {
                check.checked = beneficios.includes(textoCheck(check));
            });
        });
    });


    /* =====================================================
       ESC TECLA
    ====================================================== */

    document.addEventListener("keydown", (event) => {

        if (event.key === "Escape") {

            modalPlan?.classList.remove("mostrar");

            modalEmpresas?.classList.remove("mostrar");

            document.body.classList.remove("modal-abierto");

        }

    });

});
</script>