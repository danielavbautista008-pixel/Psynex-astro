---
import MenuAdmin from "../Menu/MenuAdmin.astro";
import "./publicarplanes.css";
import { apiGet } from "../../lib/api";

// ---------------------------------------------------------------
// Datos reales: GET /api/admin/planes?tipo=Empresarial (solo Admin)
// Esta vista administra los planes que compran las empresas.
// ---------------------------------------------------------------
const cookie = Astro.request.headers.get("cookie");
const respuesta = await apiGet(cookie, "/api/admin/planes?tipo=Empresarial&porPagina=50");

const pesos = (n: number) =>
  "$" + Math.round(n).toLocaleString("es-CO");

const COLORES = [
  { color: "plan-purple", icono: "bi-box" },
  { color: "plan-blue", icono: "bi-briefcase" },
  { color: "plan-green", icono: "bi-buildings" },
];

const planes = ((respuesta?.planes ?? []) as any[]).map((p: any, i: number) => {
  const beneficios = String(p.Beneficios ?? "")
    .split("\n").map((b) => b.trim()).filter(Boolean);
  return {
    id: p.PlanId,
    nombre: p.Nombre,
    descripcion: p.Descripcion,
    precio: Number(p.Precio),
    precioTexto: pesos(Number(p.Precio)),
    citas: p.CantidadSesiones ?? 0,
    beneficios,
    estado: p.Publicado ? "activo" : "inactivo",
    ...COLORES[i % COLORES.length],
  };
});

const planesActivos = planes.filter((p: any) => p.estado === "activo").length;
