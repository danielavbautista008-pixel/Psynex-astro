---
import MenuAdmin from "../Menu/MenuAdmin.astro";
import "./estadisticas.css";
import { apiGet } from "../../lib/api";

// ---------------------------------------------------------------
// Datos reales: GET /estadisticas?meses=6 (solo Admin)
// Trae las tarjetas (kpis) y las series de las 3 gráficas.
// ---------------------------------------------------------------
const cookie = Astro.request.headers.get("cookie");
const est = await apiGet(cookie, "/estadisticas?meses=6");

const pesos = (n: number) => "$" + Math.round(n).toLocaleString("es-CO");

// Convierte un kpi del backend { valor, anterior, cambioPct } en lo que muestra la tarjeta.
// subirEsMalo = true para cancelaciones (que suban es negativo).
const tarjeta = (k: any, formato: (v: number) => string, subirEsMalo = false) => {
  const valor = k?.valor;
  const pct = k?.cambioPct;
  const sube = (pct ?? 0) >= 0;
  return {
    texto: valor === null || valor === undefined ? "Sin datos" : formato(Number(valor)),
    cambio: pct === null || pct === undefined ? "—" : `${Math.abs(pct)}%`,
    flecha: sube ? "bi-arrow-up" : "bi-arrow-down",
    clase: pct === null || pct === undefined ? "" : (sube !== subirEsMalo ? "positive" : "negative"),
  };
};

const kpiCitas = tarjeta(est?.kpis?.citas, (v) => String(v));
const kpiIngresos = tarjeta(est?.kpis?.ingresos, pesos);
const kpiCalificacion = tarjeta(est?.kpis?.calificacion, (v) => v.toFixed(1));
const kpiCancelaciones = tarjeta(est?.kpis?.cancelaciones, (v) => String(v), true);

// Leyenda de "Citas por tipo"
const porTipo: Record<string, string> = {};
for (const t of est?.citasPorTipo ?? []) {
  porTipo[t.tipo] = `${t.total} citas (${t.porcentaje}%)`;
}
const leyenda = (tipo: string) => porTipo[tipo] ?? "0 citas (0%)";

// Series para las gráficas: se pasan al <script> como JSON
const datosGraficas = {
  citasPorMes: est?.citasPorMes ?? [],
  citasPorTipo: est?.citasPorTipo ?? [],
  ingresosPorFuente: est?.ingresosPorFuente ?? [],
};
---

<div class="estadistica-page">

    <MenuAdmin />

    <main class="estadistica-content">

        <!-- ==========================================
             ENCABEZADO
        =========================================== -->

        <header class="estadistica-header">

            <div class="estadistica-title">

                <div class="estadistica-title-icon">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>

                <div>
                    <h1>Estadísticas</h1>
                    <p>Consulta el comportamiento general de la plataforma.</p>
                </div>

            </div>

            <div class="periodo-selector">
                <i class="bi bi-calendar3"></i>
                <span>Últimos 6 meses</span>
                <i class="bi bi-chevron-down"></i>
            </div>

        </header>


        <!-- ==========================================
             TARJETAS PRINCIPALES
        =========================================== -->

        <section class="estadistica-kpis">

            <!-- Citas -->
            <article class="kpi-card">

                <div class="kpi-top">

                    <div class="kpi-icon kpi-purple">
                        <i class="bi bi-calendar3"></i>
                    </div>

                    <button class="kpi-menu" aria-label="Más opciones">
                        <i class="bi bi-three-dots"></i>
                    </button>

                </div>

                <p class="kpi-label">Citas este mes</p>

                <strong class="kpi-number">{kpiCitas.texto}</strong>

                <div class="kpi-bottom">

                    <span class={`kpi-change ${kpiCitas.clase}`}>
                        <i class={`bi ${kpiCitas.flecha}`}></i>
                        {kpiCitas.cambio}
                    </span>

                    <span>vs. mes anterior</span>

                </div>

                <div class="mini-line mini-purple"></div>

            </article>


            <!-- Ingresos -->
            <article class="kpi-card">

                <div class="kpi-top">

                    <div class="kpi-icon kpi-green">
                        <i class="bi bi-currency-dollar"></i>
                    </div>

                    <button class="kpi-menu" aria-label="Más opciones">
                        <i class="bi bi-three-dots"></i>
                    </button>

                </div>

                <p class="kpi-label">Ingresos este mes</p>

                <strong class="kpi-number">{kpiIngresos.texto}</strong>

                <div class="kpi-bottom">

                    <span class={`kpi-change ${kpiIngresos.clase}`}>
                        <i class={`bi ${kpiIngresos.flecha}`}></i>
                        {kpiIngresos.cambio}
                    </span>

                    <span>vs. mes anterior</span>

                </div>

                <div class="mini-line mini-green"></div>

            </article>


            <!-- Calificación -->
            <article class="kpi-card">

                <div class="kpi-top">

                    <div class="kpi-icon kpi-blue">
                        <i class="bi bi-star-fill"></i>
                    </div>

                    <button class="kpi-menu" aria-label="Más opciones">
                        <i class="bi bi-three-dots"></i>
                    </button>

                </div>

                <p class="kpi-label">Calificación promedio</p>

                <strong class="kpi-number">{kpiCalificacion.texto}</strong>

                <div class="kpi-bottom">

                    <span class={`kpi-change ${kpiCalificacion.clase}`}>
                        <i class={`bi ${kpiCalificacion.flecha}`}></i>
                        {kpiCalificacion.cambio}
                    </span>

                    <span>vs. mes anterior</span>

                </div>

                <div class="mini-line mini-blue"></div>

            </article>


            <!-- Cancelaciones -->
            <article class="kpi-card">

                <div class="kpi-top">

                    <div class="kpi-icon kpi-orange">
                        <i class="bi bi-person-x"></i>
                    </div>

                    <button class="kpi-menu" aria-label="Más opciones">
                        <i class="bi bi-three-dots"></i>
                    </button>

                </div>

                <p class="kpi-label">Cancelaciones</p>

                <strong class="kpi-number">{kpiCancelaciones.texto}</strong>

                <div class="kpi-bottom">

                    <span class={`kpi-change ${kpiCancelaciones.clase}`}>
                        <i class={`bi ${kpiCancelaciones.flecha}`}></i>
                        {kpiCancelaciones.cambio}
                    </span>

                    <span>vs. mes anterior</span>

                </div>

                <div class="mini-line mini-orange"></div>

            </article>

        </section>


        <!-- ==========================================
             PRIMERAS GRÁFICAS
        =========================================== -->

        <section class="charts-top">

            <!-- Citas por mes -->
            <article class="chart-card chart-large">

                <div class="chart-header">

                    <div>
                        <h2>Citas por mes</h2>
                        <p>Comportamiento de las citas durante el período seleccionado.</p>
                    </div>

                    <button class="chart-period">
                        Últimos 6 meses
                        <i class="bi bi-chevron-down"></i>
                    </button>

                </div>

                <div class="chart-container chart-line-container">
                    <canvas id="citasChart"></canvas>
                </div>

            </article>


            <!-- Citas por tipo -->
            <article class="chart-card chart-donut-card">

                <div class="chart-header">

                    <div>
                        <h2>Citas por tipo</h2>
                        <p>Distribución de las citas realizadas.</p>
                    </div>

                    <button class="chart-period">
                        Últimos 6 meses
                        <i class="bi bi-chevron-down"></i>
                    </button>

                </div>


                <div class="donut-content">

                    <div class="donut-chart-container">
                        <canvas id="tipoCitasChart"></canvas>
                    </div>


                    <div class="donut-legend">

                        <div class="legend-item">

                            <span class="legend-color purple"></span>

                            <div>
                                <strong>Individual</strong>
                                <small>{leyenda("Individual")}</small>
                            </div>

                        </div>


                        <div class="legend-item">

                            <span class="legend-color blue"></span>

                            <div>
                                <strong>Empresarial</strong>
                                <small>{leyenda("Empresarial")}</small>
                            </div>

                        </div>


                        <div class="legend-item">

                            <span class="legend-color green"></span>

                            <div>
                                <strong>Recompensa</strong>
                                <small>{leyenda("Recompensa")}</small>
                            </div>

                        </div>

                    </div>

                </div>

            </article>

        </section>


        <!-- ==========================================
             INGRESOS POR FUENTE
        =========================================== -->

        <section class="chart-card ingresos-card">

            <div class="chart-header">

                <div>
                    <h2>Ingresos por fuente</h2>
                    <p>Comparación entre citas individuales y planes empresariales.</p>
                </div>

                <button class="chart-period">
                    Últimos 6 meses
                    <i class="bi bi-chevron-down"></i>
                </button>

            </div>


            <div class="chart-container ingresos-chart-container">
                <canvas id="ingresosChart"></canvas>
            </div>


            <div class="ingresos-legend">

                <div>
                    <span class="legend-color purple"></span>
                    <span>Citas individuales</span>
                </div>

                <div>
                    <span class="legend-color blue"></span>
                    <span>Planes empresariales</span>
                </div>

            </div>

        </section>

    </main>

</div>


<script type="application/json" id="datosEstadisticas" set:html={JSON.stringify(datosGraficas)}></script>

<script>
    import {
        Chart,
        registerables
    } from "chart.js";

    Chart.register(...registerables);

    /* ==========================================
       DATOS REALES (vienen del servidor como JSON)
    =========================================== */
    const datos = JSON.parse(
        document.getElementById("datosEstadisticas")?.textContent || "{}"
    );
    const etiquetasMeses: string[] =
        (datos.citasPorMes ?? []).map((m: any) => m.etiqueta);
    const citasPorMes: number[] =
        (datos.citasPorMes ?? []).map((m: any) => m.total);
    const totalPorTipo = (tipo: string) =>
        (datos.citasPorTipo ?? []).find((t: any) => t.tipo === tipo)?.total ?? 0;
    // Ingresos en millones (1 decimal), como los mostraba el diseño
    const enMillones = (n: number) => Math.round((n / 1_000_000) * 10) / 10;
    const ingresosIndividuales: number[] =
        (datos.ingresosPorFuente ?? []).map((m: any) => enMillones(m.individuales));
    const ingresosEmpresariales: number[] =
        (datos.ingresosPorFuente ?? []).map((m: any) => enMillones(m.empresariales));
    const etiquetasIngresos: string[] =
        (datos.ingresosPorFuente ?? []).map((m: any) => m.etiqueta);


    /* ==========================================
       COLORES DEL TEMA
    =========================================== */

    const root = document.documentElement;

    const styles = getComputedStyle(root);

    const primary =
        styles.getPropertyValue("--primary").trim() || "#8b5cf6";

    const text =
        styles.getPropertyValue("--text").trim() || "#29272d";

    const muted =
        styles.getPropertyValue("--text-muted").trim() || "#85818b";

    const border =
        styles.getPropertyValue("--border").trim() || "#e7e3ea";


    /* ==========================================
       GRÁFICA — CITAS POR MES
    =========================================== */

    const citasCanvas =
        document.getElementById("citasChart") as HTMLCanvasElement | null;

    if (citasCanvas) {

        new Chart(citasCanvas, {

            type: "line",

            data: {

                labels: etiquetasMeses,

                datasets: [

                    {
                        label: "Citas",

                        data: citasPorMes,

                        borderColor: primary,

                        backgroundColor: `${primary}15`,

                        borderWidth: 2,

                        pointRadius: 3,

                        pointHoverRadius: 5,

                        pointBackgroundColor: primary,

                        pointBorderColor: "#ffffff",

                        pointBorderWidth: 2,

                        tension: 0.35,

                        fill: true
                    }

                ]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                interaction: {
                    intersect: false,
                    mode: "index"
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {
                        backgroundColor: "#29272d",
                        padding: 10,
                        cornerRadius: 8,
                        displayColors: false
                    }

                },

                scales: {

                    x: {

                        grid: {
                            display: false
                        },

                        border: {
                            display: false
                        },

                        ticks: {
                            color: muted,
                            font: {
                                size: 10
                            }
                        }

                    },

                    y: {

                        beginAtZero: true,

                        grid: {
                            color: border
                        },

                        border: {
                            display: false
                        },

                        ticks: {
                            color: muted,
                            font: {
                                size: 10
                            }
                        }

                    }

                }

            }

        });

    }


    /* ==========================================
       GRÁFICA — CITAS POR TIPO
    =========================================== */

    const tipoCanvas =
        document.getElementById("tipoCitasChart") as HTMLCanvasElement | null;

    if (tipoCanvas) {

        new Chart(tipoCanvas, {

            type: "doughnut",

            data: {

                labels: [
                    "Individual",
                    "Empresarial",
                    "Recompensa"
                ],

                datasets: [

                    {

                        data: [
                            totalPorTipo("Individual"),
                            totalPorTipo("Empresarial"),
                            totalPorTipo("Recompensa")
                        ],

                        backgroundColor: [
                            primary,
                            "#4b91e2",
                            "#36c9aa"
                        ],

                        borderWidth: 3,

                        borderColor: "#ffffff",

                        hoverOffset: 4

                    }

                ]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                cutout: "68%",

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {
                        padding: 10,
                        cornerRadius: 8
                    }

                }

            }

        });

    }


    /* ==========================================
       GRÁFICA — INGRESOS POR FUENTE
    =========================================== */

    const ingresosCanvas =
        document.getElementById("ingresosChart") as HTMLCanvasElement | null;

    if (ingresosCanvas) {

        new Chart(ingresosCanvas, {

            type: "bar",

            data: {

                labels: etiquetasIngresos,

                datasets: [

                    {
                        label: "Citas individuales",

                        data: ingresosIndividuales,

                        backgroundColor: primary,

                        borderRadius: 5,

                        borderSkipped: false,

                        barThickness: 14,

                        maxBarThickness: 16,

                        categoryPercentage: 0.65,

                        barPercentage: 0.75
                    },


                    {
                        label: "Planes empresariales",

                        data: ingresosEmpresariales,

                        backgroundColor: "#4b91e2",

                        borderRadius: 5,

                        borderSkipped: false,

                        barThickness: 14,

                        maxBarThickness: 16,

                        categoryPercentage: 0.65,

                        barPercentage: 0.75
                    }

                ]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                interaction: {
                    mode: "index",
                    intersect: false
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        backgroundColor: "#29272d",

                        padding: 10,

                        cornerRadius: 8,

                        callbacks: {

                            label: function (context) {

                                return `${context.dataset.label}: $${context.raw}M`;

                            }

                        }

                    }

                },

                scales: {

                    x: {

                        grid: {
                            display: false
                        },

                        border: {
                            display: false
                        },

                        ticks: {
                            color: muted,
                            font: {
                                size: 10
                            }
                        }

                    },

                    y: {

                        beginAtZero: true,

                        suggestedMax: 1,

                        grid: {
                            color: border
                        },

                        border: {
                            display: false
                        },

                        ticks: {

                            color: muted,

                            font: {
                                size: 10
                            },

                            callback: function (value) {
                                return `$${value}M`;
                            }

                        }

                    }

                }

            }

        });

    }
</script>