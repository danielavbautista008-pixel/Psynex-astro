---
// =====================================================================
// ModalSesion.astro
// Ventana emergente reutilizable de las vistas públicas (Explorar).
//
// Se pone UNA vez en la página:   <ModalSesion />
// y se abre desde cualquier <script> de la página con un evento:
//
//   document.dispatchEvent(new CustomEvent("psynex:modal", {
//     detail: {
//       tipo: "sesion",              // "sesion" = muestra Iniciar sesión / Crear cuenta
//                                    // "aviso"  = solo un mensaje con botón Entendido
//       titulo: "Inicia sesión para agendar",
//       mensaje: "Necesitas una cuenta de paciente...",
//       icono: "bi-calendar2-check", // ícono de Bootstrap Icons (opcional)
//     },
//   }));
//
// Los colores vienen de colores-globales.css, así cambia con el tema.
// =====================================================================
---

<div class="modal-sesion" id="modalSesion" aria-hidden="true">
  <div class="modal-sesion-fondo" data-cerrar-sesion></div>

  <section
    class="modal-sesion-contenido"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalSesionTitulo"
  >
    <button
      type="button"
      class="modal-sesion-cerrar"
      aria-label="Cerrar ventana"
      data-cerrar-sesion
    >
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>

    <span class="modal-sesion-icono" aria-hidden="true">
      <i id="modalSesionIcono" class="bi bi-person-lock"></i>
    </span>

    <span class="modal-sesion-kicker" id="modalSesionKicker">Psynex</span>

    <h2 id="modalSesionTitulo">Inicia sesión para continuar</h2>

    <p id="modalSesionMensaje">
      Para hacer esto necesitas una cuenta en Psynex.
    </p>

    <!-- Botones cuando falta la sesión -->
    <div class="modal-sesion-acciones" id="modalSesionAccionesSesion">
      <a href="/Inicio/login" class="modal-sesion-btn principal" id="modalSesionLogin">
        Iniciar sesión
      </a>

      <a href="/Inicio/registro" class="modal-sesion-btn secundario">
        Crear cuenta
      </a>
    </div>

    <!-- Botón cuando es solo un aviso -->
    <div class="modal-sesion-acciones" id="modalSesionAccionesAviso" hidden>
      <button type="button" class="modal-sesion-btn principal" data-cerrar-sesion>
        Entendido
      </button>
    </div>
  </section>
</div>

<style>
  /* Fraunces: la misma letra de los títulos del inicio (landing). Se carga
     aquí porque las páginas de Explorar no la traen. */
  @import url("https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&display=swap");

  .modal-sesion {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-sesion.visible {
    display: flex;
  }

  .modal-sesion-fondo {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--text) 45%, transparent);
    backdrop-filter: blur(4px);
    animation: sesionFondo 0.2s ease;
  }

  .modal-sesion-contenido {
    position: relative;
    z-index: 1;
    width: min(340px, 100%);
    padding: 24px 22px 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    color: var(--text);
    text-align: center;
    box-shadow: 0 18px 50px color-mix(in srgb, var(--text) 18%, transparent);
    animation: sesionModal 0.22s ease;
  }

  .modal-sesion-cerrar {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.75rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .modal-sesion-cerrar:hover {
    background: var(--primary-soft);
    color: var(--primary);
  }

  .modal-sesion-icono {
    width: 40px;
    height: 40px;
    margin: 0 auto 10px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 1.05rem;
  }

  .modal-sesion-kicker {
    color: var(--primary);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .modal-sesion-contenido h2 {
    margin: 4px 0 6px;
    font-family: "Fraunces", Georgia, "Times New Roman", serif;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .modal-sesion-contenido p {
    margin: 0 auto 16px;
    max-width: 280px;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .modal-sesion-acciones {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  #modalSesionAccionesAviso {
    grid-template-columns: 1fr;
  }

  .modal-sesion-acciones[hidden] {
    display: none;
  }

  .modal-sesion-btn {
    min-height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 10px;
    border-radius: 9px;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .modal-sesion-btn.principal {
    border: 0;
    background: var(--primary);
    color: var(--on-primary);
  }

  .modal-sesion-btn.principal:hover {
    background: var(--primary-hover);
  }

  .modal-sesion-btn.secundario {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  .modal-sesion-btn.secundario:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  :global(body.modal-abierto) {
    overflow: hidden;
  }

  @keyframes sesionFondo {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes sesionModal {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (max-width: 380px) {
    .modal-sesion-acciones {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  interface DetalleModal {
    tipo?: "sesion" | "aviso";
    titulo?: string;
    mensaje?: string;
    icono?: string;
    kicker?: string;
  }

  const modal = document.getElementById("modalSesion");
  const titulo = document.getElementById("modalSesionTitulo");
  const mensaje = document.getElementById("modalSesionMensaje");
  const icono = document.getElementById("modalSesionIcono");
  const kicker = document.getElementById("modalSesionKicker");
  const accionesSesion = document.getElementById("modalSesionAccionesSesion");
  const accionesAviso = document.getElementById("modalSesionAccionesAviso");
  const login = document.getElementById("modalSesionLogin") as HTMLAnchorElement | null;

  const abrir = (d: DetalleModal) => {
    if (!modal) return;
    const esAviso = d.tipo === "aviso";

    if (titulo) titulo.textContent = d.titulo ?? "Inicia sesión para continuar";
    if (mensaje) mensaje.textContent = d.mensaje ?? "Para hacer esto necesitas una cuenta en Psynex.";
    if (icono) icono.className = `bi ${d.icono ?? (esAviso ? "bi-info-circle" : "bi-person-lock")}`;
    if (kicker) kicker.textContent = d.kicker ?? (esAviso ? "Aviso" : "Tu cuenta");

    if (accionesSesion) accionesSesion.hidden = esAviso;
    if (accionesAviso) accionesAviso.hidden = !esAviso;

    // Al iniciar sesión, el login devuelve a esta misma página
    if (login) {
      login.href = `/Inicio/login?volver=${encodeURIComponent(location.pathname + location.search)}`;
    }

    modal.classList.add("visible");
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-abierto");
  };

  const cerrar = () => {
    if (!modal) return;
    modal.classList.remove("visible");
    modal.setAttribute("aria-hidden", "true");
    // Solo se libera el scroll si no queda otra ventana abierta
    if (!document.querySelector(".modal-cita.visible, .modal-postulacion.modal-visible, .result-overlay.visible")) {
      document.body.classList.remove("modal-abierto");
    }
  };

  document.addEventListener("psynex:modal", (e) => abrir((e as CustomEvent<DetalleModal>).detail ?? {}));

  modal?.querySelectorAll("[data-cerrar-sesion]").forEach((el) => el.addEventListener("click", cerrar));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal?.classList.contains("visible")) cerrar();
  });
</script>
