---
import "./Perfilpsicologo.css";
import ModalSesion from "./ModalSesion.astro";
import { fotoIniciales, pesos, urlFotoPsicologo } from "../../lib/api";

// Los datos llegan desde la página /Explorar/[id].astro, que los pide a
// GET /api/explorar/psicologos/:id. "rol" es el rol del visitante
// (null si no tiene sesión): con eso el botón "Agendar" sabe qué hacer.
interface Estudio {
  Universidad: string;
  Titulo: string;
  NivelEstudio: string;
  AnioGrado: number | null;
  EnCurso: number;
}

interface Experiencia {
  Empresa: string;
  Cargo: string;
  Descripcion: string;
  AnioInicio: number | null;
  AnioFin: number | null;
  TrabajaAqui: number;
}

interface Resena {
  nombre: string;
  puntaje: number;
  comentario: string;
  fecha: string;
}

export interface PsicologoPublico {
  id: string;
  nombre: string;
  titulo: string;
  biografia: string;
  especialidades: string[];
  modalidades: string[];
  modalidadTexto: string;
  experienciaTexto: string;
  disponibilidad: string;
  disponibilidadTexto: string;
  calificacion: number | null;
  totalResenas: number;
  precio: number;
  voluntario: boolean;
  duracionMinutos: number;
  tieneFoto: boolean;
  fotoVersion?: string;
  direccion: string;
  estudios: Estudio[];
  experiencia: Experiencia[];
  resenas: Resena[];
  // Horario semanal de atención (de su agenda)
  horarios?: { dia: string; desde: string; hasta: string }[];
}

interface Props {
  psicologo: PsicologoPublico;
  rol: string | null;
}

const { psicologo: p, rol } = Astro.props;

const psicologo = {
  nombre: p.nombre,
  especialidad: p.titulo,
  experiencia: p.experienciaTexto,
  descripcion: p.biografia,
  especialidades: p.especialidades,
  modalidad: p.modalidadTexto,
  disponibilidad: p.disponibilidadTexto,
  calificacion: p.calificacion === null ? "Nuevo" : p.calificacion.toFixed(1),
  totalResenas: p.totalResenas,
  precio: p.voluntario && !p.precio ? "Sin costo" : p.precio > 0 ? pesos(p.precio) : "Por confirmar",
  imagen: p.tieneFoto ? urlFotoPsicologo(p.id, p.fotoVersion) : fotoIniciales(p.nombre),
};

// "Hace 2 semanas" a partir de la fecha de la reseña
const haceCuanto = (fecha: string) => {
  const dias = Math.floor((Date.now() - new Date(fecha).getTime()) / 86_400_000);
  if (dias < 1) return "Hoy";
  if (dias < 7) return `Hace ${dias} día${dias === 1 ? "" : "s"}`;
  if (dias < 30) return `Hace ${Math.floor(dias / 7)} semana${dias < 14 ? "" : "s"}`;
  if (dias < 365) return `Hace ${Math.floor(dias / 30)} mes${dias < 60 ? "" : "es"}`;
  return `Hace ${Math.floor(dias / 365)} año${dias < 730 ? "" : "s"}`;
};

const resenas = p.resenas.map((r) => ({
  nombre: r.nombre,
  inicial: r.nombre.charAt(0).toUpperCase(),
  calificacion: r.puntaje.toFixed(1),
  fecha: haceCuanto(r.fecha),
  comentario: r.comentario,
}));

// Horario semanal agrupado por día: "Lunes" -> ["8:00 a. m. – 12:00 p. m.", ...]
const NOMBRE_DIA: Record<string, string> = {
  Lunes: "Lunes", Martes: "Martes", Miercoles: "Miércoles", Jueves: "Jueves",
  Viernes: "Viernes", Sabado: "Sábado", Domingo: "Domingo",
};
const hora12 = (h: string) => {
  const [hh, mm] = h.split(":").map(Number);
  return `${((hh + 11) % 12) + 1}:${String(mm).padStart(2, "0")} ${hh >= 12 ? "p. m." : "a. m."}`;
};
const horarioSemana: { dia: string; rangos: string[] }[] = [];
for (const h of p.horarios ?? []) {
  const dia = NOMBRE_DIA[h.dia] ?? h.dia;
  let fila = horarioSemana.find((x) => x.dia === dia);
  if (!fila) {
    fila = { dia, rangos: [] };
    horarioSemana.push(fila);
  }
  fila.rangos.push(`${hora12(h.desde)} – ${hora12(h.hasta)}`);
}

// cambio: si el psicólogo está viendo su propio perfil (viene de "Ver mi perfil
// público"), el botón de arriba lo devuelve a Mi perfil y no a la lista.
const esPropio = rol === "Psicologo" && Astro.url.searchParams.get("propio") === "1";
// cambio: si el paciente llegó desde su panel (Especialistas), vuelve allá
// (también si quien lo ve es un paciente, aunque haya entrado por otro lado)
const desdePanelPaciente = Astro.url.searchParams.get("desde") === "paciente" || rol === "Paciente";
// cambio: "?volver=/Paciente/..." dice a qué vista del panel regresar
const volverParam = Astro.url.searchParams.get("volver") ?? "";
const volverPanel = /^\/Paciente\/[A-Za-z]+$/.test(volverParam) ? volverParam : "/Paciente/Especialistas";
const textoVolverPanel =
  volverPanel === "/Paciente/Citas" ? "Volver a mis citas"
  : volverPanel === "/Paciente/Especialistas" ? "Volver a especialistas"
  : "Volver a mi panel";

const periodo = (desde: number | null, hasta: number | null, actual: boolean) =>
  `${desde ?? ""}${desde ? " — " : ""}${actual ? "Actualmente" : (hasta ?? "")}`.trim();
---

<div
  class="perfil-page"
  id="perfilPsicologo"
  data-psicologo-id={p.id}
  data-rol={rol ?? ""}
>

  <!-- VOLVER -->
  <div class="perfil-topbar">
    <a href={esPropio ? "/Psicologos/MiPerfil" : desdePanelPaciente ? volverPanel : "/Explorar/Psicologos"} class="volver-link">
      <span class="volver-icon">
        <i class="bi bi-arrow-left"></i>
      </span>
      {esPropio ? "Volver a mi perfil" : desdePanelPaciente ? textoVolverPanel : "Volver a psicólogos"}
    </a>
    {esPropio && <span class="perfil-propio-aviso">Así ven tu perfil los pacientes</span>}
  </div>

  <!-- INFORMACIÓN PRINCIPAL -->
  <section class="perfil-hero">

    <div class="hero-decoracion hero-decoracion-uno"></div>
    <div class="hero-decoracion hero-decoracion-dos"></div>

    <div class="perfil-foto-contenedor">
      <img
        src={psicologo.imagen}
        alt={`Foto de ${psicologo.nombre}`}
        class="perfil-foto"
      />

      {p.disponibilidad !== "sin-horario" && (
        <span class="estado-foto">
          <span class="estado-punto"></span>
          Disponible
        </span>
      )}
    </div>

    <div class="perfil-hero-info">

      <div class="perfil-nombre-linea">
        <h1>{psicologo.nombre}</h1>

        <span class="verificado">
          <i class="bi bi-patch-check-fill"></i>
          Verificado
        </span>
      </div>

      <p class="perfil-profesion">
        {psicologo.especialidad}
      </p>

      <div class="perfil-rating">
        <span class="rating-estrellas">
          <i class="bi bi-star-fill"></i>
          <strong>{psicologo.calificacion}</strong>
        </span>

        <span class="rating-separador"></span>

        <span>{psicologo.totalResenas} reseñas</span>

        <span class="rating-separador"></span>

        <span>
          <i class="bi bi-briefcase"></i>
          {psicologo.experiencia}
        </span>
      </div>

      <div class="especialidades-hero">
        {
          psicologo.especialidades.slice(0, 4).map((especialidad) => (
            <span>{especialidad}</span>
          ))
        }
      </div>

      <div class="hero-bottom">

        <div class="precio">
          <small>Consulta desde</small>
          <strong>{psicologo.precio}</strong>
          <span>por sesión</span>
        </div>

        <button class="btn-agendar" id="abrirModal" type="button">
          <i class="bi bi-calendar2-check"></i>
          Agendar cita
          <i class="bi bi-arrow-right"></i>
        </button>

      </div>
    </div>
  </section>

  <!-- NAVEGACIÓN INTERNA -->
  <nav class="perfil-nav">
    <a href="#sobre-mi" class="activo">Sobre mí</a>
    <a href="#enfoque">Formación</a>
    <a href="#especialidades">Especialidades</a>
    <a href="#experiencia">Experiencia</a>
    <a href="#horarios">Horarios</a>
    <a href="#resenas">Reseñas</a>
  </nav>

  <!-- CONTENIDO -->
  <div class="perfil-grid">

    <!-- COLUMNA PRINCIPAL -->
    <main class="perfil-main">

      <!-- SOBRE MÍ -->
      <section class="contenido-card" id="sobre-mi">
        <div class="titulo-seccion">
          <span class="titulo-icono">
            <i class="bi bi-person-heart"></i>
          </span>

          <div>
            <h2>Sobre mí</h2>
            <p>Conoce un poco más sobre mi forma de acompañarte</p>
          </div>
        </div>

        {
          psicologo.descripcion ? (
            psicologo.descripcion
              .split(/\n+/)
              .filter((parrafo) => parrafo.trim())
              .map((parrafo) => <p class="texto-principal">{parrafo}</p>)
          ) : (
            <p class="texto-principal">
              Este profesional aún no ha escrito su presentación. Puedes
              agendar una primera cita para conocer su forma de trabajo.
            </p>
          )
        }
      </section>

      <!-- FORMACIÓN (estudios registrados por el psicólogo) -->
      <section class="contenido-card" id="enfoque">
        <div class="titulo-seccion">
          <span class="titulo-icono">
            <i class="bi bi-mortarboard"></i>
          </span>

          <div>
            <h2>Formación</h2>
            <p>Estudios y preparación profesional</p>
          </div>
        </div>

        {
          p.estudios.length === 0 ? (
            <p class="texto-principal">Formación académica revisada por Psynex durante la verificación.</p>
          ) : (
            p.estudios.map((estudio) => (
              <div class="enfoque-box">
                <div class="enfoque-icono">
                  <i class="bi bi-mortarboard"></i>
                </div>

                <div>
                  <h3>{estudio.Titulo}</h3>
                  <p>
                    {estudio.Universidad}
                    {estudio.NivelEstudio ? ` · ${estudio.NivelEstudio}` : ""}
                    {Number(estudio.EnCurso) === 1 ? " · En curso" : estudio.AnioGrado ? ` · ${estudio.AnioGrado}` : ""}
                  </p>
                </div>
              </div>
            ))
          )
        }
      </section>

      <!-- ESPECIALIDADES -->
      <section class="contenido-card" id="especialidades">
        <div class="titulo-seccion">
          <span class="titulo-icono">
            <i class="bi bi-grid"></i>
          </span>

          <div>
            <h2>Especialidades</h2>
            <p>Áreas en las que puedo acompañarte</p>
          </div>
        </div>

        {
          psicologo.especialidades.length === 0 ? (
            <p class="texto-principal">Aún no ha registrado sus especialidades.</p>
          ) : (
            <div class="especialidades-grid">
              {
                psicologo.especialidades.map((especialidad, index) => (
                  <div class="especialidad-item">
                    <span class="especialidad-numero">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <span>{especialidad}</span>

                    <i class="bi bi-arrow-up-right"></i>
                  </div>
                ))
              }
            </div>
          )
        }
      </section>

      <!-- EXPERIENCIA -->
      <section class="contenido-card" id="experiencia">
        <div class="titulo-seccion">
          <span class="titulo-icono">
            <i class="bi bi-award"></i>
          </span>

          <div>
            <h2>Experiencia</h2>
            <p>Trayectoria profesional</p>
          </div>
        </div>

        {
          p.experiencia.length === 0 ? (
            <p class="texto-principal">Aún no ha registrado su experiencia profesional.</p>
          ) : (
            p.experiencia.map((item) => (
              <div class="experiencia-item">
                <div class="experiencia-punto"></div>

                <div class="experiencia-contenido">
                  <span class="experiencia-fecha">
                    {periodo(item.AnioInicio, item.AnioFin, Number(item.TrabajaAqui) === 1)}
                  </span>
                  <h3>{item.Cargo}</h3>
                  <p>
                    <strong>{item.Empresa}</strong>
                    {item.Descripcion ? ` — ${item.Descripcion}` : ""}
                  </p>
                </div>
              </div>
            ))
          )
        }
      </section>

      <!-- RESEÑAS -->
      <section class="contenido-card resenas-card" id="resenas">

        <div class="resenas-header">

          <div class="titulo-seccion">
            <span class="titulo-icono">
              <i class="bi bi-chat-heart"></i>
            </span>

            <div>
              <h2>Reseñas</h2>
              <p>Lo que dicen algunas personas</p>
            </div>
          </div>

          <div class="resenas-rating">
            <strong>{psicologo.calificacion}</strong>

            <div>
              <div class="mini-estrellas">
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
              </div>

              <small>{psicologo.totalResenas} opiniones</small>
            </div>
          </div>

        </div>

        {
          resenas.length === 0 ? (
            <p class="texto-principal">
              Todavía no hay reseñas. Las opiniones aparecen aquí cuando los
              pacientes califican sus sesiones.
            </p>
          ) : (
            <>
              <div class="resenas-slider">

                <button
                  type="button"
                  class="resena-control anterior"
                  id="resenaAnterior"
                  aria-label="Reseña anterior"
                >
                  <i class="bi bi-chevron-left"></i>
                </button>

                <div class="resenas-viewport">
                  <div class="resenas-track" id="resenasTrack">

                    {
                      resenas.map((resena) => (
                        <article class="resena-item">

                          <div class="resena-top">

                            <div class="resena-persona">
                              <span class="avatar-resena">
                                {resena.inicial}
                              </span>

                              <div>
                                <strong>{resena.nombre}</strong>
                                <small>{resena.fecha}</small>
                              </div>
                            </div>

                            <div class="resena-calificacion">
                              <i class="bi bi-star-fill"></i>
                              {resena.calificacion}
                            </div>

                          </div>

                          <p>
                            “{resena.comentario}”
                          </p>

                        </article>
                      ))
                    }

                  </div>
                </div>

                <button
                  type="button"
                  class="resena-control siguiente"
                  id="resenaSiguiente"
                  aria-label="Siguiente reseña"
                >
                  <i class="bi bi-chevron-right"></i>
                </button>

              </div>

              <div class="resenas-indicadores" id="resenasIndicadores">
                {
                  resenas.map((_, index) => (
                    <button
                      type="button"
                      class:list={{ activo: index === 0 }}
                      data-review-index={index}
                      aria-label={`Ver reseña ${index + 1}`}
                    ></button>
                  ))
                }
              </div>
            </>
          )
        }

        <!-- CALIFICAR: solo pacientes con sesión que ya tuvieron una cita -->
        {!rol && (
          <div class="resena-nueva">
            <div>
              <strong>¿Tuviste una sesión con {psicologo.nombre.split(" ")[0]}?</strong>
              <p>Inicia sesión con tu cuenta de paciente para calificar tu experiencia.</p>
            </div>
            <button type="button" class="resena-btn" id="resenaLogin">Iniciar sesión</button>
          </div>
        )}

        {rol === "Paciente" && (
          <div class="resena-nueva" id="resenaNueva" data-estado="cargando">
            <p class="resena-estado" id="resenaEstado">Revisando si puedes calificar…</p>

            <form class="resena-form" id="resenaForm" hidden>
              <strong>Califica tu última sesión</strong>
              <div class="resena-estrellas" role="radiogroup" aria-label="Calificación de 1 a 5 estrellas">
                {[1, 2, 3, 4, 5].map((n) => (
                  <button type="button" class="estrella" data-valor={n} role="radio" aria-checked="false" aria-label={`${n} de 5 estrellas`}>
                    <i class="bi bi-star-fill"></i>
                  </button>
                ))}
                <span class="resena-valor" id="resenaValor">Elige de 1 a 5</span>
              </div>
              <textarea id="resenaComentario" maxlength="500" rows="3"
                placeholder="Cuéntale a otros cómo te sentiste en la sesión (opcional)"></textarea>
              <div class="resena-pie">
                <small id="resenaContador">0 / 500</small>
                <button type="submit" class="resena-btn" id="resenaEnviar">Publicar reseña</button>
              </div>
              <p class="resena-error" id="resenaError" hidden></p>
            </form>
          </div>
        )}

      </section>

    </main>

    <!-- COLUMNA LATERAL -->
    <aside class="perfil-sidebar">

      <!-- INFORMACIÓN -->
      <section class="sidebar-card">
        <div class="sidebar-titulo">
          <span>
            <i class="bi bi-info-circle"></i>
          </span>

          <h3>Información</h3>
        </div>

        <div class="info-item">
          <span class="info-icono">
            <i class="bi bi-camera-video"></i>
          </span>

          <div>
            <small>Modalidad</small>
            <strong>{psicologo.modalidad}</strong>
          </div>
        </div>

        <div class="info-item">
          <span class="info-icono">
            <i class="bi bi-calendar-week"></i>
          </span>

          <div>
            <small>Disponibilidad</small>
            <strong>{psicologo.disponibilidad}</strong>
          </div>
        </div>

        <div class="info-item">
          <span class="info-icono">
            <i class="bi bi-clock"></i>
          </span>

          <div>
            <small>Duración</small>
            <strong>{p.duracionMinutos} minutos</strong>
          </div>
        </div>

        {p.direccion && p.modalidades.includes("Presencial") && (
          <div class="info-item">
            <span class="info-icono">
              <i class="bi bi-geo-alt"></i>
            </span>

            <div>
              <small>Consultorio</small>
              <strong>{p.direccion}</strong>
            </div>
          </div>
        )}

      </section>

      <!-- SEGURIDAD -->
      <section class="seguridad-card">

        <div class="seguridad-icono">
          <i class="bi bi-shield-check"></i>
        </div>

        <div>
          <h3>Perfil verificado</h3>

          <p>
            Psynex revisó los documentos profesionales de este
            especialista (tarjeta profesional, diploma y vigencia).
          </p>
        </div>

      </section>

      <!-- MINI CTA -->
      <section class="sidebar-cita">

        <span class="sidebar-cita-icono">
          <i class="bi bi-calendar-heart"></i>
        </span>

        <h3>¿Quieres comenzar?</h3>

        <p>
          Elige el horario que mejor se adapte a ti.
        </p>

        <button type="button" class="sidebar-btn" id="abrirModalSidebar">
          Ver disponibilidad
          <i class="bi bi-arrow-right"></i>
        </button>

      </section>

      <!-- HORARIOS (públicos: cualquiera los puede ver) -->
      <section class="sidebar-card horarios-card" id="horarios">
        <div class="sidebar-titulo">
          <span>
            <i class="bi bi-calendar-week"></i>
          </span>

          <h3>Horarios</h3>
        </div>

        <div class="horarios-publicos">
          <div class="horarios-semana">
            <h4>Atiende</h4>
            {
              horarioSemana.length ? (
                <ul>
                  {horarioSemana.map((d) => (
                    <li>
                      <strong>{d.dia}</strong>
                      {d.rangos.map((r) => <span>{r}</span>)}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="horarios-vacio">Todavía no ha publicado su horario semanal.</p>
              )
            }
          </div>

          <div class="horarios-libres">
            <h4>Próximos espacios libres</h4>
            <div id="horariosLibres" class="horarios-dias">
              <p class="horarios-vacio">Cargando horarios…</p>
            </div>
            <small class="horarios-nota">
              {rol === "Paciente"
                ? "Toca una hora para agendar tu cita."
                : "Para agendar, inicia sesión con tu cuenta de paciente."}
            </small>
          </div>
        </div>
      </section>

    </aside>

  </div>
</div>


<!-- ========================================= -->
<!-- MODAL AGENDAR CITA -->
<!-- ========================================= -->

<div class="modal-cita" id="modalCita" aria-hidden="true">

  <div class="modal-overlay" id="cerrarModalOverlay"></div>

  <div
    class="modal-contenido"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tituloModalCita"
  >

    <button
      type="button"
      class="modal-cerrar"
      id="cerrarModal"
      aria-label="Cerrar"
    >
      <i class="bi bi-x-lg"></i>
    </button>

    <div class="modal-header">

      <span class="modal-header-icono">
        <i class="bi bi-calendar2-check"></i>
      </span>

      <div>
        <span>Agenda tu sesión</span>
        <h2 id="tituloModalCita">Elige cuándo quieres venir</h2>
      </div>

    </div>

    <!-- PASO 1 -->
    <div class="modal-paso">

      <div class="paso-titulo">
        <span>1</span>

        <div>
          <strong>Modalidad</strong>
          <small>¿Cómo prefieres tu sesión?</small>
        </div>
      </div>

      <div class="modal-opciones modalidad-opciones">

        <button
          type="button"
          class="modal-opcion modalidad-btn seleccionado"
          data-modalidad="Virtual"
        >
          <span>
            <i class="bi bi-camera-video"></i>
          </span>

          <div>
            <strong>Virtual</strong>
            <small>Desde donde estés</small>
          </div>

          <i class="bi bi-check-circle-fill opcion-check"></i>
        </button>

        <button
          type="button"
          class="modal-opcion modalidad-btn"
          data-modalidad="Presencial"
        >
          <span>
            <i class="bi bi-geo-alt"></i>
          </span>

          <div>
            <strong>Presencial</strong>
            <small>En consultorio</small>
          </div>

          <i class="bi bi-check-circle-fill opcion-check"></i>
        </button>

      </div>

    </div>

    <!-- PASO 2 -->
    <div class="modal-paso">

      <div class="paso-titulo">
        <span>2</span>

        <div>
          <strong>Fecha</strong>
          <small>Selecciona un día disponible</small>
        </div>
      </div>

      <!-- Los días los llena el script con la agenda real del psicólogo -->
      <div class="fechas-scroll" id="listaFechas"></div>

    </div>

    <!-- PASO 3 -->
    <div class="modal-paso">

      <div class="paso-titulo">
        <span>3</span>

        <div>
          <strong>Hora</strong>
          <small>Selecciona un horario</small>
        </div>
      </div>

      <div class="horarios-grid" id="listaHoras"></div>

    </div>

    <!-- PASO 4: quién viene (individual, pareja o familia) -->
    <div class="modal-paso">

      <div class="paso-titulo">
        <span>4</span>

        <div>
          <strong>¿Quién viene a la sesión?</strong>
          <small>Puedes venir solo, en pareja o con tu familia</small>
        </div>
      </div>

      <div class="modal-opciones formato-opciones">
        <button type="button" class="modal-opcion formato-btn seleccionado" data-formato="Individual">
          <span><i class="bi bi-person"></i></span>
          <div><strong>Solo yo</strong><small>Individual</small></div>
          <i class="bi bi-check-circle-fill opcion-check"></i>
        </button>
        <button type="button" class="modal-opcion formato-btn" data-formato="Pareja">
          <span><i class="bi bi-people"></i></span>
          <div><strong>En pareja</strong><small>2 personas</small></div>
          <i class="bi bi-check-circle-fill opcion-check"></i>
        </button>
        <button type="button" class="modal-opcion formato-btn" data-formato="Familiar">
          <span><i class="bi bi-house-heart"></i></span>
          <div><strong>En familia</strong><small>Hasta 5 personas</small></div>
          <i class="bi bi-check-circle-fill opcion-check"></i>
        </button>
      </div>

      <div class="acompanantes" id="acompanantes" hidden>
        <label class="acompanantes-titulo" id="acompanantesTitulo">Correo de tu pareja</label>
        <div class="acompanantes-lista" id="acompanantesLista"></div>
        <button type="button" class="acompanantes-agregar" id="agregarAcompanante" hidden>
          <i class="bi bi-plus-lg"></i> Agregar otro familiar
        </button>
        <small class="acompanantes-nota">
          <i class="bi bi-info-circle"></i>
          Cada persona necesita su cuenta de paciente en Psynex. Le avisaremos y podrá entrar a la sala con su cuenta.
        </small>
      </div>

    </div>

    <!-- RESUMEN -->
    <div class="cita-resumen">

      <div class="resumen-icono">
        <i class="bi bi-calendar-heart"></i>
      </div>

      <div class="resumen-info">

        <small>Tu selección</small>

        <strong>
          <span id="resumenModalidad">Virtual</span>
          <span class="resumen-punto">•</span>
          <span id="resumenFormato">Individual</span>
          <span class="resumen-punto">•</span>
          <span id="resumenFecha">—</span>
          <span class="resumen-punto">•</span>
          <span id="resumenHora">—</span>
        </strong>

      </div>

    </div>

    <button type="button" class="btn-continuar" id="continuarCita">
      Continuar
      <i class="bi bi-arrow-right"></i>
    </button>

  </div>
</div>



<ModalSesion />


<script>
  import { API_URL, apiEnviar, textoError } from "../../lib/api";

  interface DiaDisponible {
    fecha: string;
    dia: string;
    horas: string[];
  }

  const pagina = document.getElementById("perfilPsicologo");
  const psicologoId = pagina?.dataset.psicologoId ?? "";
  const rol = pagina?.dataset.rol ?? "";

  /* =========================================
     MODAL AGENDAR
     Cualquier visitante puede abrirlo y VER la agenda real.
     Al intentar elegir modalidad, fecha u hora sin sesión
     de paciente, aparece el aviso para iniciar sesión.
  ========================================= */

  const modal = document.getElementById("modalCita");

  const aviso = (titulo: string, mensaje: string, tipo: "sesion" | "aviso" = "aviso", icono = "bi-calendar2-check") =>
    document.dispatchEvent(
      new CustomEvent("psynex:modal", { detail: { tipo, titulo, mensaje, icono } }),
    );

  // true si puede elegir; si no, muestra el aviso que corresponde
  const puedeElegir = () => {
    if (!rol) {
      aviso(
        "Inicia sesión para agendar",
        "Necesitas una cuenta de paciente para elegir tu cita. Es gratis.",
        "sesion",
      );
      return false;
    }
    if (rol !== "Paciente") {
      aviso(
        "Solo para pacientes",
        "Ingresa con una cuenta de paciente para agendar una cita.",
      );
      return false;
    }
    return true;
  };

  const cerrar = () => {
    if (!modal) return;
    modal.classList.remove("visible");
    modal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("modal-abierto");
  };

  const abrir = () => {
    if (!modal) return;
    // Sin sesión de paciente: solo la ventana de iniciar sesión, no la de agendar
    if (!puedeElegir()) return;
    modal.classList.add("visible");
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-abierto");
    void cargarDisponibilidad();
  };

  document.getElementById("abrirModal")?.addEventListener("click", abrir);
  document.getElementById("abrirModalSidebar")?.addEventListener("click", abrir);
  document.getElementById("cerrarModal")?.addEventListener("click", cerrar);
  document.getElementById("cerrarModalOverlay")?.addEventListener("click", cerrar);

  document.addEventListener("keydown", (event: KeyboardEvent) => {
    if (event.key === "Escape" && modal?.classList.contains("visible")) cerrar();
  });

  /* =========================================
     AGENDA (fechas y horas reales)
  ========================================= */

  const seleccion = { modalidad: "Virtual", fecha: "", hora: "", formato: "Individual" };

  const resumenModalidad = document.getElementById("resumenModalidad");
  const resumenFecha = document.getElementById("resumenFecha");
  const resumenHora = document.getElementById("resumenHora");
  const continuar = document.getElementById("continuarCita") as HTMLButtonElement | null;
  const listaFechas = document.getElementById("listaFechas");
  const listaHoras = document.getElementById("listaHoras");

  let dias: DiaDisponible[] = [];
  // Día cuyas horas se están mostrando (aunque todavía no esté elegido)
  let diaVisible = "";

  const MESES = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
  const DIAS_CORTOS: Record<string, string> = {
    Lunes: "LUN", Martes: "MAR", Miercoles: "MIÉ", Jueves: "JUE",
    Viernes: "VIE", Sabado: "SÁB", Domingo: "DOM",
  };

  // "2026-10-15" -> "Jue 15"
  const textoFecha = (d: DiaDisponible) => {
    const corto = DIAS_CORTOS[d.dia] ?? d.dia.slice(0, 3);
    return `${corto.charAt(0)}${corto.slice(1).toLowerCase()} ${Number(d.fecha.slice(8, 10))}`;
  };

  // "14:30" -> "2:30 PM"
  const textoHora = (h: string) => {
    const [hh, mm] = h.split(":").map(Number);
    return `${((hh + 11) % 12) + 1}:${String(mm).padStart(2, "0")} ${hh >= 12 ? "PM" : "AM"}`;
  };

  const actualizarResumen = () => {
    const dia = dias.find((d) => d.fecha === seleccion.fecha);
    if (resumenModalidad) resumenModalidad.textContent = seleccion.modalidad;
    const resumenFormato = document.getElementById("resumenFormato");
    if (resumenFormato) {
      resumenFormato.textContent = { Individual: "Individual", Pareja: "En pareja", Familiar: "En familia" }[seleccion.formato] ?? "Individual";
    }
    if (resumenFecha) resumenFecha.textContent = dia ? textoFecha(dia) : "—";
    if (resumenHora) resumenHora.textContent = seleccion.hora ? textoHora(seleccion.hora) : "—";
  };

  // Modalidad
  const modalidadButtons = document.querySelectorAll<HTMLElement>(".modalidad-btn");
  modalidadButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (!puedeElegir()) return;
      modalidadButtons.forEach((item) => item.classList.remove("seleccionado"));
      button.classList.add("seleccionado");
      seleccion.modalidad = button.dataset.modalidad ?? "Virtual";
      actualizarResumen();
    });
  });

  const pintarHoras = () => {
    if (!listaHoras) return;
    listaHoras.innerHTML = "";
    const dia = dias.find((d) => d.fecha === diaVisible);
    (dia?.horas ?? []).forEach((hora) => {
      const boton = document.createElement("button");
      boton.type = "button";
      boton.className = "hora-btn" + (hora === seleccion.hora && dia?.fecha === seleccion.fecha ? " seleccionado" : "");
      boton.textContent = textoHora(hora);
      boton.addEventListener("click", () => {
        if (!puedeElegir()) return;
        seleccion.fecha = diaVisible;
        seleccion.hora = hora;
        pintarFechas();
        pintarHoras();
        actualizarResumen();
      });
      listaHoras.appendChild(boton);
    });
  };

  const pintarFechas = () => {
    if (!listaFechas) return;
    listaFechas.innerHTML = "";

    if (!dias.length) {
      listaFechas.innerHTML = "<small>No hay horarios libres en las próximas dos semanas.</small>";
      return;
    }

    dias.slice(0, 10).forEach((d) => {
      const boton = document.createElement("button");
      boton.type = "button";
      boton.className = "fecha-btn" + (d.fecha === seleccion.fecha ? " seleccionado" : "");
      boton.innerHTML =
        `<small>${DIAS_CORTOS[d.dia] ?? ""}</small>` +
        `<strong>${Number(d.fecha.slice(8, 10))}</strong>` +
        `<span>${MESES[Number(d.fecha.slice(5, 7)) - 1]}</span>`;
      boton.addEventListener("click", () => {
        if (!puedeElegir()) return;
        seleccion.fecha = d.fecha;
        seleccion.hora = "";
        diaVisible = d.fecha;
        pintarFechas();
        pintarHoras();
        actualizarResumen();
      });
      listaFechas.appendChild(boton);
    });
  };

  // Horarios libres de las próximas dos semanas
  async function cargarDisponibilidad() {
    if (listaFechas) listaFechas.innerHTML = "<small>Cargando horarios…</small>";
    if (listaHoras) listaHoras.innerHTML = "";
    try {
      const res = await fetch(`${API_URL}/api/explorar/psicologos/${psicologoId}/disponibilidad?dias=14`);
      const data = await res.json();
      dias = res.ok ? (data.dias ?? []) : [];
    } catch {
      dias = [];
    }
    if (!dias.some((d) => d.fecha === seleccion.fecha)) {
      seleccion.fecha = "";
      seleccion.hora = "";
    }
    diaVisible = seleccion.fecha || dias[0]?.fecha || "";
    pintarFechas();
    pintarHoras();
    actualizarResumen();
  }

  /* =========================================
     PASO 4: solo, en pareja o en familia
     Pareja: 1 correo · Familia: de 1 a 4 correos
  ========================================= */

  const MAX_FAMILIARES = 4;
  const cajaAcompanantes = document.getElementById("acompanantes");
  const listaAcompanantes = document.getElementById("acompanantesLista");
  const tituloAcompanantes = document.getElementById("acompanantesTitulo");
  const botonAgregar = document.getElementById("agregarAcompanante") as HTMLButtonElement | null;

  function correosAcompanantes(): string[] {
    return [...(listaAcompanantes?.querySelectorAll<HTMLInputElement>("input") ?? [])]
      .map((i) => i.value.trim().toLowerCase())
      .filter(Boolean);
  }

  function agregarCampoCorreo(valor = "") {
    if (!listaAcompanantes) return;
    const fila = document.createElement("div");
    fila.className = "acompanante-fila";
    const input = document.createElement("input");
    input.type = "email";
    input.maxLength = 256;
    input.autocomplete = "off";
    input.placeholder = seleccion.formato === "Pareja" ? "correo@ejemplo.com" : `Correo del familiar ${listaAcompanantes.children.length + 1}`;
    input.value = valor;
    fila.append(input);
    if (seleccion.formato === "Familiar" && listaAcompanantes.children.length > 0) {
      const quitar = document.createElement("button");
      quitar.type = "button";
      quitar.className = "acompanante-quitar";
      quitar.setAttribute("aria-label", "Quitar este familiar");
      quitar.innerHTML = '<i class="bi bi-x-lg"></i>';
      quitar.addEventListener("click", () => {
        fila.remove();
        pintarBotonAgregar();
      });
      fila.append(quitar);
    }
    listaAcompanantes.append(fila);
    pintarBotonAgregar();
  }

  function pintarBotonAgregar() {
    if (!botonAgregar || !listaAcompanantes) return;
    botonAgregar.hidden = seleccion.formato !== "Familiar" || listaAcompanantes.children.length >= MAX_FAMILIARES;
  }

  function elegirFormato(formato: string) {
    seleccion.formato = formato;
    document.querySelectorAll<HTMLElement>(".formato-btn").forEach((b) =>
      b.classList.toggle("seleccionado", b.dataset.formato === formato)
    );
    const anteriores = correosAcompanantes();
    if (listaAcompanantes) listaAcompanantes.replaceChildren();
    if (cajaAcompanantes) cajaAcompanantes.hidden = formato === "Individual";
    if (tituloAcompanantes) {
      tituloAcompanantes.textContent = formato === "Pareja" ? "Correo de tu pareja" : "Correos de tus familiares (hasta 4)";
    }
    if (formato === "Pareja") agregarCampoCorreo(anteriores[0] ?? "");
    if (formato === "Familiar") {
      (anteriores.length ? anteriores : [""]).slice(0, MAX_FAMILIARES).forEach((c) => agregarCampoCorreo(c));
    }
    actualizarResumen();
  }

  document.querySelectorAll<HTMLElement>(".formato-btn").forEach((b) =>
    b.addEventListener("click", () => {
      if (!puedeElegir()) return;
      elegirFormato(b.dataset.formato ?? "Individual");
    })
  );
  botonAgregar?.addEventListener("click", () => {
    agregarCampoCorreo();
    listaAcompanantes?.querySelector<HTMLInputElement>(".acompanante-fila:last-child input")?.focus();
  });

  /* =========================================
     CONTINUAR -> solicitar la cita
  ========================================= */

  continuar?.addEventListener("click", async () => {
    if (!puedeElegir()) return;

    if (!seleccion.fecha || !seleccion.hora) {
      aviso("Elige fecha y hora", "Selecciona un día y un horario disponibles para continuar.");
      return;
    }

    // Correos de los acompañantes (pareja o familia)
    const acompanantes = correosAcompanantes();
    if (seleccion.formato !== "Individual") {
      const malo = acompanantes.find((c) => !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(c));
      if (!acompanantes.length || malo) {
        aviso(
          "Revisa los correos",
          malo
            ? `"${malo}" no parece un correo válido.`
            : seleccion.formato === "Pareja"
            ? "Escribe el correo de tu pareja."
            : "Escribe el correo de al menos un familiar.",
        );
        return;
      }
      if (new Set(acompanantes).size !== acompanantes.length) {
        aviso("Revisa los correos", "Escribiste el mismo correo dos veces.");
        return;
      }
    }

    continuar.disabled = true;

    const r = await apiEnviar("POST", `/api/explorar/psicologos/${psicologoId}/citas`, {
      fecha: seleccion.fecha,
      hora: seleccion.hora,
      modalidad: seleccion.modalidad,
      formato: seleccion.formato,
      acompanantes: seleccion.formato === "Individual" ? [] : acompanantes,
    });

    continuar.disabled = false;

    if (r.ok) {
      const dia = dias.find((d) => d.fecha === seleccion.fecha);
      cerrar();
      aviso(
        "¡Solicitud enviada!",
        `Pediste tu cita ${seleccion.modalidad.toLowerCase()}${seleccion.formato === "Individual" ? "" : seleccion.formato === "Pareja" ? " en pareja" : " en familia"} el ${dia ? textoFecha(dia) : seleccion.fecha} a las ${textoHora(seleccion.hora)}. Te avisaremos cuando el psicólogo la confirme.`,
        "aviso",
        "bi-check2-circle",
      );
      seleccion.hora = "";
      return;
    }

    if (r.status === 401) {
      cerrar();
      aviso("Tu sesión terminó", "Vuelve a iniciar sesión para agendar tu cita.", "sesion");
      return;
    }

    aviso("No se pudo agendar", textoError(r.data, "Inténtalo de nuevo en un momento."));
    if (r.status === 409) await cargarDisponibilidad();
  });

  /* =========================================
     HORARIOS PÚBLICOS (contenedor "Horarios")
     Cualquiera los ve; al tocar una hora, el paciente
     abre el modal con ese día y esa hora ya elegidos.
  ========================================= */

  const cajaLibres = document.getElementById("horariosLibres");

  async function cargarHorariosPublicos() {
    if (!cajaLibres) return;
    let libres: DiaDisponible[] = [];
    try {
      const res = await fetch(`${API_URL}/api/explorar/psicologos/${psicologoId}/disponibilidad?dias=14`);
      const data = await res.json();
      libres = res.ok ? (data.dias ?? []) : [];
    } catch {
      libres = [];
    }

    cajaLibres.replaceChildren();
    if (!libres.length) {
      const p = document.createElement("p");
      p.className = "horarios-vacio";
      p.textContent = "No hay espacios libres en las próximas dos semanas.";
      cajaLibres.append(p);
      return;
    }

    libres.slice(0, 4).forEach((d) => {
      const fila = document.createElement("div");
      fila.className = "horarios-dia";

      const fecha = document.createElement("span");
      fecha.className = "horarios-fecha";
      fecha.textContent = `${textoFecha(d)} ${MESES[Number(d.fecha.slice(5, 7)) - 1]}`;

      const horas = document.createElement("div");
      horas.className = "horarios-horas";
      d.horas.slice(0, 4).forEach((h) => {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "hora-chip";
        chip.textContent = textoHora(h);
        chip.addEventListener("click", () => {
          if (!puedeElegir()) return;
          seleccion.fecha = d.fecha;
          seleccion.hora = h;
          abrir();
        });
        horas.append(chip);
      });
      if (d.horas.length > 4) {
        const mas = document.createElement("small");
        mas.className = "horarios-mas";
        mas.textContent = `+${d.horas.length - 4} más`;
        horas.append(mas);
      }

      fila.append(fecha, horas);
      cajaLibres.append(fila);
    });
  }

  void cargarHorariosPublicos();


  /* =========================================
     RESEÑAS: calificar (solo pacientes con una sesión realizada)
  ========================================= */

  document.getElementById("resenaLogin")?.addEventListener("click", () =>
    aviso("Inicia sesión para calificar", "Ingresa con tu cuenta de paciente para dejar tu reseña.", "sesion", "bi-star"),
  );

  const resenaCaja = document.getElementById("resenaNueva");
  const resenaForm = document.getElementById("resenaForm") as HTMLFormElement | null;
  const resenaEstado = document.getElementById("resenaEstado");
  const resenaError = document.getElementById("resenaError");
  const comentario = document.getElementById("resenaComentario") as HTMLTextAreaElement | null;
  const estrellas = [...document.querySelectorAll<HTMLButtonElement>(".resena-estrellas .estrella")];
  const TEXTO_ESTRELLAS = ["", "Muy mala", "Mala", "Regular", "Buena", "Excelente"];
  let puntaje = 0;

  const pintarEstrellas = (valor: number) => {
    estrellas.forEach((e) => {
      const n = Number(e.dataset.valor);
      e.classList.toggle("activa", n <= valor);
      e.setAttribute("aria-checked", String(n === puntaje));
    });
    const texto = document.getElementById("resenaValor");
    if (texto) texto.textContent = valor ? `${valor} de 5 · ${TEXTO_ESTRELLAS[valor]}` : "Elige de 1 a 5";
  };

  estrellas.forEach((e) => {
    const n = Number(e.dataset.valor);
    e.addEventListener("mouseenter", () => pintarEstrellas(n));
    e.addEventListener("mouseleave", () => pintarEstrellas(puntaje));
    e.addEventListener("click", () => {
      puntaje = n;
      pintarEstrellas(puntaje);
    });
  });

  comentario?.addEventListener("input", () => {
    const c = document.getElementById("resenaContador");
    if (c) c.textContent = `${comentario.value.length} / 500`;
  });

  const ponerEstadoResena = (estado: string) => {
    if (!resenaCaja || !resenaEstado || !resenaForm) return;
    resenaCaja.dataset.estado = estado;
    resenaForm.hidden = estado !== "puede";
    resenaEstado.hidden = estado === "puede";
    if (estado === "ya") resenaEstado.textContent = "Ya calificaste tus sesiones con este psicólogo. ¡Gracias por tu opinión!";
    if (estado === "sin-cita") resenaEstado.textContent = "Podrás calificar después de tener tu primera sesión con este psicólogo.";
    if (estado === "gracias") resenaEstado.textContent = "¡Gracias! Tu reseña quedó publicada.";
    if (estado === "error") resenaEstado.textContent = "No pudimos revisar tus sesiones. Intenta más tarde.";
  };

  async function cargarEstadoResena() {
    if (!resenaCaja) return;
    try {
      const res = await fetch(`${API_URL}/api/explorar/psicologos/${psicologoId}/mi-resena`, { credentials: "include" });
      const data = await res.json().catch(() => ({}));
      ponerEstadoResena(res.ok ? String(data.estado) : "error");
    } catch {
      ponerEstadoResena("error");
    }
  }

  resenaForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (resenaError) resenaError.hidden = true;
    if (!puntaje) {
      if (resenaError) {
        resenaError.textContent = "Elige de 1 a 5 estrellas.";
        resenaError.hidden = false;
      }
      return;
    }
    const enviar = document.getElementById("resenaEnviar") as HTMLButtonElement | null;
    if (enviar) enviar.disabled = true;
    const r = await apiEnviar("POST", `/api/explorar/psicologos/${psicologoId}/resenas`, {
      puntaje,
      comentario: comentario?.value.trim() ?? "",
    });
    if (enviar) enviar.disabled = false;
    if (r.ok) {
      ponerEstadoResena("gracias");
      setTimeout(() => location.reload(), 1500); // para ver la reseña en la lista
      return;
    }
    if (resenaError) {
      resenaError.textContent = textoError(r.data, "No se pudo publicar la reseña.");
      resenaError.hidden = false;
    }
  });

  void cargarEstadoResena();


  /* =========================================
     CARRUSEL DE RESEÑAS
  ========================================= */

  const track = document.getElementById("resenasTrack");
  const anterior = document.getElementById("resenaAnterior");
  const siguiente = document.getElementById("resenaSiguiente");
  const indicadores = document.querySelectorAll<HTMLElement>("[data-review-index]");

  let indiceActual = 0;

  const actualizarCarrusel = () => {
    if (!track) return;
    track.style.transform = `translateX(-${indiceActual * 100}%)`;
    indicadores.forEach((indicador, index) => {
      indicador.classList.toggle("activo", index === indiceActual);
    });
  };

  siguiente?.addEventListener("click", () => {
    indiceActual = (indiceActual + 1) % Math.max(indicadores.length, 1);
    actualizarCarrusel();
  });

  anterior?.addEventListener("click", () => {
    indiceActual = (indiceActual - 1 + indicadores.length) % Math.max(indicadores.length, 1);
    actualizarCarrusel();
  });

  indicadores.forEach((indicador) => {
    indicador.addEventListener("click", () => {
      const valor = indicador.dataset.reviewIndex;
      if (valor !== undefined) {
        indiceActual = Number(valor);
        actualizarCarrusel();
      }
    });
  });

  /* =========================================
     CAMBIO DE SECCIÓN
  ========================================= */

  const enlaces = document.querySelectorAll<HTMLAnchorElement>(".perfil-nav a");
  enlaces.forEach((enlace) => {
    enlace.addEventListener("click", () => {
      enlaces.forEach((item) => item.classList.remove("activo"));
      enlace.classList.add("activo");
    });
  });
</script>
